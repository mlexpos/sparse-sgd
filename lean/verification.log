    Real.log (1 + ↑B * ↑(ps (Fin.last n)) / (↑d + 2 - ↑(ps (Fin.last n))))
SparseSGD.Scaling.Helps.vocab_full_remark {n d : ℕ} {ν : MeasureTheory.Measure ℝ} {ps : Fin (n + 1) → ↑unitInterval}
  (jury : SparseSGD.External.JuryStability) (hp : ∀ (j : Fin (n + 1)), 0 < ↑(ps j)) (hanti : Antitone ps)
  (hκ : 1 < SparseSGD.Scaling.Helps.kappaV ps) {β : ℝ} (hb0 : 0 ≤ β) (hb1 : β < 1)
  (hκβ : SparseSGD.Scaling.Helps.kappaBeta β ≤ SparseSGD.Scaling.Helps.kappaV ps) :
