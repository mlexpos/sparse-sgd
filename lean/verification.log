                (↑x).2.2.2.2 ∂(SparseSGD.Logistic.reducedKernel eta beta p mu hr)
                  (SparseSGD.Logistic.reduceState mu s) } =
        (SparseSGD.Logistic.driftParams eta beta p mu s.1).step
          { R := ‖SparseSGD.Logistic.bulkPart mu s.1‖ ^ 2, V := eta ^ 2 * ‖SparseSGD.Logistic.bulkPart mu s.2‖ ^ 2,
            C := eta * inner ℝ (SparseSGD.Logistic.bulkPart mu s.1) (SparseSGD.Logistic.bulkPart mu s.2) }
