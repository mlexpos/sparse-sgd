SparseSGD.trajectory_risk_uniform_bound (jury : SparseSGD.External.JuryStability) (p : SparseSGD.Params)
  (s : SparseSGD.Moments) (A : ℝ) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1) (hw0 : 0 < p.w)
  (hw1 : p.w < 2 * (1 + p.beta)) (hnoise : 0 ≤ p.noise) (hadd : 0 ≤ p.additive) (hload : p.renormNoise < 1) (hA : 0 ≤ A)
  (hfree : ∀ (k : ℕ), SparseSGD.freeRisk p s k ≤ A) (k : ℕ) :
