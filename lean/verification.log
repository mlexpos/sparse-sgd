  (he0 : MeasureTheory.MemLp (e 0) 2 μ) (hq0 : MeasureTheory.MemLp (q 0) 2 μ)
  (heStep : ∀ (k : ℕ), e (k + 1) = (1 - eta * (1 - beta) * A) • e k - beta • q k - (eta * (1 - beta)) • ξ k)
  (hqStep : ∀ (k : ℕ), q (k + 1) = (eta * (1 - beta) * A) • e k + beta • q k + (eta * (1 - beta)) • ξ k) (k : ℕ) :
