  (hsum : ∑ j, ↑(ps j) = 1) (ν : MeasureTheory.Measure ℝ)
  (ρ : MeasureTheory.Measure (SparseSGD.Scaling.Helps.VocabRows.VState d V)) [MeasureTheory.IsProbabilityMeasure ν]
  [MeasureTheory.IsProbabilityMeasure ρ] (hz : MeasureTheory.MemLp id 2 ν) (hmean : ∫ (z : ℝ), z ∂ν = 0) (beta eta : ℝ)
  (he0 : ∀ (j : Fin V), MeasureTheory.MemLp (fun s => s.1 j) 2 ρ)
