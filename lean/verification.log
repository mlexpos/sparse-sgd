                SparseSGD.Scaling.Helps.lsNu d B p beta ∈ Set.Icc (nu0 / 2) (2 * nu0) →
                  |SparseSGD.Scaling.Helps.lsNfold d B p ν beta /
                          SparseSGD.Scaling.Helps.hyperbolaN (SparseSGD.Scaling.Helps.lsNstab d B p beta)
                            (SparseSGD.Scaling.Helps.lsNmem B p beta) -
                        1| ≤
                    δ
SparseSGD.Scaling.Helps.schedule_params (d B : ℕ) (p : ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (hp : ↑p ≠ 0)
  (hB : 0 < B) (k : ℕ) (hk : 1 ≤ k) :
  (SparseSGD.Probability.LeastSquares.params d B p ν 0 (1 / (↑p * ↑k))).w = 1 / ↑k ∧
    (SparseSGD.Probability.LeastSquares.params d B p ν 0 (1 / (↑p * ↑k))).noise = (↑d + 2 - ↑p) / (2 * ↑B * ↑p * ↑k) ∧
      (SparseSGD.Probability.LeastSquares.params d B p ν 0 (1 / (↑p * ↑k))).additive =
        SparseSGD.Probability.LeastSquares.labelVariance ν * ↑d / (2 * ↑B * ↑p * ↑k)
SparseSGD.Scaling.Helps.schedule_risk_asymptotic (d B : ℕ) (p : ↑unitInterval) (ν : MeasureTheory.Measure ℝ)
  (hp : ↑p ≠ 0) (hB : 0 < B) {k0 : ℕ} (hk0 : 1 ≤ k0) (s : ℕ → SparseSGD.Moments)
  (hs :
    ∀ (k : ℕ), k0 ≤ k → s (k + 1) = (SparseSGD.Probability.LeastSquares.params d B p ν 0 (1 / (↑p * ↑k))).step (s k)) :
  Filter.Tendsto (fun k => ↑k * (s k).R) Filter.atTop
    (nhds (SparseSGD.Probability.LeastSquares.labelVariance ν * ↑d / (↑B * ↑p)))
SparseSGD.Scaling.Helps.schedule_step_R (d B : ℕ) (p : ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (hp : ↑p ≠ 0)
  (hB : 0 < B) (k : ℕ) (hk : 1 ≤ k) (s : SparseSGD.Moments) :
  ((SparseSGD.Probability.LeastSquares.params d B p ν 0 (1 / (↑p * ↑k))).step s).R =
    (1 - 2 / ↑k + ((↑d + 2 - ↑p) / (↑B * ↑p) + 1) / ↑k ^ 2) * s.R +
      SparseSGD.Probability.LeastSquares.labelVariance ν * ↑d / (↑B * ↑p * ↑k ^ 2)
