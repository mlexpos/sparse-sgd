  (x : ℕ → SparseSGD.Logistic.DynamicState) (y : ℝ → ℝ × ℝ) (_hM : 2 ≤ M) (hT0 : 0 ≤ T) (hh : 0 < h) (hh1 : h ≤ 1)
  (hz : 0 ≤ z) (he : 0 ≤ e) (hJ0 : 0 ≤ J0) (hK : 0 ≤ K) (hCtr : 0 ≤ Ctr) (hCres : 0 ≤ Cres) (hF : 0 ≤ F)
  (hLip : LipschitzOnWith Lf (SparseSGD.Logistic.slowVectorField r Phi) (Metric.closedBall 0 M))
  (hbound : ∀ (s : ℝ × ℝ), ‖s‖ ≤ M → ‖SparseSGD.Logistic.slowVectorField r Phi s‖ ≤ F)
  (hy : ∀ t ∈ Set.Icc 0 T, HasDerivAt y (SparseSGD.Logistic.slowVectorField r Phi (y t)) t)
  (hyM : ∀ t ∈ Set.Icc 0 T, ‖y t‖ ≤ M - 2) (hinit : SparseSGD.Logistic.slowPosition (x 0) = y 0)
  (hfast0 : SparseSGD.Logistic.slowTrackingError r h Phi (x 0) ≤ J0) (horizon : ↑N * z ≤ T)
  (hlocal :
    ∀ n < N,
      ‖SparseSGD.Logistic.slowPosition (x n)‖ ≤ M →
        ‖SparseSGD.Logistic.slowPosition (x (n + 1)) - SparseSGD.Logistic.slowPosition (x n)‖ ≤
            z * K * (1 + SparseSGD.Logistic.slowTrackingError r h Phi (x n)) ∧
          ‖SparseSGD.Logistic.slowPosition (x (n + 1)) -
                  (SparseSGD.Logistic.slowPosition (x n) +
                    z • SparseSGD.Logistic.slowVectorField r Phi (SparseSGD.Logistic.slowPosition (x n)))‖ ≤
              z * Cres * (SparseSGD.Logistic.slowTrackingError r h Phi (x n) + z + e) ∧
            (‖SparseSGD.Logistic.slowPosition (x (n + 1))‖ ≤ M →
              SparseSGD.Logistic.slowTrackingError r h Phi (x (n + 1)) ≤
                (1 - h / 4) * SparseSGD.Logistic.slowTrackingError r h Phi (x n) + Ctr * (z + h * e)))
  (hmove : z * K * (1 + J0 + 4 * Ctr * (z / h + e)) ≤ 1)
  (hsmall :
    (4 * z * (Cres * J0) / h + T * (Cres * (4 * Ctr * (z / h + e) + z + e) + ↑Lf * F * z)) * Real.exp (T * ↑Lf) ≤ 1)
  (n : ℕ) :
  n ≤ N →
    ‖SparseSGD.Logistic.slowPosition (x n) - y (↑n * z)‖ ≤
        (4 * z * (Cres * J0) / h + T * (Cres * (4 * Ctr * (z / h + e) + z + e) + ↑Lf * F * z)) * Real.exp (T * ↑Lf) ∧
      SparseSGD.Logistic.slowTrackingError r h Phi (x n) ≤ (1 - h / 4) ^ n * J0 + 4 * Ctr * (z / h + e)
