  Filter.Tendsto (fun n => (p n).matchedDelta * (p n).matchedStep ^ 2) Filter.atTop (nhds (Real.arccos |1 - w / 2| ^ 2))
SparseSGD.curvature_switch_rate (w u : ℝ) (hw0 : 0 < w) (hw4 : w < 4) (hu0 : 0 < u) (hu1 : u + w / 4 < 1) :
  1 - (u + w / 4) < 1 - u / (1 - w / 4) ∧ 1 - u / (1 - w / 4) < 1
SparseSGD.curvature_window_comparison (p : ℕ → SparseSGD.Params) (s : ℕ → SparseSGD.Moments) (w u margin : ℝ)
  (jury : SparseSGD.External.JuryStability) (hb : Filter.Tendsto (fun n => (p n).beta) Filter.atTop (nhds 1))
  (hw : Filter.Tendsto (fun n => (p n).w) Filter.atTop (nhds w))
  (hu : Filter.Tendsto (fun n => (p n).noise) Filter.atTop (nhds u)) (hw0 : 0 < w) (hw4 : w < 4) (hm : 0 < margin)
  (hb1 : ∀ᶠ (n : ℕ) in Filter.atTop, (p n).beta < 1) (hu0 : ∀ᶠ (n : ℕ) in Filter.atTop, 0 ≤ (p n).noise)
  (hp : ∀ᶠ (n : ℕ) in Filter.atTop, 0 ≤ (p n).renormAdditive) (hs : ∀ (n : ℕ), (s n).psd)
  (hum : u / (1 - w / 4) ≤ 1 - margin) (hnyq : 2 * Real.sin margin ≤ |w - 2|) :
  ∃ C,
    0 ≤ C ∧
      ∀ᶠ (n : ℕ) in Filter.atTop,
        ∀ (k : ℕ),
          |SparseSGD.slowEnergy (p n).matchedDelta ((p n).matchedMoments ((p n).trajectory (s n) k)) -
                  (p n).windowSlow (s n) (↑k * (p n).matchedStep)| ≤
              C * (p n).matchedStep * ((p n).comparisonInitialSize (s n) + (p n).renormAdditive) ∧
            ‖SparseSGD.oscillatoryEnergy (p n).matchedDelta (SparseSGD.oscillatoryRoot √((p n).matchedDelta - 1 / 4))
                      ((p n).matchedMoments ((p n).trajectory (s n) k)) -
                    (p n).windowOsc (s n) (↑k * (p n).matchedStep)‖ ≤
                C * (p n).matchedStep * ((p n).comparisonInitialSize (s n) + (p n).renormAdditive) ∧
              |((p n).trajectory (s n) k).R -
                    ((p n).windowSlow (s n) (↑k * (p n).matchedStep) / 2 +
                      ((p n).windowOsc (s n) (↑k * (p n).matchedStep)).re / 2)| ≤
                C * (p n).matchedStep * ((p n).comparisonInitialSize (s n) + (p n).renormAdditive)
SparseSGD.curvature_window_local_average (p : ℕ → SparseSGD.Params) (s : ℕ → SparseSGD.Moments) (w u margin : ℝ)
  (jury : SparseSGD.External.JuryStability) (hb : Filter.Tendsto (fun n => (p n).beta) Filter.atTop (nhds 1))
  (hw : Filter.Tendsto (fun n => (p n).w) Filter.atTop (nhds w))
  (hu : Filter.Tendsto (fun n => (p n).noise) Filter.atTop (nhds u)) (hw0 : 0 < w) (hw4 : w < 4) (hm : 0 < margin)
  (hb1 : ∀ᶠ (n : ℕ) in Filter.atTop, (p n).beta < 1) (hu0 : ∀ᶠ (n : ℕ) in Filter.atTop, 0 ≤ (p n).noise)
  (hp : ∀ᶠ (n : ℕ) in Filter.atTop, 0 ≤ (p n).renormAdditive) (hs : ∀ (n : ℕ), (s n).psd)
  (hum : u / (1 - w / 4) ≤ 1 - margin) (hnyq : 2 * Real.sin margin ≤ |w - 2|) :
  ∃ C,
    0 ≤ C ∧
      ∀ᶠ (n : ℕ) in Filter.atTop,
        ∀ (k N : ℕ),
          0 < N →
            |(∑ j ∈ Finset.range N, ((p n).trajectory (s n) (k + j)).R) / ↑N -
                  (p n).windowSlow (s n) (↑k * (p n).matchedStep) / 2| ≤
              C * (p n).matchedStep * ((p n).comparisonInitialSize (s n) + (p n).renormAdditive) +
                8 / margin * ((p n).comparisonInitialSize (s n) + (p n).renormAdditive) *
                  (↑N * (p n).matchedStep + 1 / (↑N * (p n).foldedAngle))
SparseSGD.eight_cells_exhaustive (gamma d n c : ℝ) (hg : gamma > 0) (hc : c = d - 2 * gamma) (hn : n ≤ 0)
  (hload : c ≤ 0) :
  SparseSGD.Cell1 d n c ∨
    SparseSGD.Cell2 d n c ∨
      SparseSGD.Cell3 d n c ∨
        SparseSGD.Cell4 d n c ∨
          SparseSGD.Cell5 d n c ∨ SparseSGD.Cell6 d n c ∨ SparseSGD.Cell7 d n c ∨ SparseSGD.Cell8 d n c
SparseSGD.exists_largeMode_parameter (delta u : ℝ) (hd : 0 < delta) (hu0 : 0 ≤ u) (hu1 : u < 1) :
  ∃ a, 0 ≤ a ∧ a < 1 ∧ a ^ 3 + (4 * delta - 1) * a - 4 * delta * u = 0
SparseSGD.exponential_pair_quadrature_bound (δ : ℝ) (hδ : 0 < δ) :
  ∃ C,
    0 ≤ C ∧
      ∀ (mu lambda : ℂ) (h : ℝ) (k : ℕ),
        0 < h →
          |((lambda - mu) * ↑h).re| ≤ 3 →
            |((lambda - mu) * ↑h).im| ≤ 2 * Real.pi - δ →
              ‖SparseSGD.sampledPairSum mu lambda (↑h) k - SparseSGD.pairIntegral mu lambda (↑k * h)‖ ≤
                C * h * ‖Complex.exp (lambda * ↑(↑k * h)) - Complex.exp (mu * ↑(↑k * h))‖
SparseSGD.exponential_pair_quadrature_bound_stable (δ : ℝ) (hδ : 0 < δ) :
  ∃ C,
    0 ≤ C ∧
      ∀ (mu lambda : ℂ) (h : ℝ) (k : ℕ),
        mu.re ≤ 0 →
          lambda.re ≤ 0 →
            0 < h →
              |((lambda - mu) * ↑h).re| ≤ 3 →
                |((lambda - mu) * ↑h).im| ≤ 2 * Real.pi - δ →
                  ‖SparseSGD.sampledPairSum mu lambda (↑h) k - SparseSGD.pairIntegral mu lambda (↑k * h)‖ ≤ 2 * C * h
SparseSGD.floor_identity (p : SparseSGD.Params) (hc : p.curvature ≠ 1) (hu : p.totalLoad ≠ 1) :
  p.renormAdditive / (1 - p.renormNoise) = p.additive / (1 - p.totalLoad)
SparseSGD.free_oscillator_energy_bound (delta : ℝ) (x y : ℝ → ℝ) (hd : 0 ≤ delta)
  (hx : ∀ (t : ℝ), 0 ≤ t → HasDerivAt x (-delta * y t) t) (hy : ∀ (t : ℝ), 0 ≤ t → HasDerivAt y (x t - y t) t) (t : ℝ)
  (ht : 0 ≤ t) : x t ^ 2 + delta * y t ^ 2 ≤ x 0 ^ 2 + delta * y 0 ^ 2
SparseSGD.hasSum_sampled_exp (mu : ℂ) (ebar : ℝ) (hmu : mu.re < 0) (hebar : 0 < ebar) :
  HasSum (fun n => ↑ebar * Complex.exp (mu * ↑(n + 1) * ↑ebar)) (SparseSGD.m (-mu * ↑ebar) / -mu)
SparseSGD.kickResponse_eq_chebyshev (p : SparseSGD.Params) (hb : 0 < p.beta) (n : ℕ) :
  SparseSGD.kickResponse p n = SparseSGD.chebyResponse p n
SparseSGD.largeModeFrequency_deviation (delta a omega : ℝ) (hd : 1 ≤ delta) (ha0 : 0 ≤ a) (ha1 : a ≤ 1) (ho : 0 < omega)
  (hosq : omega ^ 2 = delta - 1 / 4) :
  0 ≤ SparseSGD.largeModeFrequency delta a - 2 * omega ∧
    SparseSGD.largeModeFrequency delta a - 2 * omega ≤ 3 / (16 * omega)
SparseSGD.largeModeRates_real_parts (delta a : ℝ) (ha0 : 0 ≤ a) (ha1 : a < 1) (i : Fin 3) :
  -3 / 2 ≤ (SparseSGD.largeModeRates delta a i).re ∧ (SparseSGD.largeModeRates delta a i).re < 0
SparseSGD.largeModeRootPlus_deviation (delta a omega : ℝ) (hd : 4 ≤ delta) (ha0 : 0 ≤ a) (ha1 : a ≤ 1) (ho : 0 < omega)
  (hosq : omega ^ 2 = delta - 1 / 4) :
  ‖SparseSGD.largeModeRootPlus delta a - SparseSGD.oscillatoryRoot omega‖ ≤ 3 ∧
    |(SparseSGD.largeModeRootPlus delta a).im - 2 * omega| ≤ 22 / omega
SparseSGD.largeMode_cubic_factor (delta u a : ℝ) (hd : 1 ≤ delta) (ha : a ^ 3 + (4 * delta - 1) * a - 4 * delta * u = 0)
  (z : ℂ) :
  z ^ 3 + 3 * z ^ 2 + (2 + 4 * ↑delta) * z + 4 * ↑delta * (1 - ↑u) =
    (z - ↑(a - 1)) * ((z + ↑(1 + a / 2)) ^ 2 + ↑(SparseSGD.largeModeFrequency delta a) ^ 2)
SparseSGD.load_exponents_nonpos_iff (sigma kappa gamma alpha : ℝ) :
  SparseSGD.eNoise sigma alpha ≤ 0 ∧ SparseSGD.eCurvature gamma kappa alpha ≤ 0 ↔
    alpha ≥ SparseSGD.criticalAlpha sigma kappa gamma
SparseSGD.moment_comparison (margin : ℝ) (hm : 0 < margin) :
  ∃ C,
    0 ≤ C ∧
      ∀ (p : SparseSGD.Params) (s : SparseSGD.Moments),
        1 / 2 ≤ p.beta →
          p.beta < 1 →
            0 < p.w →
              p.w < 2 * (1 + p.beta) →
                SparseSGD.External.JuryStability →
                  s.psd →
                    0 ≤ p.renormNoise →
                      p.renormNoise ≤ 1 - margin →
                        0 ≤ p.renormAdditive →
                          (SparseSGD.comparisonDeltaThreshold margin ≤ p.matchedDelta →
                              p.foldedAngle ≤ Real.pi / 2 - margin) →
                            ∀ (k : ℕ),
                              |(p.trajectory s k).R - (p.comparisonFlow s (↑k * p.matchedStep)).R| ≤
                                  C * p.matchedStep * (p.comparisonInitialSize s + p.renormAdditive) ∧
                                (1 ≤ p.matchedDelta →
                                  |SparseSGD.slowEnergy p.matchedDelta (p.matchedMoments (p.trajectory s k)) -
                                          SparseSGD.slowEnergy p.matchedDelta
                                            (p.comparisonFlow s (↑k * p.matchedStep))| ≤
                                      C * p.matchedStep * (p.comparisonInitialSize s + p.renormAdditive) ∧
                                    ‖SparseSGD.oscillatoryEnergy p.matchedDelta
                                            (SparseSGD.oscillatoryRoot √(p.matchedDelta - 1 / 4))
                                            (p.matchedMoments (p.trajectory s k)) -
                                          SparseSGD.oscillatoryEnergy p.matchedDelta
                                            (SparseSGD.oscillatoryRoot √(p.matchedDelta - 1 / 4))
                                            (p.comparisonFlow s (↑k * p.matchedStep))‖ ≤
                                      C * p.matchedStep * (p.comparisonInitialSize s + p.renormAdditive))
SparseSGD.noise_only_rate (u : ℝ) : 1 - u / (1 - 0 / 4) = 1 - u
SparseSGD.oscillatoryEnergy_hasDerivAt {delta u phi : ℝ} {s : ℝ → SparseSGD.Moments}
  (hs : SparseSGD.IsMomentSolution delta u phi s) (hd : delta ≠ 0) (lambda : ℂ) (hl : lambda + 2 ≠ 0)
  (hq : lambda ^ 2 + 2 * lambda + 4 * ↑delta = 0) {t : ℝ} (ht : 0 ≤ t) :
  HasDerivAt (fun t => SparseSGD.oscillatoryEnergy delta lambda (s t))
    (lambda * SparseSGD.oscillatoryEnergy delta lambda (s t) - 2 * lambda / (lambda + 2) * (↑u * ↑(s t).R + ↑phi)) t
SparseSGD.quadrature_factor_bound (δ : ℝ) (hδ : 0 < δ) :
  ∃ C, 0 ≤ C ∧ ∀ (y : ℂ), |y.re| ≤ 3 → |y.im| ≤ 2 * Real.pi - δ → ‖SparseSGD.m y - 1‖ ≤ C * ‖y‖
SparseSGD.raw_oracle_covariance_step.{u_1, u_2} {Ω : Type u_1} {E : Type u_2} [mΩ : MeasurableSpace Ω]
  [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] {μ : MeasureTheory.Measure Ω}
  [MeasureTheory.IsProbabilityMeasure μ] {F : ℕ → MeasurableSpace Ω} {e q ξ : ℕ → Ω → E} {vinc vadd : ℝ}
  (O : SparseSGD.RawOracleHypotheses μ F e q ξ vinc vadd) (beta eta A : ℝ) (hA : 0 < A)
  (he0 : MeasureTheory.MemLp (e 0) 2 μ) (hq0 : MeasureTheory.MemLp (q 0) 2 μ)
  (heStep : ∀ (k : ℕ), e (k + 1) = (1 - eta * (1 - beta) * A) • e k - beta • q k - (eta * (1 - beta)) • ξ k)
  (hqStep : ∀ (k : ℕ), q (k + 1) = (eta * (1 - beta) * A) • e k + beta • q k + (eta * (1 - beta)) • ξ k) (k : ℕ) :
  have p := SparseSGD.oracleParams beta eta A vinc vadd;
  have s := SparseSGD.Probability.LeastSquares.integratedMoments μ (e k) (q k);
  (SparseSGD.Probability.LeastSquares.integratedMoments μ (e (k + 1)) (q (k + 1))).cov =
    p.meanMatrix * s.cov * p.meanMatrix.transpose +
      (2 * p.w * p.eps * (p.noise * s.R + p.additive)) • Matrix.vecMulVec SparseSGD.kick SparseSGD.kick
SparseSGD.raw_oracle_memLp.{u_1, u_2} {Ω : Type u_1} {E : Type u_2} [mΩ : MeasurableSpace Ω] [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] [CompleteSpace E] {μ : MeasureTheory.Measure Ω} [MeasureTheory.IsProbabilityMeasure μ]
  {F : ℕ → MeasurableSpace Ω} {e q ξ : ℕ → Ω → E} {vinc vadd : ℝ}
  (O : SparseSGD.RawOracleHypotheses μ F e q ξ vinc vadd) (beta eta A : ℝ) (he0 : MeasureTheory.MemLp (e 0) 2 μ)
  (hq0 : MeasureTheory.MemLp (q 0) 2 μ)
  (heStep : ∀ (k : ℕ), e (k + 1) = (1 - eta * (1 - beta) * A) • e k - beta • q k - (eta * (1 - beta)) • ξ k)
  (hqStep : ∀ (k : ℕ), q (k + 1) = (eta * (1 - beta) * A) • e k + beta • q k + (eta * (1 - beta)) • ξ k) (k : ℕ) :
  MeasureTheory.MemLp (e k) 2 μ ∧ MeasureTheory.MemLp (q k) 2 μ ∧ MeasureTheory.MemLp (ξ k) 2 μ
SparseSGD.raw_oracle_moment_trajectory.{u_1, u_2} {Ω : Type u_1} {E : Type u_2} [mΩ : MeasurableSpace Ω]
  [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] {μ : MeasureTheory.Measure Ω}
  [MeasureTheory.IsProbabilityMeasure μ] {F : ℕ → MeasurableSpace Ω} {e q ξ : ℕ → Ω → E} {vinc vadd : ℝ}
  (O : SparseSGD.RawOracleHypotheses μ F e q ξ vinc vadd) (beta eta A : ℝ) (hA : 0 < A)
  (he0 : MeasureTheory.MemLp (e 0) 2 μ) (hq0 : MeasureTheory.MemLp (q 0) 2 μ)
  (heStep : ∀ (k : ℕ), e (k + 1) = (1 - eta * (1 - beta) * A) • e k - beta • q k - (eta * (1 - beta)) • ξ k)
  (hqStep : ∀ (k : ℕ), q (k + 1) = (eta * (1 - beta) * A) • e k + beta • q k + (eta * (1 - beta)) • ξ k) (k : ℕ) :
  SparseSGD.Probability.LeastSquares.integratedMoments μ (e k) (q k) =
    (SparseSGD.oracleParams beta eta A vinc vadd).trajectory
      (SparseSGD.Probability.LeastSquares.integratedMoments μ (e 0) (q 0)) k
SparseSGD.regular_chain_uniform_convergence (P : ℕ → SparseSGD.Params) (s : ℕ → SparseSGD.Moments) (delta₀ u₀ phi₀ : ℝ)
  (s₀ : SparseSGD.Moments) (margin : ℝ) (hm : 0 < margin) (jury : SparseSGD.External.JuryStability)
  (hchain :
    ∀ (n : ℕ),
      1 / 2 ≤ (P n).beta ∧
        (P n).beta < 1 ∧
          0 < (P n).w ∧
            (P n).w < 2 * (1 + (P n).beta) ∧
              (s n).psd ∧
                0 ≤ (P n).renormNoise ∧
                  (P n).renormNoise ≤ 1 - margin ∧
                    0 ≤ (P n).renormAdditive ∧
                      (SparseSGD.comparisonDeltaThreshold margin ≤ (P n).matchedDelta →
                        (P n).foldedAngle ≤ Real.pi / 2 - margin))
  (hh : Filter.Tendsto (fun n => (P n).matchedStep) Filter.atTop (nhds 0))
  (hd : Filter.Tendsto (fun n => (P n).matchedDelta) Filter.atTop (nhds delta₀))
  (hu : Filter.Tendsto (fun n => (P n).renormNoise) Filter.atTop (nhds u₀))
  (hp : Filter.Tendsto (fun n => (P n).renormAdditive) Filter.atTop (nhds phi₀))
  (hsR : Filter.Tendsto (fun n => ((P n).matchedMoments (s n)).R) Filter.atTop (nhds s₀.R))
  (hsV : Filter.Tendsto (fun n => ((P n).matchedMoments (s n)).V) Filter.atTop (nhds s₀.V))
  (hsC : Filter.Tendsto (fun n => ((P n).matchedMoments (s n)).C) Filter.atTop (nhds s₀.C)) (hd0 : 0 < delta₀) (ε : ℝ) :
  ε > 0 →
    ∀ᶠ (n : ℕ) in Filter.atTop,
      ∀ (k : ℕ),
        |((P n).trajectory (s n) k).R - (SparseSGD.continuumFlow delta₀ u₀ phi₀ s₀ (↑k * (P n).matchedStep)).R| < ε
SparseSGD.renormNoise_lt_one_iff (p : SparseSGD.Params) (hc : p.curvature < 1) : p.renormNoise < 1 ↔ p.totalLoad < 1
SparseSGD.risk_modal_inversion (delta omega : ℝ) (s : SparseSGD.Moments) (ho : omega ≠ 0)
  (h : omega ^ 2 = delta - 1 / 4) :
  s.R =
    SparseSGD.riskSlowCoefficient delta omega * SparseSGD.slowEnergy delta s +
      2 *
        (SparseSGD.riskOscillatoryCoefficient omega *
            SparseSGD.oscillatoryEnergy delta (SparseSGD.oscillatoryRoot omega) s).re
SparseSGD.sampled_pair_sum_quadrature (mu lambda : ℂ) (ebar : ℝ) (k : ℕ)
  (hpole : (lambda - mu) * ↑ebar = 0 ∨ Complex.exp ((lambda - mu) * ↑ebar) ≠ 1) :
  SparseSGD.sampledPairSum mu lambda (↑ebar) k =
    SparseSGD.m ((lambda - mu) * ↑ebar) * SparseSGD.pairIntegral mu lambda (↑k * ebar)
SparseSGD.slowEnergy_hasDerivAt {delta u phi : ℝ} {s : ℝ → SparseSGD.Moments}
  (hs : SparseSGD.IsMomentSolution delta u phi s) (hd : delta ≠ 0) {t : ℝ} (ht : 0 ≤ t) :
  HasDerivAt (fun t => SparseSGD.slowEnergy delta (s t)) (-SparseSGD.slowEnergy delta (s t) + 2 * (u * (s t).R + phi)) t
SparseSGD.smallDelta_trajectory_learningProfile (p : SparseSGD.Params) (Delta R : ℝ)
  (jury : SparseSGD.External.JuryStability) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1) (hD0 : 0 < Delta)
  (hD1 : Delta ≤ 1 / 8) (hw : p.w = SparseSGD.smallDeltaW p.beta Delta) (hR : 0 ≤ R) (hu0 : 0 ≤ p.renormNoise)
  (hu1 : p.renormNoise < 1) (hp : 0 ≤ p.renormAdditive) (k : ℕ) :
  |(p.trajectory { R := R, V := 0, C := 0 } k).R -
        SparseSGD.Scaling.learningProfile p.renormNoise p.renormAdditive R (↑k * (p.w / p.eps))| ≤
    (538 / (1 - p.renormNoise) + 8) * Delta * (R + p.renormAdditive / (1 - p.renormNoise))
SparseSGD.stable_kernel_masses (jury : SparseSGD.External.JuryStability) (p : SparseSGD.Params) (hb0 : 1 / 2 ≤ p.beta)
  (hb1 : p.beta < 1) (hw0 : 0 < p.w) (hw1 : p.w < 2 * (1 + p.beta)) :
  HasSum (fun n => 2 * p.w * p.eps * p.noise * SparseSGD.kickResponse p n ^ 2) p.renormNoise ∧
    HasSum (fun n => 2 * p.w * p.eps * p.additive * SparseSGD.kickResponse p n ^ 2) p.renormAdditive
SparseSGD.trajectory_risk_geometric_convergence (jury : SparseSGD.External.JuryStability) (p : SparseSGD.Params)
  (s : SparseSGD.Moments) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1) (hw0 : 0 < p.w) (hw1 : p.w < 2 * (1 + p.beta))
  (hnoise : 0 ≤ p.noise) (hadd : 0 ≤ p.additive) (hload : p.totalLoad < 1) :
  ∃ C r, 0 ≤ C ∧ 0 < r ∧ r < 1 ∧ ∀ (k : ℕ), |(p.trajectory s k).R - p.additive / (1 - p.totalLoad)| ≤ C * r ^ k
SparseSGD.trajectory_risk_not_geometrically_decaying (jury : SparseSGD.External.JuryStability) (p : SparseSGD.Params)
  (s : SparseSGD.Moments) (hs : s.psd) (hs0 : s ≠ 0) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1) (hw0 : 0 < p.w)
