SparseSGD.Scaling.cor_resonance_fixed_rate (pStar kappa bStar epsStar gamma etaStar R : ℝ) (p : ℕ → ↑unitInterval)
  (ν : MeasureTheory.Measure ℝ) (jury : SparseSGD.External.JuryStability) (hp : 0 < pStar) (hk : 0 ≤ kappa)
  (hb : 0 < bStar) (he : 0 < epsStar) (hg : 0 < gamma) (heta : 0 < etaStar) (hline : gamma = 1 + kappa)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d) (hR : 0 ≤ R)
  (hu1 : etaStar / (2 * ↑(SparseSGD.Scaling.fixedRealizedBatch bStar)) < 1) :
  ∃ C > 0,
    ∀ᶠ (d : ℕ) in Filter.atTop,
      ∀ (k : ℕ),
        have P := SparseSGD.Scaling.actualLSParams pStar kappa bStar 0 epsStar gamma etaStar 1 p ν d;
        |(P.trajectory { R := R, V := 0, C := 0 } k).R -
