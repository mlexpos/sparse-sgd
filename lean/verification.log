  (hTaylor : ∀ j < K, ∀ (y : E), ‖y - x j‖ ≤ ρ → ‖Ψ y - Ψ (x j) - (J j) (y - x j)‖ ≤ L2 / 2 * ‖y - x j‖ ^ 2) (ω : Ω)
  (h0 : X 0 ω = x 0) (hnoise : ∀ k ≤ K, ‖SparseSGD.Logistic.fluidStoppedSum Ψ X x J ρ k ω‖ ≤ lambda) (k : ℕ) :
