SparseSGD.Logistic.matchedPopulationJacobian_uniform_controls (S : SparseSGD.External.GaussianSteinCertificate 1)
  (teacherNorm T P : ℝ) (hT : 0 ≤ T) (hP : 0 ≤ P) :
  ∃ C,
    0 ≤ C ∧
      ∀ {d B : ℕ} (eta beta : ℝ) (p : ↑unitInterval) (mu : SparseSGD.Logistic.Vec d),
        SparseSGD.Logistic.r mu = teacherNorm →
          0 ≤ eta →
            0 < ↑p →
              ↑p ≤ 1 / 2 →
                ‖SparseSGD.Logistic.matchedDimensionlessParameters eta beta p mu‖ ≤ P →
                  (∀ (y : SparseSGD.Logistic.MatchedCoordinate),
                      SparseSGD.Logistic.matchedPhysical y →
                        ‖y‖ ≤ T →
                          ‖SparseSGD.Logistic.matchedPopulationJacobian eta beta p mu y -
                                SparseSGD.Logistic.matchedFreeOperator beta‖ ≤
                            C * (eta * ↑p)) ∧
                    ∀ (x y : SparseSGD.Logistic.MatchedCoordinate),
                      SparseSGD.Logistic.matchedPhysical x →
                        SparseSGD.Logistic.matchedPhysical y →
                          ‖x‖ ≤ T →
                            ‖y‖ ≤ T →
                              ‖SparseSGD.Logistic.matchedDriftMap eta beta p mu x -
                                      SparseSGD.Logistic.matchedDriftMap eta beta p mu y -
                                    (SparseSGD.Logistic.matchedPopulationJacobian eta beta p mu y) (x - y)‖ ≤
                                C * (eta * ↑p) * ‖x - y‖ ^ 2
SparseSGD.Logistic.matched_regular_small_probability_eventually_bounded (r0 delta Phi M T : ℝ) (hdelta : 0 < delta)
  (hPhi : 0 ≤ Phi) (hM : 1 ≤ M) (hT : 0 ≤ T) (v : ℝ → SparseSGD.Logistic.DynamicState)
  (hv :
    ∀ t ∈ Set.Icc 0 (T * max 1 (1 / (delta / 2))), HasDerivAt v (SparseSGD.Logistic.dynamicField r0 delta Phi (v t)) t)
  (hvM : ∀ t ∈ Set.Icc 0 (T * max 1 (1 / (delta / 2))), ‖v t‖ ≤ M - 1)
  (S : SparseSGD.External.GaussianSteinCertificate 2) :
  ∃ pCap A,
    0 < pCap ∧
      0 ≤ A ∧
        ∀ (eta beta : ℕ → ℝ) (p : ℕ → ↑unitInterval) (mu : (d : ℕ) → SparseSGD.Logistic.Vec d) (B K : ℕ → ℕ)
          (y : ℕ → ℕ → Fin 5 → ℝ),
          (∀ᶠ (d : ℕ) in Filter.atTop,
              0 < B d ∧
                0 < SparseSGD.Logistic.r (mu d) ∧
                  SparseSGD.Logistic.r (mu d) = r0 ∧ 0 < ↑(p d) ∧ 0 < eta d ∧ 0 < 1 - beta d ∧ 1 - beta d ≤ 1) →
            (∀ᶠ (d : ℕ) in Filter.atTop,
                SparseSGD.Logistic.matchedPhysical (y d 0) ∧
                  SparseSGD.Logistic.matchedToDynamic (eta d * ↑(p d) / (1 - beta d)) (y d 0) = v 0) →
              (∀ᶠ (d : ℕ) in Filter.atTop,
                  ∀ (n : ℕ), y d (n + 1) = SparseSGD.Logistic.matchedDriftMap (eta d) (beta d) (p d) (mu d) (y d n)) →
                (∀ᶠ (d : ℕ) in Filter.atTop, ↑(K d) * min (eta d * ↑(p d)) (1 - beta d) ≤ T) →
                  Filter.Tendsto (fun d => eta d * ↑(p d) / (1 - beta d)) Filter.atTop (nhds delta) →
                    Filter.Tendsto (fun d => SparseSGD.Logistic.dynamicSourceLoad d (B d) (eta d)) Filter.atTop
                        (nhds Phi) →
                      Filter.Tendsto (fun d => 1 - beta d) Filter.atTop (nhds 0) →
                        (∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) ≤ pCap) → ∀ᶠ (d : ℕ) in Filter.atTop, ∀ n ≤ K d, ‖y d n‖ ≤ A
SparseSGD.Logistic.matched_warm_slow_small_probability_eventually_bounded (r0 Phi M T W : ℝ) (hr0 : 0 ≤ r0)
  (hPhi : 0 ≤ Phi) (hM : 2 ≤ M) (hT : 0 ≤ T) (hW : 0 ≤ W) (v : ℝ → ℝ × ℝ)
  (hv : ∀ t ∈ Set.Icc 0 T, HasDerivAt v (SparseSGD.Logistic.slowVectorField r0 Phi (v t)) t)
  (hvM : ∀ t ∈ Set.Icc 0 T, ‖v t‖ ≤ M - 2) (S1 : SparseSGD.External.GaussianSteinCertificate 1)
  (S2 : SparseSGD.External.GaussianSteinCertificate 2) :
  ∃ pCap A,
    0 < pCap ∧
      0 ≤ A ∧
        ∀ (eta beta : ℕ → ℝ) (p : ℕ → ↑unitInterval) (mu : (d : ℕ) → SparseSGD.Logistic.Vec d) (B K : ℕ → ℕ)
          (y : ℕ → ℕ → Fin 5 → ℝ),
          (∀ᶠ (d : ℕ) in Filter.atTop,
              0 < B d ∧
                0 < SparseSGD.Logistic.r (mu d) ∧
                  SparseSGD.Logistic.r (mu d) = r0 ∧ 0 < ↑(p d) ∧ 0 < eta d ∧ 0 < 1 - beta d ∧ 1 - beta d ≤ 1) →
            (∀ᶠ (d : ℕ) in Filter.atTop,
                SparseSGD.Logistic.matchedPhysical (y d 0) ∧
                  ‖y d 0‖ ≤ W ∧ SparseSGD.Logistic.matchedEffectiveSlow (beta d) (y d 0) = v 0) →
              (∀ᶠ (d : ℕ) in Filter.atTop,
                  ∀ (n : ℕ), y d (n + 1) = SparseSGD.Logistic.matchedDriftMap (eta d) (beta d) (p d) (mu d) (y d n)) →
                (∀ᶠ (d : ℕ) in Filter.atTop, ↑(K d) * min (eta d * ↑(p d)) (1 - beta d) ≤ T) →
                  Filter.Tendsto (fun d => eta d * ↑(p d) / (1 - beta d)) Filter.atTop (nhds 0) →
                    Filter.Tendsto (fun d => eta d * ↑(p d)) Filter.atTop (nhds 0) →
                      Filter.Tendsto (fun d => SparseSGD.Logistic.dynamicSourceLoad d (B d) (eta d)) Filter.atTop
                          (nhds Phi) →
                        (∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) ≤ pCap) → ∀ᶠ (d : ℕ) in Filter.atTop, ∀ n ≤ K d, ‖y d n‖ ≤ A
SparseSGD.Logistic.populationLoss_canonical_equilibrium_floor {d : ℕ}
  (H : SparseSGD.External.GaussianSteinCertificate d) (p : ↑unitInterval) (mu theta : SparseSGD.Logistic.Vec d)
  (Phi : ℝ) (hr : 0 < SparseSGD.Logistic.r mu) (hPhi : 0 ≤ Phi) (hPhi1 : Phi ≤ 1)
