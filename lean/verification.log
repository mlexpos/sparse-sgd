  (hh : Filter.Tendsto (fun n => (P n).matchedStep) Filter.atTop (nhds 0))
  (hd : Filter.Tendsto (fun n => (P n).matchedDelta) Filter.atTop (nhds delta₀))
  (hu : Filter.Tendsto (fun n => (P n).renormNoise) Filter.atTop (nhds u₀))
  (hp : Filter.Tendsto (fun n => (P n).renormAdditive) Filter.atTop (nhds phi₀))
  (hsR : Filter.Tendsto (fun n => ((P n).matchedMoments (s n)).R) Filter.atTop (nhds s₀.R))
  (hsV : Filter.Tendsto (fun n => ((P n).matchedMoments (s n)).V) Filter.atTop (nhds s₀.V))
  (hsC : Filter.Tendsto (fun n => ((P n).matchedMoments (s n)).C) Filter.atTop (nhds s₀.C)) (hd0 : 0 < delta₀) (ε : ℝ) :
  ε > 0 →
    ∀ᶠ (n : ℕ) in Filter.atTop,
      ∀ (k : ℕ),
        |((P n).trajectory (s n) k).R - (SparseSGD.continuumFlow delta₀ u₀ phi₀ s₀ (↑k * (P n).matchedStep)).R| < ε
