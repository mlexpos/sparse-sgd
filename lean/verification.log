  (hκ : 1 < SparseSGD.Scaling.Helps.kappaV ps) :
  4 * (↑d + 2 - ↑(ps (Fin.last n))) / ↑(ps 0) ≤ SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.sgdClass ∧
    SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.sgdClass ≤
      SparseSGD.Scaling.Helps.kappaV ps ^ 2 / (SparseSGD.Scaling.Helps.kappaV ps ^ 2 - 1) * (4 * (↑d + 2) / ↑(ps 0))
SparseSGD.Scaling.Helps.helps_transfer (D c : ℝ) (hD : 0 < D) (hc : 0 < c) :
  ∃ eps0 ∈ Set.Ioc 0 (1 / 2),
    ∃ C,
      ∀ eps ∈ Set.Ioc 0 eps0,
        ∀ Delta ∈ Set.Ioc 0 D,
          ∀ un ∈ Set.Icc 0 (c * Delta),
            |SparseSGD.Scaling.Helps.perStepRate (SparseSGD.Scaling.Helps.transferParams eps Delta un) -
                    eps * SparseSGD.continuumPerronRate Delta un| ≤
                C * eps ^ (4 / 3) ∧
              |SparseSGD.Scaling.Helps.perStepRate (SparseSGD.Scaling.Helps.transferParams eps Delta un) -
                    eps *
                      SparseSGD.continuumPerronRate Delta
                        (un + (SparseSGD.Scaling.Helps.transferParams eps Delta un).curvature)| ≤
                C * eps ^ (4 / 3)
SparseSGD.Scaling.Helps.helps_transfer_box (D U : ℝ) (hD : 0 < D) (hU : 0 ≤ U) :
  ∃ eps0 ∈ Set.Ioc 0 (1 / 2),
    ∃ C,
      ∀ eps ∈ Set.Ioc 0 eps0,
        ∀ Delta ∈ Set.Ioc 0 D,
          ∀ un ∈ Set.Icc 0 U,
            |SparseSGD.Scaling.Helps.perStepRate (SparseSGD.Scaling.Helps.transferParams eps Delta un) -
                    eps * SparseSGD.continuumPerronRate Delta un| ≤
                C * eps ^ (4 / 3) ∧
              |SparseSGD.Scaling.Helps.perStepRate (SparseSGD.Scaling.Helps.transferParams eps Delta un) -
                    eps *
                      SparseSGD.continuumPerronRate Delta
                        (un + (SparseSGD.Scaling.Helps.transferParams eps Delta un).curvature)| ≤
                C * eps ^ (4 / 3)
SparseSGD.Scaling.Helps.helps_transfer_compact {K : Set (ℝ × ℝ)} (hK : IsCompact K)
  (hsub : K ⊆ Set.Ioi 0 ×ˢ Set.Ico 0 1) :
  ∃ eps0 ∈ Set.Ioc 0 (1 / 2),
    ∃ C,
      ∀ eps ∈ Set.Ioc 0 eps0,
        ∀ x ∈ K,
          |SparseSGD.Scaling.Helps.perStepRate (SparseSGD.Scaling.Helps.transferParams eps x.1 x.2) /
                  (eps * SparseSGD.continuumPerronRate x.1 x.2) -
                1| ≤
            C * eps ^ (1 / 3)
SparseSGD.Scaling.Helps.helps_vocab_asymptotic (nu0 : ℝ) (hnu0 : 0 < nu0) :
  ∃ eps0,
    0 < eps0 ∧
      eps0 ≤ 1 / 2 ∧
        ∃ C,
          0 ≤ C ∧
            C * eps0 ^ (1 / 3) ≤ 1 / 2 ∧
              ∀ (d B : ℕ) (p : ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (beta : ℝ),
                0 < B →
                  0 < ↑p →
                    0 < 1 - beta →
                      1 - beta ≤ eps0 →
                        SparseSGD.Scaling.Helps.lsNu d B p beta ∈ Set.Icc (nu0 / 2) (2 * nu0) →
                          ∀ eta ∈ Set.Ioo 0 (SparseSGD.Probability.LeastSquares.criticalRate d B p beta),
                            SparseSGD.Scaling.Helps.lsRate d B p ν beta eta ≤
                                ↑p * ↑B / ((↑d + 2 - ↑p) * (1 - C * (1 - beta) ^ (1 / 3))) ∧
                              (0 < SparseSGD.Scaling.Helps.lsRate d B p ν beta eta →
                                (↑d + 2 - ↑p) / (↑B * ↑p) * (1 - C * (1 - beta) ^ (1 / 3)) ≤
                                  1 / SparseSGD.Scaling.Helps.lsRate d B p ν beta eta)
SparseSGD.Scaling.Helps.helps_vocab_iii_coscaling {δ : ℝ} (hδ : 0 < δ) :
  ∃ eps0,
    0 < eps0 ∧
      ∀ (n d B : ℕ) (ν : MeasureTheory.Measure ℝ) (ps : Fin (n + 1) → ↑unitInterval) (beta eta : ℝ),
        (∀ (j : Fin (n + 1)), 0 < ↑(ps j)) →
          Antitone ps →
            0 < B →
              0 < 1 - beta →
                1 - beta ≤ eps0 →
                  0 < eta →
                    (∀ (j : Fin (n + 1)),
                        SparseSGD.Scaling.Helps.stepRadius (SparseSGD.Scaling.Helps.copyParams d B ν beta eta ps j) <
                          1) →
                      (1 - δ) *
                              max (SparseSGD.Scaling.Helps.lsNstab d B (ps (Fin.last n)) beta)
                                (SparseSGD.Scaling.Helps.lsNmem B (ps (Fin.last n)) beta) /
                            (↑B * ↑(ps (Fin.last n))) ≤
                          1 / SparseSGD.Scaling.Helps.Lmin d B ν beta eta ps ∧
                        (1 - δ) * (↑d + 2 - ↑(ps (Fin.last n))) / (↑B * ↑(ps (Fin.last n))) ≤
                          1 / SparseSGD.Scaling.Helps.Lmin d B ν beta eta ps
SparseSGD.Scaling.Helps.helps_vocab_v_case1 {n d B : ℕ} {ν : MeasureTheory.Measure ℝ} {ps : Fin (n + 1) → ↑unitInterval}
  (hB : 1 ≤ B) (hp : ∀ (j : Fin (n + 1)), 0 < ↑(ps j)) (hanti : Antitone ps)
  (hcase : (↑B - 1) * (↑(ps 0) - ↑(ps (Fin.last n))) ≤ ↑d + 2) :
  IsGreatest (SparseSGD.Scaling.Helps.sgdLminSet d B ν ps)
      (Real.log (1 + ↑B * ↑(ps (Fin.last n)) / (↑d + 2 - ↑(ps (Fin.last n))))) ∧
    (0 < SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n)) ∧
        (∀ (j : Fin (n + 1)),
            SparseSGD.Scaling.Helps.stepRadius
                (SparseSGD.Scaling.Helps.copyParams d B ν 0 (SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n))) ps
                  j) <
              1) ∧
          SparseSGD.Scaling.Helps.Lmin d B ν 0 (SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n))) ps =
            Real.log (1 + ↑B * ↑(ps (Fin.last n)) / (↑d + 2 - ↑(ps (Fin.last n))))) ∧
      ∀ (j : Fin (n + 1)),
        1 ≤ SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n)) / SparseSGD.Scaling.Helps.etaStar d B ↑(ps j) ∧
          SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n)) / SparseSGD.Scaling.Helps.etaStar d B ↑(ps j) < 2
SparseSGD.Scaling.Helps.helps_vocab_v_case2 {n d B : ℕ} {ν : MeasureTheory.Measure ℝ} {ps : Fin (n + 1) → ↑unitInterval}
  (hB : 1 ≤ B) (hp : ∀ (j : Fin (n + 1)), 0 < ↑(ps j)) (hanti : Antitone ps)
  (hcase : ↑d + 2 < (↑B - 1) * (↑(ps 0) - ↑(ps (Fin.last n)))) :
  IsGreatest (SparseSGD.Scaling.Helps.sgdLminSet d B ν ps)
      (-Real.log (1 - 4 * ↑B * (↑B - 1) * ↑(ps 0) * ↑(ps (Fin.last n)) / SparseSGD.Scaling.Helps.DB d B ps ^ 2)) ∧
    (0 < 2 * ↑B / SparseSGD.Scaling.Helps.DB d B ps ∧
        (∀ (j : Fin (n + 1)),
            SparseSGD.Scaling.Helps.stepRadius
                (SparseSGD.Scaling.Helps.copyParams d B ν 0 (2 * ↑B / SparseSGD.Scaling.Helps.DB d B ps) ps j) <
              1) ∧
          SparseSGD.Scaling.Helps.Lmin d B ν 0 (2 * ↑B / SparseSGD.Scaling.Helps.DB d B ps) ps =
            -Real.log (1 - 4 * ↑B * (↑B - 1) * ↑(ps 0) * ↑(ps (Fin.last n)) / SparseSGD.Scaling.Helps.DB d B ps ^ 2)) ∧
      ∀ (j : Fin (n + 1)),
        2 * ↑B / SparseSGD.Scaling.Helps.DB d B ps < SparseSGD.Probability.LeastSquares.criticalRate d B (ps j) 0
SparseSGD.Scaling.Helps.helps_vocab_v_threshold {n d B : ℕ} {ν : MeasureTheory.Measure ℝ}
  {ps : Fin (n + 1) → ↑unitInterval} (hB : 1 ≤ B) (hp : ∀ (j : Fin (n + 1)), 0 < ↑(ps j)) (hanti : Antitone ps) :
  (SparseSGD.Scaling.Helps.sgdGain d B (↑(ps (Fin.last n))) (SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n))) ≤
        SparseSGD.Scaling.Helps.sgdGain d B (↑(ps 0)) (SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n))) ↔
      (↑B - 1) * (↑(ps 0) - ↑(ps (Fin.last n))) ≤ ↑d + 2) ∧
    (↑d + 2 < (↑B - 1) * (↑(ps 0) - ↑(ps (Fin.last n))) →
      SparseSGD.Scaling.Helps.Lmin d B ν 0 (SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n))) ps <
        -Real.log (1 - 4 * ↑B * (↑B - 1) * ↑(ps 0) * ↑(ps (Fin.last n)) / SparseSGD.Scaling.Helps.DB d B ps ^ 2))
SparseSGD.Scaling.Helps.hyperbolaN (a b : ℝ) : ℝ
SparseSGD.Scaling.Helps.hyperbola_eq {a b : ℝ} (ha : 0 < a) (hb : 0 < b) :
