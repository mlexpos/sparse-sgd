  (hz : (z • 1 - (SparseSGD.Logistic.V2.jacobianMatrix a theta 0 delta).map Complex.ofReal).det = 0) : z.re < 0
SparseSGD.Logistic.V2.jacobian_products {n : ℕ} (H : SparseSGD.Logistic.V2.RecursionSetup n) (K : Set (Fin n → ℝ))
  (hex : ∀ y0 ∈ K, ∃ y, SparseSGD.Logistic.V2.IsODESol H.b y0 y)
  (hent : SparseSGD.Logistic.V2.UniformEntry H.b H.ystar K)
  (htrack :
    ∀ (T : ℝ),
      0 ≤ T →
        ∃ CT εT,
          0 < CT ∧
            0 < εT ∧
              ∀ (ε : ℝ),
                0 < ε →
                  ε ≤ εT →
                    ∀ y0 ∈ K,
                      ∀ (y : ℝ → Fin n → ℝ),
                        SparseSGD.Logistic.V2.IsODESol H.b y0 y →
                          ∀ (k : ℕ),
                            ↑k * ε ≤ T → ‖(SparseSGD.Logistic.V2.driftMap H.b H.e ε)^[k] y0 - y (↑k * ε)‖ ≤ CT * H.ρ ε)
  (hdb : ∀ (y : Fin n → ℝ), ‖y - H.ystar‖ ≤ H.r0 → DifferentiableAt ℝ H.b y)
  (hde :
    ∀ (ε : ℝ),
      0 < ε → ∀ (y : Fin n → ℝ), ‖y - H.ystar‖ ≤ H.r0 → DifferentiableAt ℝ (H.e ε) y ∧ ‖fderiv ℝ (H.e ε) y‖ ≤ H.ρ ε)
  (hJ :
    ∀ (T : ℝ),
      0 ≤ T →
        ∃ L εL,
          0 ≤ L ∧
            0 < εL ∧
              ∀ (ε : ℝ),
                0 < ε →
                  ε ≤ εL →
                    ∀ y0 ∈ K,
                      ∀ (k : ℕ),
                        ↑k * ε ≤ T →
                          ‖fderiv ℝ (SparseSGD.Logistic.V2.driftMap H.b H.e ε)
                                ((SparseSGD.Logistic.V2.driftMap H.b H.e ε)^[k] y0)‖ ≤
                            1 + L * ε) :
  ∃ ε1 ρ1 Γ c,
    0 < ε1 ∧
      0 < ρ1 ∧
        0 < Γ ∧
          0 < c ∧
            ∀ (ε : ℝ),
              0 < ε →
                ε ≤ ε1 →
                  H.ρ ε ≤ ρ1 →
                    ∀ y0 ∈ K,
                      ∀ (j m : ℕ),
                        ‖SparseSGD.Logistic.V2.jacProd (SparseSGD.Logistic.V2.driftMap H.b H.e ε)
                              ((SparseSGD.Logistic.V2.driftMap H.b H.e ε)^[j] y0) m‖ ≤
                          Γ * Real.exp (-(c * ε * ↑m))
SparseSGD.Logistic.V2.lambda_mu_trace (a theta R nu1 nu2 : ℝ) (ha : 0 < a) (hθ : theta ≠ 0) (hR : 0 < R)
  (h1 : nu1 ^ 2 = SparseSGD.Logistic.V2.freqSq1 a theta R) (h2 : nu2 ^ 2 = SparseSGD.Logistic.V2.freqSq2 a theta R) :
  SparseSGD.Logistic.V2.lambdaZero theta R +
        2 *
          (-SparseSGD.Logistic.V2.raylN a R nu1 (SparseSGD.Logistic.V2.oscS a theta nu1) /
            (2 * SparseSGD.Logistic.V2.raylD a theta R nu1 (SparseSGD.Logistic.V2.oscS a theta nu1))) +
      2 *
        (-SparseSGD.Logistic.V2.raylN a R nu2 (SparseSGD.Logistic.V2.oscS a theta nu2) /
          (2 * SparseSGD.Logistic.V2.raylD a theta R nu2 (SparseSGD.Logistic.V2.oscS a theta nu2))) =
    -4
SparseSGD.Logistic.V2.lambda_zero_eq (a theta R : ℝ) (ha : a ≠ 0) (hR : 0 ≤ R) :
  SparseSGD.Logistic.V2.nullLeft a ⬝ᵥ
        SparseSGD.Logistic.V2.fastDamping.mulVec (SparseSGD.Logistic.V2.nullRight a theta R) /
      SparseSGD.Logistic.V2.nullLeft a ⬝ᵥ SparseSGD.Logistic.V2.nullRight a theta R =
    SparseSGD.Logistic.V2.lambdaZero theta R
SparseSGD.Logistic.V2.local_exponential_stability {n : ℕ} (f : (Fin n → ℝ) → Fin n → ℝ) (ystar : Fin n → ℝ)
  (A P : Matrix (Fin n) (Fin n) ℝ) (c : ℝ) (hc : 0 < c) (hPs : P.transpose = P)
  (hge : ∀ (x : Fin n → ℝ), x ⬝ᵥ x ≤ x ⬝ᵥ P.mulVec x)
  (hdec : ∀ (x : Fin n → ℝ), x ⬝ᵥ (A.transpose * P + P * A).mulVec x ≤ -c * x ⬝ᵥ x) (hf0 : f ystar = 0)
  (hd : HasFDerivAt f (LinearMap.toContinuousLinearMap (Matrix.toLin' A)) ystar) :
  ∃ ρ κ C,
    0 < ρ ∧
      0 < κ ∧
        0 < C ∧
          ∀ (y : ℝ → Fin n → ℝ),
            (∀ (t : ℝ), 0 ≤ t → HasDerivAt y (f (y t)) t) →
              ‖y 0 - ystar‖ ≤ ρ → ∀ (t : ℝ), 0 ≤ t → ‖y t - ystar‖ ≤ C * Real.exp (-κ * t) * ‖y 0 - ystar‖
SparseSGD.Logistic.V2.local_exponential_stability_uniform_o.{u_1} {n : ℕ} {Θ : Type u_1} [TopologicalSpace Θ]
  (Pset : Set Θ) (hK : IsCompact Pset) (f : Θ → (Fin n → ℝ) → Fin n → ℝ) (ystar : Θ → Fin n → ℝ)
  (A : Θ → Matrix (Fin n) (Fin n) ℝ) (hA : ContinuousOn A Pset) (hH : ∀ q ∈ Pset, SparseSGD.Logistic.V2.IsHurwitz (A q))
  (hrem :
    ∀ q0 ∈ Pset,
      ∀ (ε : ℝ),
        0 < ε →
          ∃ r,
            0 < r ∧
              ∀ᶠ (q : Θ) in nhdsWithin q0 Pset,
                ∀ (y : Fin n → ℝ), ‖y - ystar q‖ ≤ r → ‖f q y - (A q).mulVec (y - ystar q)‖ ≤ ε * ‖y - ystar q‖) :
  ∃ ρ κ C, 0 < ρ ∧ 0 < κ ∧ 0 < C ∧ SparseSGD.Logistic.V2.LocalDecay f ystar Pset ρ κ C
SparseSGD.Logistic.V2.local_fixed_point {n : ℕ} (H : SparseSGD.Logistic.V2.RecursionSetup n) :
  ∃ ε0 ρ0 C κ,
    0 < ε0 ∧
      0 < ρ0 ∧
        0 < C ∧
          0 < κ ∧
            ∃ N,
              (∃ s, 0 < s ∧ Metric.closedBall H.ystar s ⊆ N) ∧
                N ⊆ Metric.closedBall H.ystar H.r0 ∧
                  ∀ (ε : ℝ),
                    0 < ε →
                      ε ≤ ε0 →
                        H.ρ ε ≤ ρ0 →
                          Set.MapsTo (SparseSGD.Logistic.V2.driftMap H.b H.e ε) N N ∧
                            ∃ yε ∈ N,
                              SparseSGD.Logistic.V2.driftMap H.b H.e ε yε = yε ∧
                                (∀ z ∈ N, SparseSGD.Logistic.V2.driftMap H.b H.e ε z = z → z = yε) ∧
                                  ‖yε - H.ystar‖ ≤ C * H.ρ ε ∧
                                    ∀ y ∈ N,
                                      ∀ (k : ℕ),
                                        ‖(SparseSGD.Logistic.V2.driftMap H.b H.e ε)^[k] y - yε‖ ≤
                                          C * (1 - κ * ε) ^ k * ‖y - yε‖
SparseSGD.Logistic.V2.logdet_hessian_sos (R V C d2 d3 d4 : ℝ) (hR : R ≠ 0) :
  (d2 * V + R * d3 - 2 * C * d4) ^ 2 - 2 * (d2 * d3 - d4 ^ 2) * (R * V - C ^ 2) =
    (R * V - C ^ 2) ^ 2 * d2 ^ 2 / R ^ 2 + (R * d3 - 2 * C * d4 + C ^ 2 * d2 / R) ^ 2 +
      2 * (R * V - C ^ 2) * (d4 - C * d2 / R) ^ 2
SparseSGD.Logistic.V2.lyapunov (r delta Phi : ℝ) (y : SparseSGD.Logistic.DynamicState) : ℝ
SparseSGD.Logistic.V2.lyapunov_lower_bound (r delta Phi : ℝ) (y : SparseSGD.Logistic.DynamicState)
  (hy : SparseSGD.Logistic.dynamicPhysical y) (hQ : 0 < SparseSGD.Logistic.dynamicDeterminant y) (hdelta : 0 < delta)
  (hPhi : 0 ≤ Phi) :
  (1 + y 0 ^ 2 / 4 + y 2 / 4 - 3 * r ^ 2 / 2) / delta + y 1 ^ 2 / 2 + y 3 / 4 -
      Phi / delta / 2 * (Real.log (2 * Phi) + Real.log (2 * (Phi / delta)) - 2) ≤
    SparseSGD.Logistic.V2.lyapunov r delta Phi y
SparseSGD.Logistic.V2.lyapunov_matrix_equation (a theta R delta b : ℝ) (hd : delta ≠ 0) (hR : R ≠ 0) (hb : b ≠ 0)
  (hab : a * R = delta * b) :
  (SparseSGD.Logistic.V2.jacobianMatrix a theta R delta).transpose *
        SparseSGD.Logistic.V2.hessianMatrix a theta R delta b +
      SparseSGD.Logistic.V2.hessianMatrix a theta R delta b * SparseSGD.Logistic.V2.jacobianMatrix a theta R delta =
    -SparseSGD.Logistic.V2.dissipationMatrix R b
SparseSGD.Logistic.V2.lyapunov_sublevel_bounds (r delta Phi E : ℝ) (y : SparseSGD.Logistic.DynamicState)
  (hy : SparseSGD.Logistic.dynamicPhysical y) (hQ : 0 < SparseSGD.Logistic.dynamicDeterminant y) (hdelta : 0 < delta)
  (hPhi : 0 ≤ Phi) (hE : SparseSGD.Logistic.V2.lyapunov r delta Phi y ≤ E) :
  ‖y‖ ≤ SparseSGD.Logistic.V2.lyapunovBound r delta Phi E ∧
    (0 < Phi →
      Real.exp (-2 * delta * (E + 3 * r ^ 2 / (2 * delta)) / Phi) ≤ SparseSGD.Logistic.dynamicDeterminant y ∧
        Real.exp (-2 * delta * (E + 3 * r ^ 2 / (2 * delta)) / Phi) /
            SparseSGD.Logistic.V2.lyapunovBound r delta Phi E ≤
          y 3)
SparseSGD.Logistic.V2.observability (a theta R delta : ℝ) (ha : 0 < a) (hq : 2 + 2 * theta ^ 2 + R ≠ 0) (x : Fin 5 → ℝ)
  (h1 : x 1 = 0) (h3 : x 3 = 0) (h4 : x 4 = 0)
  (hY : (SparseSGD.Logistic.V2.jacobianMatrix a theta R delta).mulVec x 1 = 0)
  (hC : (SparseSGD.Logistic.V2.jacobianMatrix a theta R delta).mulVec x 4 = 0) : x = 0
SparseSGD.Logistic.V2.omega_charpoly (a theta R : ℝ) (z : ℂ) :
  (z • 1 - (SparseSGD.Logistic.V2.fastOmega a theta R).map Complex.ofReal).det =
    z * (z ^ 4 + ↑a * (5 + ↑theta ^ 2 + ↑R) * z ^ 2 + ↑a ^ 2 * (4 + 4 * ↑theta ^ 2 + ↑R))
SparseSGD.Logistic.V2.omega_null_left (a theta R : ℝ) :
  (SparseSGD.Logistic.V2.fastOmega a theta R).transpose.mulVec (SparseSGD.Logistic.V2.nullLeft a) = 0
SparseSGD.Logistic.V2.omega_null_right (a theta R : ℝ) :
  (SparseSGD.Logistic.V2.fastOmega a theta R).mulVec (SparseSGD.Logistic.V2.nullRight a theta R) = 0
SparseSGD.Logistic.V2.omega_oscillatory_eigenvector (a theta R nu : ℝ) (ha : a ≠ 0) (hθ : theta ≠ 0) (hR : R ≠ 0)
  (hq : SparseSGD.Logistic.V2.freqQuartic a theta R (nu ^ 2) = 0) :
  ((SparseSGD.Logistic.V2.fastOmega a theta R).map Complex.ofReal).mulVec (SparseSGD.Logistic.V2.oscVec a theta nu) =
    (Complex.I * ↑nu) • SparseSGD.Logistic.V2.oscVec a theta nu
SparseSGD.Logistic.V2.omega_skew (a theta R : ℝ) (ha : a ≠ 0) (hR : R ≠ 0) :
  (SparseSGD.Logistic.V2.fastOmega a theta R).transpose * SparseSGD.Logistic.V2.fastHessian a theta R +
      SparseSGD.Logistic.V2.fastHessian a theta R * SparseSGD.Logistic.V2.fastOmega a theta R =
    0
SparseSGD.Logistic.V2.oscillatory_eigenvalue_asymptotics (a θ R ν : ℝ) (ha : 0 < a) (hθ : θ ≠ 0) (hR : 0 < R)
  (hq : SparseSGD.Logistic.V2.freqQuartic a θ R (ν ^ 2) = 0) :
  ∃ Δ0 K,
    0 < Δ0 ∧
      0 ≤ K ∧
        ∀ (Δ : ℝ),
          Δ0 ≤ Δ →
            (∃ z,
                (z • 1 - (SparseSGD.Logistic.V2.jacobianMatrix a θ R Δ).map Complex.ofReal).det = 0 ∧
                  ‖z - (Complex.I * ↑ν * ↑√Δ + ↑(SparseSGD.Logistic.V2.raylMu a θ R ν))‖ ≤ K / √Δ) ∧
              ∃ z,
                (z • 1 - (SparseSGD.Logistic.V2.jacobianMatrix a θ R Δ).map Complex.ofReal).det = 0 ∧
                  ‖z - (-(Complex.I * ↑ν * ↑√Δ) + ↑(SparseSGD.Logistic.V2.raylMu a θ R ν))‖ ≤ K / √Δ
SparseSGD.Logistic.V2.palindromic_factor.{u_1} {R : Type u_1} [CommRing R] (b c m1 m2 z : R) (hs : m1 + m2 = -b)
  (hp : m1 * m2 = c - 2) : z ^ 4 + b * z ^ 3 + c * z ^ 2 + b * z + 1 = (z ^ 2 - m1 * z + 1) * (z ^ 2 - m2 * z + 1)
SparseSGD.Logistic.V2.positiveRoot_continuousOn :
  ContinuousOn (fun p => SparseSGD.Logistic.positiveRoot p.1 p.2) {p | 0 < p.1 ∧ 0 ≤ p.2}
SparseSGD.Logistic.V2.potential_hessian_det (alpha theta : ℝ) :
  alpha * (1 + theta ^ 2) * (alpha / 4) - (alpha * theta / 2) ^ 2 = alpha ^ 2 / 4
SparseSGD.Logistic.V2.prop_S (r delta Phi : ℝ) (hr : 0 < r) (hdelta : 0 < delta) (hPhi : 0 ≤ Phi) :
  ((∀ (y0 : SparseSGD.Logistic.DynamicState),
        SparseSGD.Logistic.dynamicPhysical y0 →
          ∃ y,
            y 0 = y0 ∧
              (∀ (t : ℝ), 0 ≤ t → HasDerivAt y (SparseSGD.Logistic.dynamicField r delta Phi (y t)) t) ∧
                (∀ (t : ℝ), 0 ≤ t → SparseSGD.Logistic.dynamicPhysical (y t)) ∧
                  Filter.Tendsto y Filter.atTop (nhds (SparseSGD.Logistic.dynamicCanonicalEquilibrium r delta Phi))) ∧
      ∀ (y : ℝ → SparseSGD.Logistic.DynamicState),
        (∀ (t : ℝ), 0 ≤ t → HasDerivAt y (SparseSGD.Logistic.dynamicField r delta Phi (y t)) t) →
          SparseSGD.Logistic.dynamicPhysical (y 0) →
            (∀ (t : ℝ), 0 ≤ t → SparseSGD.Logistic.dynamicPhysical (y t)) ∧
              (∃ M, ∀ (t : ℝ), 0 ≤ t → ‖y t‖ ≤ M) ∧
                Filter.Tendsto y Filter.atTop (nhds (SparseSGD.Logistic.dynamicCanonicalEquilibrium r delta Phi))) ∧
    (HasFDerivAt (SparseSGD.Logistic.dynamicField r delta Phi)
          (LinearMap.toContinuousLinearMap
            (Matrix.toLin'
              (SparseSGD.Logistic.V2.jacobianMatrix
                (SparseSGD.Logistic.dynamicAlpha r (SparseSGD.Logistic.dynamicCanonicalEquilibrium r delta Phi))
                (SparseSGD.Logistic.positiveRoot r Phi) (SparseSGD.Logistic.equilibriumBulk r Phi) delta)))
          (SparseSGD.Logistic.dynamicCanonicalEquilibrium r delta Phi) ∧
        ∀ (z : ℂ),
          (z • 1 -
                  (SparseSGD.Logistic.V2.jacobianMatrix
                        (SparseSGD.Logistic.dynamicAlpha r (SparseSGD.Logistic.dynamicCanonicalEquilibrium r delta Phi))
                        (SparseSGD.Logistic.positiveRoot r Phi) (SparseSGD.Logistic.equilibriumBulk r Phi) delta).map
                    Complex.ofReal).det =
              0 →
            z.re < 0) ∧
      ∀ (K : Set SparseSGD.Logistic.DynamicState),
        IsCompact K →
          (∀ z ∈ K, SparseSGD.Logistic.dynamicPhysical z) →
            ∀ (Pset : Set (ℝ × ℝ × ℝ)),
              IsCompact Pset →
                (∀ q ∈ Pset, 0 < q.1 ∧ 0 ≤ q.2.1 ∧ 0 < q.2.2) →
                  ∃ C c,
                    0 < C ∧
                      0 < c ∧
                        ∀ q ∈ Pset,
                          ∀ y0 ∈ K,
                            ∀ (y : ℝ → SparseSGD.Logistic.DynamicState),
                              y 0 = y0 →
                                (∀ (t : ℝ),
                                    0 ≤ t → HasDerivAt y (SparseSGD.Logistic.dynamicField q.2.2 q.1 q.2.1 (y t)) t) →
                                  ∀ (t : ℝ),
                                    0 ≤ t →
                                      ‖y t - SparseSGD.Logistic.dynamicCanonicalEquilibrium q.2.2 q.1 q.2.1‖ ≤
                                        C * Real.exp (-c * t) *
                                          ‖y0 - SparseSGD.Logistic.dynamicCanonicalEquilibrium q.2.2 q.1 q.2.1‖
SparseSGD.Logistic.V2.prop_S_i (r delta Phi : ℝ) (hr : 0 < r) (hdelta : 0 < delta) (hPhi : 0 ≤ Phi) :
  (∀ (y0 : SparseSGD.Logistic.DynamicState),
      SparseSGD.Logistic.dynamicPhysical y0 →
        ∃ y,
          y 0 = y0 ∧
            (∀ (t : ℝ), 0 ≤ t → HasDerivAt y (SparseSGD.Logistic.dynamicField r delta Phi (y t)) t) ∧
              (∀ (t : ℝ), 0 ≤ t → SparseSGD.Logistic.dynamicPhysical (y t)) ∧
                Filter.Tendsto y Filter.atTop (nhds (SparseSGD.Logistic.dynamicCanonicalEquilibrium r delta Phi))) ∧
    ∀ (y : ℝ → SparseSGD.Logistic.DynamicState),
      (∀ (t : ℝ), 0 ≤ t → HasDerivAt y (SparseSGD.Logistic.dynamicField r delta Phi (y t)) t) →
        SparseSGD.Logistic.dynamicPhysical (y 0) →
          (∀ (t : ℝ), 0 ≤ t → SparseSGD.Logistic.dynamicPhysical (y t)) ∧
            (∃ M, ∀ (t : ℝ), 0 ≤ t → ‖y t‖ ≤ M) ∧
              Filter.Tendsto y Filter.atTop (nhds (SparseSGD.Logistic.dynamicCanonicalEquilibrium r delta Phi))
SparseSGD.Logistic.V2.prop_S_ii (r delta Phi : ℝ) (hr : 0 < r) (hdelta : 0 < delta) (hPhi : 0 ≤ Phi) :
  HasFDerivAt (SparseSGD.Logistic.dynamicField r delta Phi)
      (LinearMap.toContinuousLinearMap
        (Matrix.toLin'
          (SparseSGD.Logistic.V2.jacobianMatrix
            (SparseSGD.Logistic.dynamicAlpha r (SparseSGD.Logistic.dynamicCanonicalEquilibrium r delta Phi))
            (SparseSGD.Logistic.positiveRoot r Phi) (SparseSGD.Logistic.equilibriumBulk r Phi) delta)))
      (SparseSGD.Logistic.dynamicCanonicalEquilibrium r delta Phi) ∧
    ∀ (z : ℂ),
      (z • 1 -
              (SparseSGD.Logistic.V2.jacobianMatrix
                    (SparseSGD.Logistic.dynamicAlpha r (SparseSGD.Logistic.dynamicCanonicalEquilibrium r delta Phi))
                    (SparseSGD.Logistic.positiveRoot r Phi) (SparseSGD.Logistic.equilibriumBulk r Phi) delta).map
                Complex.ofReal).det =
          0 →
        z.re < 0
SparseSGD.Logistic.V2.prop_S_iii (K : Set SparseSGD.Logistic.DynamicState) (hK : IsCompact K)
  (hKphys : ∀ z ∈ K, SparseSGD.Logistic.dynamicPhysical z) (Pset : Set (ℝ × ℝ × ℝ)) (hPc : IsCompact Pset)
  (hP : ∀ q ∈ Pset, 0 < q.1 ∧ 0 ≤ q.2.1 ∧ 0 < q.2.2) :
  ∃ C c,
    0 < C ∧
      0 < c ∧
        ∀ q ∈ Pset,
          ∀ y0 ∈ K,
            ∀ (y : ℝ → SparseSGD.Logistic.DynamicState),
              y 0 = y0 →
                (∀ (t : ℝ), 0 ≤ t → HasDerivAt y (SparseSGD.Logistic.dynamicField q.2.2 q.1 q.2.1 (y t)) t) →
                  ∀ (t : ℝ),
                    0 ≤ t →
                      ‖y t - SparseSGD.Logistic.dynamicCanonicalEquilibrium q.2.2 q.1 q.2.1‖ ≤ C * Real.exp (-c * t)
SparseSGD.Logistic.V2.prop_S_iii_proportional (K : Set SparseSGD.Logistic.DynamicState) (hK : IsCompact K)
  (hKphys : ∀ z ∈ K, SparseSGD.Logistic.dynamicPhysical z) (Pset : Set (ℝ × ℝ × ℝ)) (hPc : IsCompact Pset)
  (hP : ∀ q ∈ Pset, 0 < q.1 ∧ 0 ≤ q.2.1 ∧ 0 < q.2.2) :
  ∃ C c,
    0 < C ∧
      0 < c ∧
        ∀ q ∈ Pset,
          ∀ y0 ∈ K,
            ∀ (y : ℝ → SparseSGD.Logistic.DynamicState),
              y 0 = y0 →
                (∀ (t : ℝ), 0 ≤ t → HasDerivAt y (SparseSGD.Logistic.dynamicField q.2.2 q.1 q.2.1 (y t)) t) →
                  ∀ (t : ℝ),
                    0 ≤ t →
                      ‖y t - SparseSGD.Logistic.dynamicCanonicalEquilibrium q.2.2 q.1 q.2.1‖ ≤
                        C * Real.exp (-c * t) * ‖y0 - SparseSGD.Logistic.dynamicCanonicalEquilibrium q.2.2 q.1 q.2.1‖
SparseSGD.Logistic.V2.prop_W1_jacobian (r delta Phi : ℝ) :
  HasFDerivAt (SparseSGD.Logistic.dynamicField r delta Phi)
    (LinearMap.toContinuousLinearMap
      (Matrix.toLin'
        (SparseSGD.Logistic.V2.jacobianMatrix (SparseSGD.Logistic.V2.eqAlpha r Phi)
          (SparseSGD.Logistic.positiveRoot r Phi) (SparseSGD.Logistic.equilibriumBulk r Phi) delta)))
    (SparseSGD.Logistic.dynamicCanonicalEquilibrium r delta Phi)
SparseSGD.Logistic.V2.prop_W2_ii (theta R w : ℝ) (hR : 0 < R) (hw0 : 0 < w)
  (hwc : w < SparseSGD.Logistic.V2.windowCritical theta R) :
  (∀ (z : ℂ), (z • 1 - (SparseSGD.Logistic.V2.windowJacobian theta R w).map Complex.ofReal).det = 0 → ‖z‖ = 1) ∧
    ∃ z1 z2,
      ‖z1‖ = 1 ∧
        ‖z2‖ = 1 ∧
          0 < z1.im ∧
            0 < z2.im ∧
              (∀ (z : ℂ),
                  (z • 1 - (SparseSGD.Logistic.V2.windowJacobian theta R w).map Complex.ofReal).det =
                    (z - 1) * (z - z1) * (z - (starRingEnd ℂ) z1) * (z - z2) * (z - (starRingEnd ℂ) z2)) ∧
                [1, z1, (starRingEnd ℂ) z1, z2, (starRingEnd ℂ) z2].Nodup
SparseSGD.Logistic.V2.prop_W2_iii_above (theta R : ℝ) (hR : 0 < R) :
  ∃ eta > 0,
    ∀ (w : ℝ),
      SparseSGD.Logistic.V2.windowCritical theta R < w →
        w < SparseSGD.Logistic.V2.windowCritical theta R + eta →
          ∃ z < -1,
            (z • 1 - SparseSGD.Logistic.V2.windowJacobian theta R w).det = 0 ∧
              (∃ v, v ≠ 0 ∧ (SparseSGD.Logistic.V2.windowJacobian theta R w).mulVec v = z • v) ∧
                ∀ δ > 0,
                  ∃ x1 x2,
                    |x1 - z| < δ ∧
                      |x2 - z| < δ ∧
                        (x1 • 1 - SparseSGD.Logistic.V2.windowJacobian theta R w).det *
                            (x2 • 1 - SparseSGD.Logistic.V2.windowJacobian theta R w).det <
                          0
SparseSGD.Logistic.V2.prop_W2_iii_above_interval (θ R : ℝ) (hR : 0 < R) (w : ℝ) :
  SparseSGD.Logistic.V2.windowCritical θ R < w →
    w < 2 →
      ∃ z < -1,
        (z • 1 - SparseSGD.Logistic.V2.windowJacobian θ R w).det = 0 ∧
          (∃ v, v ≠ 0 ∧ (SparseSGD.Logistic.V2.windowJacobian θ R w).mulVec v = z • v) ∧
            ∀ δ > 0,
              ∃ x1 x2,
                |x1 - z| < δ ∧
                  |x2 - z| < δ ∧
                    (x1 • 1 - SparseSGD.Logistic.V2.windowJacobian θ R w).det *
                        (x2 • 1 - SparseSGD.Logistic.V2.windowJacobian θ R w).det <
                      0
SparseSGD.Logistic.V2.prop_W2_iii_critical (theta R : ℝ) (hR : 0 < R) :
  (SparseSGD.Logistic.V2.windowJacobian theta R (SparseSGD.Logistic.V2.windowCritical theta R) + 1).det = 0 ∧
    ∃ v,
      v ≠ 0 ∧
        (SparseSGD.Logistic.V2.windowJacobian theta R (SparseSGD.Logistic.V2.windowCritical theta R)).mulVec v = -1 • v
SparseSGD.Logistic.V2.prop_W2_iii_drift (r h θ R : ℝ) (hh : h ≠ 0) (hR : 0 < R)
  (hw1 : SparseSGD.Logistic.V2.windowCritical θ R < h * Real.exp ((θ ^ 2 + R - r ^ 2) / 2))
  (hw2 : h * Real.exp ((θ ^ 2 + R - r ^ 2) / 2) < 2) (l : Filter ℝ) [l.NeBot] (hl : l ≤ nhds 0) (Phi : ℝ → ℝ)
  (x : ℝ → SparseSGD.Logistic.DynamicState)
  (hfix : ∀ᶠ (eps : ℝ) in l, SparseSGD.Logistic.V2.windowDriftMap r h eps (Phi eps) (x eps) = x eps)
  (h0 : Filter.Tendsto (fun eps => x eps 0) l (nhds θ)) (h2 : Filter.Tendsto (fun eps => x eps 2) l (nhds R)) :
  ∀ᶠ (eps : ℝ) in l,
    HasFDerivAt (SparseSGD.Logistic.V2.windowDriftMap r h eps (Phi eps))
        (LinearMap.toContinuousLinearMap (Matrix.toLin' (SparseSGD.Logistic.V2.windowDriftJacobian r h eps (x eps))))
        (x eps) ∧
      ∃ z, (z • 1 - (SparseSGD.Logistic.V2.windowDriftJacobian r h eps (x eps)).map Complex.ofReal).det = 0 ∧ 1 < ‖z‖
SparseSGD.Logistic.V2.quadratic_unit_roots (m : ℝ) (hm : |m| < 2) (z : ℂ) (hz : z ^ 2 - ↑m * z + 1 = 0) :
  z.im ≠ 0 ∧ ‖z‖ = 1
SparseSGD.Logistic.V2.rayleigh_generic (Ω D H S : Matrix (Fin 5) (Fin 5) ℝ) (hΩ : Ω.transpose * H + H * Ω = 0)
  (hD : D.transpose * H + H * D = -S) (hH : H.transpose = H) (ν : ℝ) (v : Fin 5 → ℂ)
  (hv : (Ω.map Complex.ofReal).mulVec v = (Complex.I * ↑ν) • v) (hne : (SparseSGD.Logistic.V2.cquad H v).re ≠ 0) :
  (Ω.map Complex.ofReal).transpose.mulVec (SparseSGD.Logistic.V2.leftVec H v) =
      (Complex.I * ↑ν) • SparseSGD.Logistic.V2.leftVec H v ∧
    SparseSGD.Logistic.V2.leftVec H v ⬝ᵥ v = SparseSGD.Logistic.V2.cquad H v ∧
      (SparseSGD.Logistic.V2.leftVec H v ⬝ᵥ (D.map Complex.ofReal).mulVec v /
            SparseSGD.Logistic.V2.leftVec H v ⬝ᵥ v).re =
        -(SparseSGD.Logistic.V2.cquad S v).re / (2 * (SparseSGD.Logistic.V2.cquad H v).re)
SparseSGD.Logistic.V2.rayleigh_shift (a theta R nu : ℝ) (ha : 0 < a) (hθ : theta ≠ 0) (hR : 0 < R)
  (hq : SparseSGD.Logistic.V2.freqQuartic a theta R (nu ^ 2) = 0) :
  ((SparseSGD.Logistic.V2.fastOmega a theta R).map Complex.ofReal).transpose.mulVec
        (SparseSGD.Logistic.V2.leftVec (SparseSGD.Logistic.V2.fastHessian a theta R)
          (SparseSGD.Logistic.V2.oscVec a theta nu)) =
      (Complex.I * ↑nu) •
        SparseSGD.Logistic.V2.leftVec (SparseSGD.Logistic.V2.fastHessian a theta R)
          (SparseSGD.Logistic.V2.oscVec a theta nu) ∧
    (SparseSGD.Logistic.V2.leftVec (SparseSGD.Logistic.V2.fastHessian a theta R)
              (SparseSGD.Logistic.V2.oscVec a theta nu) ⬝ᵥ
            (SparseSGD.Logistic.V2.fastDamping.map Complex.ofReal).mulVec (SparseSGD.Logistic.V2.oscVec a theta nu) /
          SparseSGD.Logistic.V2.leftVec (SparseSGD.Logistic.V2.fastHessian a theta R)
              (SparseSGD.Logistic.V2.oscVec a theta nu) ⬝ᵥ
            SparseSGD.Logistic.V2.oscVec a theta nu).re =
      -SparseSGD.Logistic.V2.raylN a R nu (SparseSGD.Logistic.V2.oscS a theta nu) /
        (2 * SparseSGD.Logistic.V2.raylD a theta R nu (SparseSGD.Logistic.V2.oscS a theta nu))
SparseSGD.Logistic.V2.rayleigh_shift_neg (a theta R nu : ℝ) (ha : 0 < a) (hR : 0 < R) :
  -SparseSGD.Logistic.V2.raylN a R nu (SparseSGD.Logistic.V2.oscS a theta nu) /
      (2 * SparseSGD.Logistic.V2.raylD a theta R nu (SparseSGD.Logistic.V2.oscS a theta nu)) <
    0
SparseSGD.Logistic.V2.real_eigenvalue_asymptotics (a θ R : ℝ) (ha : a ≠ 0) (hR : 0 ≤ R) :
  ∃ Δ0 K,
    0 < Δ0 ∧
      0 ≤ K ∧
        ∀ (Δ : ℝ),
          Δ0 ≤ Δ →
            ∃ l,
              (l • 1 - SparseSGD.Logistic.V2.jacobianMatrix a θ R Δ).det = 0 ∧
                |l + (2 + 2 * (R / (2 * (1 + θ ^ 2)))) / (2 + R / (2 * (1 + θ ^ 2)))| ≤ K / √Δ
SparseSGD.Logistic.V2.real_eigenvalue_asymptotics_sharp (a θ R : ℝ) (ha : a ≠ 0) (hR : 0 ≤ R) :
  ∃ Δ0 K,
    0 < Δ0 ∧
      0 ≤ K ∧
        ∀ (Δ : ℝ),
          Δ0 ≤ Δ →
            ∃ l,
              (l • 1 - SparseSGD.Logistic.V2.jacobianMatrix a θ R Δ).det = 0 ∧
                |l - SparseSGD.Logistic.V2.lambdaZero θ R| ≤ K / Δ
SparseSGD.Logistic.V2.real_eigenvalue_persistence {l : Filter ℝ} (J : ℝ → Matrix (Fin 5) (Fin 5) ℝ)
  (J0 : Matrix (Fin 5) (Fin 5) ℝ) (hJ : ∀ (i j : Fin 5), Filter.Tendsto (fun ε => J ε i j) l (nhds (J0 i j))) (z0 : ℝ)
  (hz0 : z0 < -1)
  (hsign : ∀ δ > 0, ∃ x1 x2, |x1 - z0| < δ ∧ |x2 - z0| < δ ∧ (x1 • 1 - J0).det * (x2 • 1 - J0).det < 0) :
  ∀ᶠ (ε : ℝ) in l, ∃ z < -1, (z • 1 - J ε).det = 0 ∧ ∃ z', (z' • 1 - (J ε).map Complex.ofReal).det = 0 ∧ 1 < ‖z'‖
SparseSGD.Logistic.V2.slow_residuals_tendsto_zero (r delta Phi : ℝ) (y : ℝ → SparseSGD.Logistic.DynamicState)
  (hdelta : 0 < delta) (hPhi : 0 ≤ Phi)
  (hy : ∀ (t : ℝ), 0 ≤ t → HasDerivAt y (SparseSGD.Logistic.dynamicField r delta Phi (y t)) t)
  (hy0 : SparseSGD.Logistic.dynamicPhysical (y 0)) :
  Filter.Tendsto (fun t => SparseSGD.Logistic.dynamicAlpha r (y t) * y t 0 - r) Filter.atTop (nhds 0) ∧
    Filter.Tendsto (fun t => SparseSGD.Logistic.dynamicAlpha r (y t) * y t 2 - Phi) Filter.atTop (nhds 0)
SparseSGD.Logistic.V2.solution_bounded (r delta Phi : ℝ) (y : ℝ → SparseSGD.Logistic.DynamicState) (hdelta : 0 < delta)
  (hPhi : 0 ≤ Phi) (hy : ∀ (t : ℝ), 0 ≤ t → HasDerivAt y (SparseSGD.Logistic.dynamicField r delta Phi (y t)) t)
  (hy0 : SparseSGD.Logistic.dynamicPhysical (y 0)) :
  ∃ M q,
    (∀ (t : ℝ), 0 ≤ t → ‖y t‖ ≤ M) ∧
      (0 < Phi → 0 < q ∧ ∀ (t : ℝ), 1 ≤ t → q ≤ SparseSGD.Logistic.dynamicDeterminant (y t))
SparseSGD.Logistic.V2.solution_tendsto_equilibrium (r delta Phi : ℝ) (y : ℝ → SparseSGD.Logistic.DynamicState)
  (hr : 0 < r) (hdelta : 0 < delta) (hPhi : 0 ≤ Phi)
  (hy : ∀ (t : ℝ), 0 ≤ t → HasDerivAt y (SparseSGD.Logistic.dynamicField r delta Phi (y t)) t)
  (hy0 : SparseSGD.Logistic.dynamicPhysical (y 0)) :
  Filter.Tendsto y Filter.atTop (nhds (SparseSGD.Logistic.dynamicCanonicalEquilibrium r delta Phi))
SparseSGD.Logistic.V2.strictConvexOn_lyapunov (r δ Φ : ℝ) (hδ : 0 < δ) (hΦ : 0 < Φ) :
  StrictConvexOn ℝ SparseSGD.Logistic.V2.lyapunovDomain (SparseSGD.Logistic.V2.lyapunov r δ Φ)
SparseSGD.Logistic.V2.tameDriftMap_decomposition (r deltaS PhiS : ℝ) (hd : 0 < deltaS) (hP : 0 ≤ PhiS) (M : ℝ) :
  ∃ K,
    0 ≤ K ∧
      ∀ (p : SparseSGD.Logistic.V2.TP),
        SparseSGD.Logistic.V2.TP.Adm deltaS PhiS p →
          (∀ (y : SparseSGD.Logistic.DynamicState),
              SparseSGD.Logistic.V2.TP.map r p y =
                y +
                  p.h •
                    (SparseSGD.Logistic.dynamicField r deltaS PhiS y +
                      SparseSGD.Logistic.V2.TP.err r deltaS PhiS p y)) ∧
            ∀ (y z : SparseSGD.Logistic.DynamicState),
              ‖y‖ ≤ M →
                ‖z‖ ≤ M →
                  ‖SparseSGD.Logistic.V2.TP.err r deltaS PhiS p y‖ ≤ K * SparseSGD.Logistic.V2.TP.varrho deltaS PhiS p ∧
                    (DifferentiableAt ℝ (SparseSGD.Logistic.V2.TP.err r deltaS PhiS p) y ∧
                        ‖fderiv ℝ (SparseSGD.Logistic.V2.TP.err r deltaS PhiS p) y‖ ≤
                          K * SparseSGD.Logistic.V2.TP.varrho deltaS PhiS p) ∧
                      ‖SparseSGD.Logistic.V2.TP.err r deltaS PhiS p y -
                            SparseSGD.Logistic.V2.TP.err r deltaS PhiS p z‖ ≤
                        K * SparseSGD.Logistic.V2.TP.varrho deltaS PhiS p * ‖y - z‖
SparseSGD.Logistic.V2.tameDriftMap_tracking (r deltaS PhiS : ℝ) (hd : 0 < deltaS) (hP : 0 ≤ PhiS)
  (ystar : SparseSGD.Logistic.DynamicState) (K : Set SparseSGD.Logistic.DynamicState) (hK : IsCompact K)
  (hKphys : ∀ y ∈ K, SparseSGD.Logistic.dynamicPhysical y)
  (hentry : SparseSGD.Logistic.V2.UniformEntry (SparseSGD.Logistic.dynamicField r deltaS PhiS) ystar K) (T : ℝ)
  (hT : 0 ≤ T) :
  ∃ CT vT C1,
    0 < CT ∧
      0 < vT ∧
        0 ≤ C1 ∧
          ∀ (p : SparseSGD.Logistic.V2.TP),
            SparseSGD.Logistic.V2.TP.Adm deltaS PhiS p →
              0 ≤ p.h →
                SparseSGD.Logistic.V2.TP.varrho deltaS PhiS p ≤ vT →
                  ∀ y0 ∈ K,
                    ∀ (y : ℝ → SparseSGD.Logistic.DynamicState),
                      SparseSGD.Logistic.V2.IsODESol (SparseSGD.Logistic.dynamicField r deltaS PhiS) y0 y →
                        (∀ (k : ℕ),
                            ↑k * p.h ≤ T →
                              ‖(SparseSGD.Logistic.V2.TP.map r p)^[k] y0 - y (↑k * p.h)‖ ≤
                                CT * SparseSGD.Logistic.V2.TP.varrho deltaS PhiS p) ∧
                          ∀ (k : ℕ),
                            ‖y (↑(k + 1) * p.h) - SparseSGD.Logistic.V2.TP.map r p (y (↑k * p.h))‖ ≤
                              C1 * p.h * SparseSGD.Logistic.V2.TP.varrho deltaS PhiS p
SparseSGD.Logistic.V2.tame_base_certificate (r delta Phi : ℝ) (hr : 0 < r) (hdelta : 0 < delta) (hPhi : 0 ≤ Phi) :
  ∃ A P c,
    0 < c ∧
      P.transpose = P ∧
        (∀ (x : Fin 5 → ℝ), x ⬝ᵥ x ≤ x ⬝ᵥ P.mulVec x) ∧
          (∀ (x : Fin 5 → ℝ), x ⬝ᵥ (A.transpose * P + P * A).mulVec x ≤ -c * x ⬝ᵥ x) ∧
            HasStrictFDerivAt (SparseSGD.Logistic.dynamicField r delta Phi)
              (LinearMap.toContinuousLinearMap A.mulVecLin) (SparseSGD.Logistic.dynamicCanonicalEquilibrium r delta Phi)
SparseSGD.Logistic.V2.tendsto_of_compact_unique_cluster.{u_1} {E : Type u_1} [TopologicalSpace E] {z : ℝ → E}
  {zstar : E} {K : Set E} (hK : IsCompact K) (hzK : ∀ (t : ℝ), 0 ≤ t → z t ∈ K)
  (hcl : ∀ (w : E), MapClusterPt w Filter.atTop z → w = zstar) : Filter.Tendsto z Filter.atTop (nhds zstar)
SparseSGD.Logistic.V2.tendsto_zero_of_hasDerivAt_of_tendsto {F f : ℝ → ℝ} {l : ℝ}
  (hF : ∀ (t : ℝ), 0 ≤ t → HasDerivAt F (f t) t) (hlim : Filter.Tendsto F Filter.atTop (nhds l))
  (hf : UniformContinuousOn f (Set.Ici 0)) : Filter.Tendsto f Filter.atTop (nhds 0)
SparseSGD.Logistic.V2.trace_corollary (a θ R : ℝ) (ha : 0 < a) (hθ : θ ≠ 0) (hR : 0 < R) :
  ∃ Δ0 K,
    0 < Δ0 ∧
      0 ≤ K ∧
        ∀ (Δ : ℝ),
          Δ0 ≤ Δ →
            |SparseSGD.Logistic.V2.lambdaZero θ R +
                      2 * SparseSGD.Logistic.V2.raylMu a θ R √(SparseSGD.Logistic.V2.freqSq1 a θ R) +
                    2 * SparseSGD.Logistic.V2.raylMu a θ R √(SparseSGD.Logistic.V2.freqSq2 a θ R) +
                  4| ≤
              5 * K / √Δ
SparseSGD.Logistic.V2.trace_damping : SparseSGD.Logistic.V2.fastDamping.trace = -4
SparseSGD.Logistic.V2.trace_omega (a theta R : ℝ) : (SparseSGD.Logistic.V2.fastOmega a theta R).trace = 0
SparseSGD.Logistic.V2.two_lt_windowUpper (θ R : ℝ) (hR : 0 < R) : 2 < SparseSGD.Logistic.V2.windowUpper θ R
SparseSGD.Logistic.V2.v2_determinant_derivative (r delta Phi : ℝ) (y : ℝ → SparseSGD.Logistic.DynamicState) (t : ℝ)
  (hy : HasDerivAt y (SparseSGD.Logistic.dynamicField r delta Phi (y t)) t) :
  HasDerivAt (fun s => SparseSGD.Logistic.dynamicDeterminant (y s))
    (-2 * SparseSGD.Logistic.dynamicDeterminant (y t) + 2 * (Phi / delta) * y t 2) t
SparseSGD.Logistic.V2.w_c_limit (theta : ℝ) :
  Filter.Tendsto (fun R => SparseSGD.Logistic.V2.windowCritical theta R) (nhdsWithin 0 (Set.Ioi 0))
    (nhds (min 2 (4 / (1 + theta ^ 2))))
SparseSGD.Logistic.V2.windowCoefB_lt_four (theta R w : ℝ) (hR : 0 < R) (hw0 : 0 < w)
  (hwc : w < SparseSGD.Logistic.V2.windowCritical theta R) : SparseSGD.Logistic.V2.windowCoefB theta R w < 4
SparseSGD.Logistic.V2.windowCritical_lt_two (theta R : ℝ) (hR : 0 < R) :
  SparseSGD.Logistic.V2.windowCritical theta R < 2
SparseSGD.Logistic.V2.windowCritical_pos (theta R : ℝ) (hR : 0 < R) : 0 < SparseSGD.Logistic.V2.windowCritical theta R
SparseSGD.Logistic.V2.windowD_pos (theta R w : ℝ) (hR : 0 < R) (hw2 : w < 2) :
  0 < SparseSGD.Logistic.V2.windowD theta R w
SparseSGD.Logistic.V2.windowDriftJacobian_tendsto (r h : ℝ) {l : Filter ℝ} (hl : l ≤ nhds 0)
  (x : ℝ → SparseSGD.Logistic.DynamicState) (x0 : SparseSGD.Logistic.DynamicState) (hx : Filter.Tendsto x l (nhds x0))
  (i j : Fin 5) :
  Filter.Tendsto (fun eps => SparseSGD.Logistic.V2.windowDriftJacobian r h eps (x eps) i j) l
    (nhds (SparseSGD.Logistic.V2.windowDriftJacobian r h 0 x0 i j))
SparseSGD.Logistic.V2.windowDriftJacobian_zero_fixed (r h θ R a w : ℝ)
  (ha : SparseSGD.Logistic.dynamicAlpha r (SparseSGD.Logistic.V2.windowFixedPoint θ R w) = a) (hr : a * θ = r)
  (hw : w = h * a) :
  SparseSGD.Logistic.V2.windowDriftJacobian r h 0 (SparseSGD.Logistic.V2.windowFixedPoint θ R w) =
    SparseSGD.Logistic.V2.windowJacobian θ R w
SparseSGD.Logistic.V2.windowDriftMap_conj (r h eps Phi : ℝ) (heps : eps ≠ 0) (y : SparseSGD.Logistic.DynamicState) :
  SparseSGD.Logistic.V2.windowDriftMap r h eps Phi (SparseSGD.Logistic.V2.windowScale (h / eps) y) =
    SparseSGD.Logistic.V2.windowScale (h / eps) (SparseSGD.Logistic.V2.tameDriftMap r eps (h / eps ^ 2) Phi 0 1 y)
SparseSGD.Logistic.V2.windowDriftMap_fixed (r h eps Phi : ℝ) (x : SparseSGD.Logistic.DynamicState) (hh : h ≠ 0)
  (heps : eps ≠ 2) (hfix : SparseSGD.Logistic.V2.windowDriftMap r h eps Phi x = x) :
  x 1 = 0 ∧
    SparseSGD.Logistic.dynamicAlpha r x * x 0 = r ∧
      x 4 = -(h * SparseSGD.Logistic.dynamicAlpha r x * x 2) / (2 - eps) ∧
        x 3 = 2 * h * SparseSGD.Logistic.dynamicAlpha r x * x 2 / (2 - eps)
SparseSGD.Logistic.V2.windowDriftMap_zero (r h Phi : ℝ) :
  SparseSGD.Logistic.V2.windowDriftMap r h 0 Phi = SparseSGD.Logistic.V2.windowMap r h
SparseSGD.Logistic.V2.windowDrift_fixedPoint_signal (r h theta R : ℝ) (l : Filter ℝ) [l.NeBot] (hl : l ≤ nhds 0)
  (Phi : ℝ → ℝ) (x : ℝ → SparseSGD.Logistic.DynamicState) (hh : h ≠ 0)
  (hfix : ∀ᶠ (eps : ℝ) in l, SparseSGD.Logistic.V2.windowDriftMap r h eps (Phi eps) (x eps) = x eps)
  (h0 : Filter.Tendsto (fun eps => x eps 0) l (nhds theta)) (h2 : Filter.Tendsto (fun eps => x eps 2) l (nhds R)) :
  Real.exp ((theta ^ 2 + R - r ^ 2) / 2) * theta = r
SparseSGD.Logistic.V2.windowDrift_fixedPoint_tendsto (r h theta R : ℝ) (l : Filter ℝ) (hl : l ≤ nhds 0) (Phi : ℝ → ℝ)
  (x : ℝ → SparseSGD.Logistic.DynamicState) (hh : h ≠ 0)
  (hfix : ∀ᶠ (eps : ℝ) in l, SparseSGD.Logistic.V2.windowDriftMap r h eps (Phi eps) (x eps) = x eps)
  (h0 : Filter.Tendsto (fun eps => x eps 0) l (nhds theta)) (h2 : Filter.Tendsto (fun eps => x eps 2) l (nhds R)) :
  Filter.Tendsto x l
    (nhds (SparseSGD.Logistic.V2.windowFixedPoint theta R (h * Real.exp ((theta ^ 2 + R - r ^ 2) / 2))))
SparseSGD.Logistic.V2.windowJacobian_det (theta R w : ℝ) : (SparseSGD.Logistic.V2.windowJacobian theta R w).det = 1
SparseSGD.Logistic.V2.windowJacobian_det_add_one (theta R w : ℝ) :
  (SparseSGD.Logistic.V2.windowJacobian theta R w + 1).det = -(w - 2) * SparseSGD.Logistic.V2.windowQ theta R w
SparseSGD.Logistic.V2.windowJacobian_det_sub_one (theta R w : ℝ) :
  (SparseSGD.Logistic.V2.windowJacobian theta R w - 1).det = 0
SparseSGD.Logistic.V2.windowMap_fixed (r h theta R a w : ℝ)
  (ha : SparseSGD.Logistic.dynamicAlpha r (SparseSGD.Logistic.V2.windowFixedPoint theta R w) = a) (hr : a * theta = r)
  (hw : w = h * a) :
  SparseSGD.Logistic.V2.windowMap r h (SparseSGD.Logistic.V2.windowFixedPoint theta R w) =
    SparseSGD.Logistic.V2.windowFixedPoint theta R w
SparseSGD.Logistic.V2.windowP_neg_two (theta R w : ℝ) :
  SparseSGD.Logistic.V2.windowP theta R w (-2) = (2 - w) * SparseSGD.Logistic.V2.windowQ theta R w / 2
SparseSGD.Logistic.V2.windowP_two (theta R w : ℝ) :
  SparseSGD.Logistic.V2.windowP theta R w 2 =
    w ^ 2 * (2 * (4 + 4 * theta ^ 2 + R) - SparseSGD.Logistic.V2.windowA theta R * w) / 2
SparseSGD.Logistic.V2.windowP_two_pos (theta R w : ℝ) (hR : 0 < R) (hw0 : 0 < w) (hw2 : w < 2) :
  0 < SparseSGD.Logistic.V2.windowP theta R w 2
SparseSGD.Logistic.V2.windowQ_critical (theta R : ℝ) (hR : 0 < R) :
  SparseSGD.Logistic.V2.windowQ theta R (SparseSGD.Logistic.V2.windowCritical theta R) = 0
SparseSGD.Logistic.V2.windowQ_neg_above (theta R : ℝ) (hR : 0 < R) :
  ∃ eta > 0,
    ∀ (w : ℝ),
      SparseSGD.Logistic.V2.windowCritical theta R < w →
        w < SparseSGD.Logistic.V2.windowCritical theta R + eta → SparseSGD.Logistic.V2.windowQ theta R w < 0
SparseSGD.Logistic.V2.windowQ_pos_of_lt (theta R w : ℝ) (hR : 0 < R)
  (hw : w < SparseSGD.Logistic.V2.windowCritical theta R) : 0 < SparseSGD.Logistic.V2.windowQ theta R w
SparseSGD.Logistic.V2.windowQ_two (theta R : ℝ) : SparseSGD.Logistic.V2.windowQ theta R 2 = -4 * R
SparseSGD.Logistic.V2.window_charpoly (theta R w : ℝ) (z : ℂ) :
  (z • 1 - (SparseSGD.Logistic.V2.windowJacobian theta R w).map Complex.ofReal).det =
    (z - 1) *
      (z ^ 4 + ↑(SparseSGD.Logistic.V2.windowCoefB theta R w) * z ^ 3 +
            ↑(SparseSGD.Logistic.V2.windowCoefC theta R w) * z ^ 2 +
          ↑(SparseSGD.Logistic.V2.windowCoefB theta R w) * z +
        1)
SparseSGD.Logistic.V2.window_discriminant (theta R w : ℝ) :
  SparseSGD.Logistic.V2.windowCoefB theta R w ^ 2 - 4 * (SparseSGD.Logistic.V2.windowCoefC theta R w - 2) =
    w ^ 2 * SparseSGD.Logistic.V2.windowD theta R w / 4
SparseSGD.Logistic.V2.window_roots_inside (theta R w : ℝ) (hR : 0 < R) (hw0 : 0 < w)
  (hwc : w < SparseSGD.Logistic.V2.windowCritical theta R) :
  ∃ m1 m2,
    m1 < m2 ∧
      -2 < m1 ∧
        m2 < 2 ∧
          m1 + m2 = -SparseSGD.Logistic.V2.windowCoefB theta R w ∧
            m1 * m2 = SparseSGD.Logistic.V2.windowCoefC theta R w - 2
SparseSGD.Logistic.actual_drift_fixedPoint_bulk {d B : ℕ} (H : SparseSGD.External.GaussianSteinCertificate d)
  (hB : 0 < B) (eta beta : ℝ) (p : ↑unitInterval) (mu : SparseSGD.Logistic.Vec d) (s : SparseSGD.Logistic.State d)
  (hr : 0 < SparseSGD.Logistic.r mu) (heta : eta ≠ 0) (hbeta : beta ≠ 1) (hb : 1 + beta ≠ 0) (hp0 : 0 < ↑p)
  (hp1 : ↑p < 1) (hu : (SparseSGD.Logistic.driftParams eta beta p mu s.1).totalLoad ≠ 1)
  (hbulk :
    (SparseSGD.Logistic.integratedGram (SparseSGD.Logistic.batchLaw d B p)
        (fun a => SparseSGD.Logistic.bulkPart mu (SparseSGD.Logistic.update eta beta p mu s a).1) fun a =>
        eta • SparseSGD.Logistic.bulkPart mu (SparseSGD.Logistic.update eta beta p mu s a).2) =
      SparseSGD.gramMoments (SparseSGD.Logistic.bulkPart mu s.1) (eta • SparseSGD.Logistic.bulkPart mu s.2)) :
  ‖SparseSGD.Logistic.bulkPart mu s.1‖ ^ 2 =
      SparseSGD.Logistic.frozenLogisticFloor d B eta (SparseSGD.Logistic.coefA p mu s.1)
        (SparseSGD.Logistic.coefDtheta p mu s.1) (SparseSGD.Logistic.coefD0 p mu s.1)
        (eta * (1 - beta) * SparseSGD.Logistic.coefA p mu s.1 / (2 * (1 + beta))) ∧
    eta * inner ℝ (SparseSGD.Logistic.bulkPart mu s.1) (SparseSGD.Logistic.bulkPart mu s.2) =
        -eta * (1 - beta) * SparseSGD.Logistic.coefA p mu s.1 * ‖SparseSGD.Logistic.bulkPart mu s.1‖ ^ 2 / (1 + beta) ∧
      eta ^ 2 * ‖SparseSGD.Logistic.bulkPart mu s.2‖ ^ 2 =
        2 * eta * (1 - beta) * SparseSGD.Logistic.coefA p mu s.1 * ‖SparseSGD.Logistic.bulkPart mu s.1‖ ^ 2 / (1 + beta)
SparseSGD.Logistic.actual_drift_fixedPoint_signal {d B : ℕ} (H : SparseSGD.External.GaussianSteinCertificate d)
  (hB : 0 < B) (eta beta : ℝ) (p : ↑unitInterval) (mu : SparseSGD.Logistic.Vec d) (s : SparseSGD.Logistic.State d)
  (hr : 0 < SparseSGD.Logistic.r mu) (heta : eta ≠ 0) (hbeta : beta ≠ 1)
  (hsignal :
    ∫ (a : SparseSGD.Logistic.Batch d B),
        SparseSGD.Logistic.signalCoord mu
          (SparseSGD.Logistic.update eta beta p mu s a).1 ∂SparseSGD.Logistic.batchLaw d B p =
      SparseSGD.Logistic.signalCoord mu s.1)
  (hmomentum :
    ∫ (a : SparseSGD.Logistic.Batch d B),
        SparseSGD.Logistic.signalCoord mu
          (SparseSGD.Logistic.update eta beta p mu s a).2 ∂SparseSGD.Logistic.batchLaw d B p =
      SparseSGD.Logistic.signalCoord mu s.2) :
  SparseSGD.Logistic.signalCoord mu s.2 = 0 ∧
    SparseSGD.Logistic.coefA p mu s.1 * SparseSGD.Logistic.signalCoord mu s.1 +
        SparseSGD.Logistic.coefB p mu s.1 * SparseSGD.Logistic.r mu =
      0
