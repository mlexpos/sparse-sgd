SparseSGD.Logistic.tameError_source_formula {d : ℕ} (p : ↑unitInterval) (mu theta : SparseSGD.Logistic.Vec d)
  (hr : 0 < SparseSGD.Logistic.r mu) :
  SparseSGD.Logistic.tameError p mu theta =
    ↑p *
      (Real.exp (2 * ‖theta‖ ^ 2 - SparseSGD.Logistic.r mu ^ 2) +
          Real.exp ((3 * ‖theta‖ ^ 2 - SparseSGD.Logistic.r mu ^ 2) / 2) +
        (1 + SparseSGD.Logistic.gaussianAlpha mu theta) *
          Real.exp (SparseSGD.Logistic.r mu * |SparseSGD.Logistic.signalCoord mu theta|))
