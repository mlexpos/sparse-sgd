SparseSGD.Logistic.V2.frequency_discriminant (a theta R : ℝ) :
  (a * (5 + theta ^ 2 + R)) ^ 2 - 4 * (a ^ 2 * (4 + 4 * theta ^ 2 + R)) = a ^ 2 * SparseSGD.Logistic.V2.freqDisc theta R
SparseSGD.Logistic.V2.frequency_quartic_R_zero (a theta x : ℝ) :
  SparseSGD.Logistic.V2.freqQuartic a theta 0 x = (x - a * (1 + theta ^ 2)) * (x - 4 * a)
