  (hd : 0 < delta) (hPhi : 0 < Phi)
  (hy : ∀ t ∈ Set.Icc 0 T, HasDerivAt y (SparseSGD.Logistic.dynamicField r delta Phi (y t)) t)
  (hy0 : SparseSGD.Logistic.dynamicPhysical (y 0)) (t : ℝ) :
  t ∈ Set.Ioc 0 T → 0 < SparseSGD.Logistic.dynamicDeterminant (y t)
