  (∀ μ ∈ SparseSGD.Scaling.Helps.cubicRoots b2 b1 b0,
      ∃ z ∈ SparseSGD.Scaling.Helps.cubicRoots a2 a1 a0, ‖μ - z‖ ≤ δ ^ (1 / 3)) ∧
