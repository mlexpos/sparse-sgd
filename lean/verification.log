SparseSGD.Scaling.Helps.kickSq_generating_function (jury : SparseSGD.External.JuryStability) (p : SparseSGD.Params)
  (hb0 : 0 ≤ p.beta) (hb1 : p.beta < 1) (hw : 0 < p.w) (hceil : p.w < 2 * (1 + p.beta)) (z : ℂ) (hz : 1 ≤ ‖z‖) :
