SparseSGD.Scaling.Helps.prop_helps_critical {n d : ℕ} {ν : MeasureTheory.Measure ℝ} {ps : Fin (n + 1) → ↑unitInterval}
  (hp : ∀ (j : Fin (n + 1)), 0 < ↑(ps j)) (hanti : Antitone ps) (hκ : 16 < SparseSGD.Scaling.Helps.kappaV ps) :
  (SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.sgdClass =
        1 / (2 * Real.log ((SparseSGD.Scaling.Helps.kappaV ps + 1) / (SparseSGD.Scaling.Helps.kappaV ps - 1))) ∧
      SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass =
          1 / (2 * Real.log ((√(SparseSGD.Scaling.Helps.kappaV ps) + 1) / (√(SparseSGD.Scaling.Helps.kappaV ps) - 1))) ∧
        SparseSGD.Scaling.Helps.kappaV ps / 4 * (1 - 1 / SparseSGD.Scaling.Helps.kappaV ps ^ 2) ≤
            SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.sgdClass ∧
          SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.sgdClass ≤ SparseSGD.Scaling.Helps.kappaV ps / 4 ∧
            √(SparseSGD.Scaling.Helps.kappaV ps) / 4 * (1 - 1 / SparseSGD.Scaling.Helps.kappaV ps) ≤
                SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass ∧
              SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass ≤
                √(SparseSGD.Scaling.Helps.kappaV ps) / 4) ∧
    (SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.sgdClass =
          SparseSGD.Scaling.Helps.Efun d 1 ν ps SparseSGD.Scaling.Helps.sgdClass ∧
        SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.sgdClass =
            1 / Real.log ((↑d + 2) / (↑d + 2 - ↑(ps (Fin.last n)))) ∧
          (↑d + 2 - ↑(ps (Fin.last n))) / ↑(ps (Fin.last n)) ≤
              SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.sgdClass ∧
            SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.sgdClass ≤ (↑d + 2) / ↑(ps (Fin.last n)) ∧
              max (1 - 4 / √(SparseSGD.Scaling.Helps.kappaV ps)) (1 / √5) * (↑d + 2 - ↑(ps (Fin.last n))) /
                    (8 * ↑(ps (Fin.last n))) ≤
                  SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.momClass ∧
                SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.momClass ≤
                  SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.sgdClass) ∧
      4 * (↑d + 2 - ↑(ps (Fin.last n))) / ↑(ps 0) ≤
          SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.sgdClass ∧
        SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.sgdClass ≤
            SparseSGD.Scaling.Helps.kappaV ps ^ 2 / (SparseSGD.Scaling.Helps.kappaV ps ^ 2 - 1) *
              (4 * (↑d + 2) / ↑(ps 0)) ∧
          max (1 - 4 / √(SparseSGD.Scaling.Helps.kappaV ps)) (1 / √5) * √(SparseSGD.Scaling.Helps.kappaV ps) / 8 *
                  (1 - 1 / SparseSGD.Scaling.Helps.kappaV ps ^ 2) *
                (1 - ↑(ps (Fin.last n)) / (↑d + 2)) ≤
              SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.momClass /
                SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.sgdClass ∧
            SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.momClass /
                  SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.sgdClass ≤
                SparseSGD.Scaling.Helps.kappaV ps * √(SparseSGD.Scaling.Helps.kappaV ps) /
                  (SparseSGD.Scaling.Helps.kappaV ps - 1) ∧
              √(SparseSGD.Scaling.Helps.kappaV ps) / 19 ≤
                max (1 - 4 / √(SparseSGD.Scaling.Helps.kappaV ps)) (1 / √5) * √(SparseSGD.Scaling.Helps.kappaV ps) / 8 *
                    (1 - 1 / SparseSGD.Scaling.Helps.kappaV ps ^ 2) *
                  (1 - ↑(ps (Fin.last n)) / (↑d + 2))
SparseSGD.Scaling.Helps.prop_helps_critical_v2 {n d : ℕ} {ν : MeasureTheory.Measure ℝ}
  {ps : Fin (n + 1) → ↑unitInterval} (jury : SparseSGD.External.JuryStability) (hp : ∀ (j : Fin (n + 1)), 0 < ↑(ps j))
  (hanti : Antitone ps) (hκ : 16 < SparseSGD.Scaling.Helps.kappaV ps) :
  (Filter.Tendsto (fun B => SparseSGD.Scaling.Helps.Sfun d B ν ps SparseSGD.Scaling.Helps.sgdClass) Filter.atTop
        (nhds (SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.sgdClass)) ∧
      Filter.Tendsto (fun B => SparseSGD.Scaling.Helps.Sfun d B ν ps SparseSGD.Scaling.Helps.momClass) Filter.atTop
          (nhds (SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass)) ∧
        SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.sgdClass =
            1 / (2 * Real.log ((SparseSGD.Scaling.Helps.kappaV ps + 1) / (SparseSGD.Scaling.Helps.kappaV ps - 1))) ∧
          SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass =
              1 /
                (2 *
                  Real.log ((√(SparseSGD.Scaling.Helps.kappaV ps) + 1) / (√(SparseSGD.Scaling.Helps.kappaV ps) - 1))) ∧
            SparseSGD.Scaling.Helps.kappaV ps / 4 * (1 - 1 / SparseSGD.Scaling.Helps.kappaV ps ^ 2) ≤
                SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.sgdClass ∧
              SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.sgdClass ≤
                  SparseSGD.Scaling.Helps.kappaV ps / 4 ∧
                √(SparseSGD.Scaling.Helps.kappaV ps) / 4 * (1 - 1 / SparseSGD.Scaling.Helps.kappaV ps) ≤
                    SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass ∧
                  SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass ≤
                    √(SparseSGD.Scaling.Helps.kappaV ps) / 4) ∧
    (SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.sgdClass =
          SparseSGD.Scaling.Helps.Efun d 1 ν ps SparseSGD.Scaling.Helps.sgdClass ∧
        SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.sgdClass =
            1 / Real.log ((↑d + 2) / (↑d + 2 - ↑(ps (Fin.last n)))) ∧
          (↑d + 2 - ↑(ps (Fin.last n))) / ↑(ps (Fin.last n)) ≤
              SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.sgdClass ∧
            SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.sgdClass ≤ (↑d + 2) / ↑(ps (Fin.last n)) ∧
              max (1 - 4 / √(SparseSGD.Scaling.Helps.kappaV ps)) (1 / √5) * (↑d + 2 - ↑(ps (Fin.last n))) /
                    (8 * ↑(ps (Fin.last n))) ≤
                  SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.momClass ∧
                SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.momClass ≤
                  SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.sgdClass) ∧
      (4 * (↑d + 2 - ↑(ps (Fin.last n))) / ↑(ps 0) ≤
            SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.sgdClass ∧
          SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.sgdClass ≤
              SparseSGD.Scaling.Helps.kappaV ps ^ 2 / (SparseSGD.Scaling.Helps.kappaV ps ^ 2 - 1) *
                (4 * (↑d + 2) / ↑(ps 0)) ∧
            SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.momClass /
                  SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.sgdClass ≤
                SparseSGD.Scaling.Helps.kappaV ps * √(SparseSGD.Scaling.Helps.kappaV ps) /
                  (SparseSGD.Scaling.Helps.kappaV ps - 1) ∧
              SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.momClass ≤
                  SparseSGD.Scaling.Helps.kappaV ps / (SparseSGD.Scaling.Helps.kappaV ps - 1) *
                    (4 * (↑d + 2) / √(↑(ps 0) * ↑(ps (Fin.last n)))) ∧
                max (1 - 4 / √(SparseSGD.Scaling.Helps.kappaV ps)) (1 / √5) * √(SparseSGD.Scaling.Helps.kappaV ps) / 8 *
                        (1 - 1 / SparseSGD.Scaling.Helps.kappaV ps ^ 2) *
                      (1 - ↑(ps (Fin.last n)) / (↑d + 2)) ≤
                    SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.momClass /
                      SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.sgdClass ∧
                  max (1 - 4 / √(SparseSGD.Scaling.Helps.kappaV ps)) (1 / √5) * (↑d + 2 - ↑(ps (Fin.last n))) /
                        (2 * √(↑(ps 0) * ↑(ps (Fin.last n)))) ≤
                      SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.momClass ∧
                    √(SparseSGD.Scaling.Helps.kappaV ps) / 19 ≤
                      max (1 - 4 / √(SparseSGD.Scaling.Helps.kappaV ps)) (1 / √5) *
                              √(SparseSGD.Scaling.Helps.kappaV ps) /
                            8 *
                          (1 - 1 / SparseSGD.Scaling.Helps.kappaV ps ^ 2) *
                        (1 - ↑(ps (Fin.last n)) / (↑d + 2))) ∧
        (∀ (β : ℝ),
            0 ≤ β →
              β < 1 →
                Filter.Tendsto (fun B => SparseSGD.Scaling.Helps.Sfun d B ν ps {β}) Filter.atTop
                    (nhds (SparseSGD.Scaling.Helps.Sbeta ps β)) ∧
                  (∀ (B : ℕ), 1 ≤ B → SparseSGD.Scaling.Helps.Sbeta ps β ≤ SparseSGD.Scaling.Helps.Sfun d B ν ps {β}) ∧
                    SparseSGD.Scaling.Helps.Sinf d ν ps {β} = SparseSGD.Scaling.Helps.Sbeta ps β ∧
                      SparseSGD.Scaling.Helps.Sbeta ps β = -1 / (2 * Real.log (SparseSGD.Scaling.Helps.rhoBeta ps β)) ∧
                        (β = 0 →
                            SparseSGD.Scaling.Helps.rhoBeta ps β =
                              (SparseSGD.Scaling.Helps.kappaV ps - 1) / (SparseSGD.Scaling.Helps.kappaV ps + 1)) ∧
                          (0 < β →
                              (SparseSGD.Scaling.Helps.rhoBeta ps β = √β ↔
                                SparseSGD.Scaling.Helps.kappaV ps ≤ SparseSGD.Scaling.Helps.kappaBeta β)) ∧
                            (√(SparseSGD.Scaling.Helps.kappaV ps) - 1) / (√(SparseSGD.Scaling.Helps.kappaV ps) + 1) ≤
                                SparseSGD.Scaling.Helps.rhoBeta ps β ∧
                              (SparseSGD.Scaling.Helps.kappaBeta β ≤ SparseSGD.Scaling.Helps.kappaV ps →
                                  SparseSGD.Scaling.Helps.Sbeta ps β ≤ SparseSGD.Scaling.Helps.ABeta ps β) ∧
                                (SparseSGD.Scaling.Helps.DeltaBeta ps β ≤ 1 / 4 →
                                  1 / 2 * (1 + √(1 - 4 * SparseSGD.Scaling.Helps.DeltaBeta ps β)) *
                                      SparseSGD.Scaling.Helps.ABeta ps β ≤
                                    SparseSGD.Scaling.Helps.Sbeta ps β)) ∧
          SparseSGD.Scaling.Helps.rhoBeta ps (SparseSGD.Scaling.Helps.betaPolyak ps) =
              (√(SparseSGD.Scaling.Helps.kappaV ps) - 1) / (√(SparseSGD.Scaling.Helps.kappaV ps) + 1) ∧
            SparseSGD.Scaling.Helps.Sbeta ps (SparseSGD.Scaling.Helps.betaPolyak ps) =
                1 / SparseSGD.Scaling.Helps.lamMom ps ∧
              sInf (SparseSGD.Scaling.Helps.Sbeta ps '' Set.Ico 0 1) =
                SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass
SparseSGD.Scaling.Helps.prop_vocab_full {n d : ℕ} {ν : MeasureTheory.Measure ℝ} {ps : Fin (n + 1) → ↑unitInterval}
  (jury : SparseSGD.External.JuryStability) (hp : ∀ (j : Fin (n + 1)), 0 < ↑(ps j)) (hanti : Antitone ps)
  (hκ : 16 < SparseSGD.Scaling.Helps.kappaV ps) :
  ((∀ (B : ℕ),
