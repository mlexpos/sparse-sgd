  (hx : s.cov = Matrix.vecMulVec x x) (hb0 : 0 < p.beta) (hb1 : p.beta < 1) (hw0 : 0 < p.w)
  (hw1 : p.w < 2 * (1 + p.beta)) (hnoise : p.noise = 0) (hadd : p.additive = 0) (k : ℕ) :
