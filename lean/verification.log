SparseSGD.Scaling.Helps.inv_rayRate {nu : ℝ} (hnu : 0 < nu) :
  1 / SparseSGD.Scaling.Helps.rayRate nu = (1 + nu + √(1 + nu ^ 2)) / 2
SparseSGD.Scaling.Helps.inv_two_log_bounds {y : ℝ} (hy : 1 < y) :
  y / 4 * (1 - 1 / y ^ 2) ≤ 1 / (2 * Real.log ((y + 1) / (y - 1))) ∧ 1 / (2 * Real.log ((y + 1) / (y - 1))) ≤ y / 4
SparseSGD.Scaling.Helps.inverseCriticalRate_affine (d B : ℕ) (p : ↑unitInterval) (beta : ℝ) :
  SparseSGD.Probability.LeastSquares.inverseCriticalRate d B p beta =
