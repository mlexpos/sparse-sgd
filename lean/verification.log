      (nhdsWithin 0 (Set.Ioi 0)) (nhds ((1 - a) / (1 - 2 * a ^ 3))) ∧
    1 - a ≤ (1 - a) / (1 - 2 * a ^ 3) ∧
      Filter.Tendsto
          (fun e => SparseSGD.Scaling.Helps.floorOf (SparseSGD.Scaling.Helps.momentumParams e (1 / 4) un phi))
          (nhdsWithin 0 (Set.Ioi 0)) (nhds (phi / (1 - un))) ∧
        Filter.Tendsto
          (fun e => SparseSGD.Scaling.Helps.floorOf { beta := 0, w := e / 2, noise := 2 * un, additive := 2 * phi })
          (nhdsWithin 0 (Set.Ioi 0)) (nhds (2 * phi / (1 - 2 * un)))
