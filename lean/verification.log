SparseSGD.Scaling.Helps.hyperbola_ge_max {a b : ℝ} (ha : 0 < a) (hb : 0 < b) :
  max a b ≤ SparseSGD.Scaling.Helps.hyperbolaN a b
SparseSGD.Scaling.Helps.hyperbola_perturb {S M ρ δ a b : ℝ} (hS : 0 < S) (hM : 0 < M)
  (ha : SparseSGD.Scaling.Helps.hyperbolaN S M / S ≤ a) (hb : SparseSGD.Scaling.Helps.hyperbolaN S M / M ≤ b)
  (hρ : |ρ - 1| ≤ δ) (hδ : δ ≤ 1) :
