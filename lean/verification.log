SparseSGD.Scaling.ls_small_curvature_window_parameters (pStar kappa bStar sigma epsStar gamma etaStar alpha u : ℝ)
  (p : ℕ → ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (hp : 0 < pStar) (hk : 0 ≤ kappa) (hb : 0 < bStar)
  (hs : 0 ≤ sigma) (he : 0 < epsStar) (hg : 0 < gamma) (heta : 0 < etaStar)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d)
  (hD : 0 < gamma - alpha - kappa) (hw : -(alpha + gamma + kappa) < 0)
  (hcell :
    1 - sigma - alpha < 0 ∧ u = 0 ∨
      1 - sigma - alpha = 0 ∧ u = etaStar / (2 * SparseSGD.Scaling.realizedBatchScale bStar sigma))
  (hu1 : u < 1) :
  have P := SparseSGD.Scaling.actualLSParams pStar kappa bStar sigma epsStar gamma etaStar alpha p ν;
  ∃ margin > 0,
    (∀ᶠ (d : ℕ) in Filter.atTop, SparseSGD.WindowParameters (P d) margin ∧ 0 ≤ (P d).renormAdditive) ∧
      Filter.Tendsto (fun d => (P d).matchedStep + 1 / √(P d).matchedDelta) Filter.atTop (nhds 0) ∧
        Filter.Tendsto (fun d => (P d).renormNoise) Filter.atTop (nhds u) ∧
          Filter.Tendsto (fun d => (P d).renormAdditive) Filter.atTop
            (nhds (SparseSGD.Probability.LeastSquares.labelVariance ν * u))
SparseSGD.Scaling.ls_window_cells_energy (pStar kappa bStar sigma epsStar gamma etaStar alpha u : ℝ)
  (p : ℕ → ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (jury : SparseSGD.External.JuryStability) (hp : 0 < pStar)
  (hk : 0 ≤ kappa) (hb : 0 < bStar) (hs : 0 ≤ sigma) (he : 0 < epsStar) (hg : 0 < gamma) (heta : 0 < etaStar)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d)
  (hD : 0 < gamma - alpha - kappa) (hw : -(alpha + gamma + kappa) < 0)
  (hcell :
    1 - sigma - alpha < 0 ∧ u = 0 ∨
      1 - sigma - alpha = 0 ∧ u = etaStar / (2 * SparseSGD.Scaling.realizedBatchScale bStar sigma))
  (hu1 : u < 1) (s : ℕ → SparseSGD.Moments) (hsPSD : ∀ (d : ℕ), (s d).psd) :
  have P := SparseSGD.Scaling.actualLSParams pStar kappa bStar sigma epsStar gamma etaStar alpha p ν;
  ∃ C ≥ 0,
    Filter.Tendsto (fun d => C * ((P d).matchedStep + 1 / √(P d).matchedDelta)) Filter.atTop (nhds 0) ∧
      ∀ᶠ (d : ℕ) in Filter.atTop,
        ∀ (k : ℕ),
          |SparseSGD.slowEnergy (P d).matchedDelta ((P d).matchedMoments ((P d).trajectory (s d) k)) -
                  (P d).windowSlow (s d) (↑k * (P d).matchedStep)| ≤
              C * ((P d).matchedStep + 1 / √(P d).matchedDelta) *
                ((P d).comparisonInitialSize (s d) + (P d).renormAdditive) ∧
            ‖SparseSGD.oscillatoryEnergy (P d).matchedDelta (SparseSGD.oscillatoryRoot √((P d).matchedDelta - 1 / 4))
                    ((P d).matchedMoments ((P d).trajectory (s d) k)) -
                  (P d).windowOsc (s d) (↑k * (P d).matchedStep)‖ ≤
              C * ((P d).matchedStep + 1 / √(P d).matchedDelta) *
                ((P d).comparisonInitialSize (s d) + (P d).renormAdditive)
SparseSGD.Scaling.ls_window_cells_envelope_rate (pStar kappa bStar sigma epsStar gamma etaStar alpha u : ℝ)
  (p : ℕ → ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (hp : 0 < pStar) (hk : 0 ≤ kappa) (hb : 0 < bStar)
