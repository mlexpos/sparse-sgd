SparseSGD.Scaling.Helps.vocab_full_i_coscaling (jury : SparseSGD.External.JuryStability) {δ : ℝ} (hδ : 0 < δ) :
  ∃ eps0,
    0 < eps0 ∧
      ∀ (n d B : ℕ) (ν : MeasureTheory.Measure ℝ) (ps : Fin (n + 1) → ↑unitInterval) (beta : ℝ),
        (∀ (j : Fin (n + 1)), 0 < ↑(ps j)) →
          Antitone ps →
            1 < SparseSGD.Scaling.Helps.kappaV ps →
              1 ≤ B →
                (↑B - 1) * (↑(ps 0) - ↑(ps (Fin.last n))) ≤ ↑d + 2 →
                  0 < 1 - beta →
                    1 - beta ≤ eps0 →
                      (1 - δ) * SparseSGD.Scaling.Helps.Sfun d B ν ps SparseSGD.Scaling.Helps.sgdClass ≤
                        SparseSGD.Scaling.Helps.Sfun d B ν ps {beta}
