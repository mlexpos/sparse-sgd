      SparseSGD.Scaling.Helps.retentionScale p.eps Delta =
    1 + p.eps • SparseSGD.continuumGenerator Delta p.noise +
      p.eps ^ 2 • SparseSGD.Scaling.Helps.transferG p.eps Delta p.noise
