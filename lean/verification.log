SparseSGD.Logistic.driftParams_equilibrium_R {d B : ℕ} (eta beta : ℝ) (p : ↑unitInterval)
  (mu theta : SparseSGD.Logistic.Vec d) :
  (SparseSGD.Logistic.driftParams eta beta p mu theta).equilibrium.R =
    SparseSGD.Logistic.frozenLogisticFloor d B eta (SparseSGD.Logistic.coefA p mu theta)
      (SparseSGD.Logistic.coefDtheta p mu theta) (SparseSGD.Logistic.coefD0 p mu theta)
      (eta * (1 - beta) * SparseSGD.Logistic.coefA p mu theta / (2 * (1 + beta)))
SparseSGD.Logistic.driftParams_loads {d B : ℕ} (eta beta : ℝ) (p : ↑unitInterval)
  (mu theta : SparseSGD.Logistic.Vec d) :
  (SparseSGD.Logistic.driftParams eta beta p mu theta).noise =
      eta * (SparseSGD.Logistic.coefDtheta p mu theta - SparseSGD.Logistic.coefA p mu theta ^ 2) /
        (2 * ↑B * SparseSGD.Logistic.coefA p mu theta) ∧
    (SparseSGD.Logistic.driftParams eta beta p mu theta).additive =
        eta * (↑d - 1) * SparseSGD.Logistic.coefD0 p mu theta / (2 * ↑B * SparseSGD.Logistic.coefA p mu theta) ∧
      (SparseSGD.Logistic.driftParams eta beta p mu theta).curvature =
        eta * (1 - beta) * SparseSGD.Logistic.coefA p mu theta / (2 * (1 + beta))
