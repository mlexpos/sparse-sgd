SparseSGD.Logistic.fluidBernstein_of_unit.{u_1, u_2} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E] {Ω : Type u_2} [mΩ : MeasurableSpace Ω]
  (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] (ℱ : MeasureTheory.Filtration ℕ mΩ) (Ψ : E → E)
  (X : ℕ → Ω → E) (x : ℕ → E) (ρ v M : ℝ) (K : ℕ) (hv : 0 ≤ v) (hM : 0 ≤ M)
  (h : SparseSGD.Logistic.FluidUnitBernstein μ ℱ Ψ X x ρ v M K) : SparseSGD.Logistic.FluidBernstein μ ℱ Ψ X x ρ v M K
SparseSGD.Logistic.fluidStoppedSum_dual_tail.{u_1, u_2} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E] {Ω : Type u_2} [mΩ : MeasurableSpace Ω]
  (H : SparseSGD.External.MartingaleBernsteinCertificate Ω) (μ : MeasureTheory.Measure Ω)
  [MeasureTheory.IsProbabilityMeasure μ] (ℱ : MeasureTheory.Filtration ℕ mΩ) (Ψ : E → E) (hΨ : Measurable Ψ)
  (X : ℕ → Ω → E) (x : ℕ → E) (hX : MeasureTheory.StronglyAdapted ℱ X) (J : ℕ → E →L[ℝ] E) (K : ℕ) (ρ Γ v M L : ℝ)
  (hΓ : 0 < Γ) (hv : 0 ≤ v) (hM : 0 ≤ M) (hL : 0 < L)
  (hJ : ∀ k ≤ K, ∀ j < k, ‖SparseSGD.Logistic.jacobianResponse J k j‖ ≤ Γ)
  (hA3 : SparseSGD.Logistic.FluidBernstein μ ℱ Ψ X x ρ v M K) (k : ℕ) (hk : k ≤ K) (ell0 : E →L[ℝ] ℝ)
  (hell0 : ‖ell0‖ ≤ 1) :
  μ {ω | Γ * (√(2 * ↑k * v * L) + 2 * M * L) < |ell0 (SparseSGD.Logistic.fluidStoppedSum Ψ X x J ρ k ω)|} ≤
    ENNReal.ofReal (2 * Real.exp (-L))
SparseSGD.Logistic.fluidStoppedSum_family_union_bound.{u_1, u_2} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E] {m : ℕ} {Ω : Type u_2} [mΩ : MeasurableSpace Ω]
  (H : SparseSGD.External.MartingaleBernsteinCertificate Ω) (μ : MeasureTheory.Measure Ω)
  [MeasureTheory.IsProbabilityMeasure μ] (ℱ : MeasureTheory.Filtration ℕ mΩ) (Ψ : E → E) (hΨ : Measurable Ψ)
  (X : ℕ → Ω → E) (x : ℕ → E) (hX : MeasureTheory.StronglyAdapted ℱ X) (ell : Fin m → E →L[ℝ] ℝ)
  (hell : ∀ (i : Fin m), ‖ell i‖ ≤ 1) (J : ℕ → E →L[ℝ] E) (K : ℕ) (ρ Γ v M L : ℝ) (hΓ : 0 < Γ) (hv : 0 ≤ v) (hM : 0 ≤ M)
  (hL : 0 < L) (hJ : ∀ k ≤ K, ∀ j < k, ‖SparseSGD.Logistic.jacobianResponse J k j‖ ≤ Γ)
  (hA3 : SparseSGD.Logistic.FluidBernstein μ ℱ Ψ X x ρ v M K) :
  μ
      (⋃ q,
        {ω |
          SparseSGD.Logistic.fluidThreshold Γ v M K L <
            |(ell q.2) (SparseSGD.Logistic.fluidStoppedSum Ψ X x J ρ (↑q.1 + 1) ω)|}) ≤
    ENNReal.ofReal (2 * ↑m * ↑K * Real.exp (-L))
SparseSGD.Logistic.fluid_error_unroll.{u_1, u_2} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E] {Ω : Type u_2} (Ψ : E → E) (X : ℕ → Ω → E) (x : ℕ → E)
  (J : ℕ → E →L[ℝ] E) (hx : ∀ (k : ℕ), x (k + 1) = Ψ (x k)) (ω : Ω) (h0 : X 0 ω = x 0) (k : ℕ) :
  SparseSGD.Logistic.fluidError X x k ω =
    ∑ j ∈ Finset.range k, (SparseSGD.Logistic.jacobianResponse J k j) (SparseSGD.Logistic.fluidNoise Ψ X j ω) +
      ∑ j ∈ Finset.range k, (SparseSGD.Logistic.jacobianResponse J k j) (SparseSGD.Logistic.fluidRemainder Ψ X x J j ω)
SparseSGD.Logistic.fluid_limit_normingFamily.{u_1, u_2} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E] {m : ℕ} {Ω : Type u_2} [mΩ : MeasurableSpace Ω]
  (H : SparseSGD.External.MartingaleBernsteinCertificate Ω) (μ : MeasureTheory.Measure Ω)
  [MeasureTheory.IsProbabilityMeasure μ] (ℱ : MeasureTheory.Filtration ℕ mΩ) (Ψ : E → E) (hΨ : Measurable Ψ)
  (X : ℕ → Ω → E) (x : ℕ → E) (hX : MeasureTheory.StronglyAdapted ℱ X) (ell : Fin m → E →L[ℝ] ℝ)
  (hell : ∀ (i : Fin m), ‖ell i‖ = 1) (hnorming : ∀ (y : E), ‖y‖ ≤ ‖fun i => (ell i) y‖) (J : ℕ → E →L[ℝ] E) (K : ℕ)
  (ρ Γ L2 v M δ : ℝ) (hn : 0 < m) (hK : 0 < K) (hΓ : 0 < Γ) (hL2 : 0 ≤ L2) (hv : 0 ≤ v) (hM : 0 ≤ M) (hδ0 : 0 < δ)
  (hδ1 : δ < 1) (hx : ∀ (k : ℕ), x (k + 1) = Ψ (x k)) (h0 : ∀ᵐ (ω : Ω) ∂μ, X 0 ω = x 0)
  (hJ : ∀ k ≤ K, ∀ j < k, ‖SparseSGD.Logistic.jacobianResponse J k j‖ ≤ Γ)
  (hTaylor : ∀ j < K, ∀ (y : E), ‖y - x j‖ ≤ ρ → ‖Ψ y - Ψ (x j) - (J j) (y - x j)‖ ≤ L2 / 2 * ‖y - x j‖ ^ 2)
  (hA3 : SparseSGD.Logistic.FluidUnitBernstein μ ℱ Ψ X x ρ v M K)
  (hradius : 2 * SparseSGD.Logistic.fluidThreshold Γ v M K (Real.log (2 * ↑m * ↑K / δ)) ≤ ρ)
  (hsmall : 2 * ↑K * Γ * L2 * SparseSGD.Logistic.fluidThreshold Γ v M K (Real.log (2 * ↑m * ↑K / δ)) ≤ 1) :
  ENNReal.ofReal (1 - δ) ≤
    μ
      {ω |
        ∀ k ≤ K,
          ‖X k ω - x k‖ ≤ 2 * Γ * (√(2 * ↑K * v * Real.log (2 * ↑m * ↑K / δ)) + 2 * M * Real.log (2 * ↑m * ↑K / δ))}
SparseSGD.Logistic.fluid_limit_supNorm.{u_2} {n : ℕ} {Ω : Type u_2} [mΩ : MeasurableSpace Ω]
  (H : SparseSGD.External.MartingaleBernsteinCertificate Ω) (μ : MeasureTheory.Measure Ω)
