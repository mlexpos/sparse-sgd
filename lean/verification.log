                            (SparseSGD.Scaling.Helps.stepRadius
                              (SparseSGD.Scaling.Helps.copyParams d B ν 0 (η j) ps j))) ≤
                      Real.log (1 + ↑B * ↑(ps (Fin.last n)) / (↑d + 2 - ↑(ps (Fin.last n))))) ∧
          ∀ (B : ℕ),
            1 ≤ B →
              ↑B - 1 ≤ SparseSGD.Scaling.Helps.vocabBx d ps →
                max (1 - 4 / √(SparseSGD.Scaling.Helps.kappaV ps)) (1 / √5) * (SparseSGD.Scaling.Helps.kappaV ps - 1) *
                        (↑d + 2 - ↑(ps (Fin.last n))) /
                      (8 * SparseSGD.Scaling.Helps.kappaV ps * (↑d + 2)) *
                    SparseSGD.Scaling.Helps.Sfun d B ν ps SparseSGD.Scaling.Helps.sgdClass ≤
                  SparseSGD.Scaling.Helps.Sfun d B ν ps SparseSGD.Scaling.Helps.momClass) ∧
    ((∀ (B : ℕ),
          1 ≤ B →
            SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.sgdClass ≤
              SparseSGD.Scaling.Helps.Sfun d B ν ps SparseSGD.Scaling.Helps.sgdClass) ∧
        Filter.Tendsto (fun B => SparseSGD.Scaling.Helps.Sfun d B ν ps SparseSGD.Scaling.Helps.sgdClass) Filter.atTop
            (nhds (SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.sgdClass)) ∧
          SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.sgdClass =
              1 / (2 * Real.log ((SparseSGD.Scaling.Helps.kappaV ps + 1) / (SparseSGD.Scaling.Helps.kappaV ps - 1))) ∧
            SparseSGD.Scaling.Helps.kappaV ps / 4 * (1 - 1 / SparseSGD.Scaling.Helps.kappaV ps ^ 2) ≤
                SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.sgdClass ∧
              SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.sgdClass ≤
                SparseSGD.Scaling.Helps.kappaV ps / 4) ∧
      (∀ (β : ℝ),
          0 ≤ β →
            β < 1 →
              (∀ (B : ℕ), 1 ≤ B → SparseSGD.Scaling.Helps.Sinf d ν ps {β} ≤ SparseSGD.Scaling.Helps.Sfun d B ν ps {β}) ∧
                Filter.Tendsto (fun B => SparseSGD.Scaling.Helps.Sfun d B ν ps {β}) Filter.atTop
                    (nhds (SparseSGD.Scaling.Helps.Sinf d ν ps {β})) ∧
                  SparseSGD.Scaling.Helps.Sinf d ν ps {β} = SparseSGD.Scaling.Helps.Sbeta ps β ∧
                    (SparseSGD.Scaling.Helps.kappaV ps ≤ SparseSGD.Scaling.Helps.kappaBeta β →
                        SparseSGD.Scaling.Helps.Sinf d ν ps {β} = 1 / Real.log (1 / β)) ∧
                      (SparseSGD.Scaling.Helps.kappaBeta β ≤ SparseSGD.Scaling.Helps.kappaV ps →
                          SparseSGD.Scaling.Helps.Sinf d ν ps {β} ≤ SparseSGD.Scaling.Helps.ABeta ps β) ∧
                        (SparseSGD.Scaling.Helps.DeltaBeta ps β ≤ 1 / 4 →
                            1 / 2 * (1 + √(1 - 4 * SparseSGD.Scaling.Helps.DeltaBeta ps β)) *
                                  SparseSGD.Scaling.Helps.ABeta ps β ≤
                                SparseSGD.Scaling.Helps.Sinf d ν ps {β} ∧
                              SparseSGD.Scaling.Helps.Sinf d ν ps {β} ≤ SparseSGD.Scaling.Helps.ABeta ps β) ∧
                          (SparseSGD.Scaling.Helps.kappaBeta β ≤ SparseSGD.Scaling.Helps.kappaV ps →
                            4 * (↑d + 2 - ↑(ps (Fin.last n))) * (1 + β) / ((1 - β) * (↑(ps 0) + ↑(ps (Fin.last n)))) ≤
                              SparseSGD.Scaling.Helps.Einf d ν ps SparseSGD.Scaling.Helps.sgdClass /
                                SparseSGD.Scaling.Helps.Sinf d ν ps {β})) ∧
        ((∀ (B : ℕ),
              1 ≤ B →
                SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass ≤
                  SparseSGD.Scaling.Helps.Sfun d B ν ps SparseSGD.Scaling.Helps.momClass) ∧
            Filter.Tendsto (fun B => SparseSGD.Scaling.Helps.Sfun d B ν ps SparseSGD.Scaling.Helps.momClass)
                Filter.atTop (nhds (SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass)) ∧
              SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass =
                  1 /
                    (2 *
                      Real.log
                        ((√(SparseSGD.Scaling.Helps.kappaV ps) + 1) / (√(SparseSGD.Scaling.Helps.kappaV ps) - 1))) ∧
                √(SparseSGD.Scaling.Helps.kappaV ps) / 4 * (1 - 1 / SparseSGD.Scaling.Helps.kappaV ps) ≤
                    SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass ∧
                  SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass ≤
                      √(SparseSGD.Scaling.Helps.kappaV ps) / 4 ∧
                    IsLeast (SparseSGD.Scaling.Helps.Sbeta ps '' Set.Ico 0 1)
                        (SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass) ∧
                      SparseSGD.Scaling.Helps.Sbeta ps (SparseSGD.Scaling.Helps.betaPolyak ps) =
                        SparseSGD.Scaling.Helps.Sinf d ν ps SparseSGD.Scaling.Helps.momClass) ∧
          4 * (↑d + 2 - ↑(ps (Fin.last n))) / ↑(ps 0) ≤
              SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.sgdClass ∧
            SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.sgdClass ≤
                SparseSGD.Scaling.Helps.kappaV ps ^ 2 / (SparseSGD.Scaling.Helps.kappaV ps ^ 2 - 1) *
                  (4 * (↑d + 2) / ↑(ps 0)) ∧
              SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.momClass ≤
                  SparseSGD.Scaling.Helps.kappaV ps / (SparseSGD.Scaling.Helps.kappaV ps - 1) *
                    (4 * (↑d + 2) / √(↑(ps 0) * ↑(ps (Fin.last n)))) ∧
                max (1 - 4 / √(SparseSGD.Scaling.Helps.kappaV ps)) (1 / √5) * (↑d + 2 - ↑(ps (Fin.last n))) /
                    (2 * √(↑(ps 0) * ↑(ps (Fin.last n)))) ≤
                  SparseSGD.Scaling.Helps.Bcrit d ν ps SparseSGD.Scaling.Helps.momClass
