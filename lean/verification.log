    Filter.Tendsto (fun B => SparseSGD.Scaling.Helps.Lmin d B ν beta eta ps) Filter.atTop (nhds (-Real.log beta)) ∧
      ∀ᶠ (B : ℕ) in Filter.atTop,
        ∀ (j : Fin (n + 1)),
          SparseSGD.Scaling.Helps.stepRadius (SparseSGD.Scaling.Helps.copyParams d B ν beta eta ps j) < 1
SparseSGD.Scaling.Helps.largeBatch_sgd {n d : ℕ} {ν : MeasureTheory.Measure ℝ} {beta eta : ℝ}
  {ps : Fin (n + 1) → ↑unitInterval} (hp : ∀ (j : Fin (n + 1)), 0 < ↑(ps j)) (hanti : Antitone ps) (hβ : beta = 0)
  (hη : eta = 2 / (↑(ps 0) + ↑(ps (Fin.last n)))) (hκ : 1 < SparseSGD.Scaling.Helps.kappaV ps) :
  Filter.Tendsto (fun B => SparseSGD.Scaling.Helps.rhoMax d B ν beta eta ps) Filter.atTop
      (nhds (((SparseSGD.Scaling.Helps.kappaV ps - 1) / (SparseSGD.Scaling.Helps.kappaV ps + 1)) ^ 2)) ∧
    Filter.Tendsto (fun B => SparseSGD.Scaling.Helps.Lmin d B ν beta eta ps) Filter.atTop
        (nhds (2 * Real.log ((SparseSGD.Scaling.Helps.kappaV ps + 1) / (SparseSGD.Scaling.Helps.kappaV ps - 1)))) ∧
      ∀ᶠ (B : ℕ) in Filter.atTop,
