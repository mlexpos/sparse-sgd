SparseSGD.Scaling.Helps.cor_helps_speedup {K : Set (ℝ × ℝ)} (hK : IsCompact K) (hsub : K ⊆ Set.Ioi 0 ×ˢ Set.Ico 0 1) :
  ∃ eps0 ∈ Set.Ioc 0 (1 / 2),
    ∃ C,
      0 ≤ C ∧
        ∀ eps ∈ Set.Ioc 0 eps0,
          ∀ x ∈ K,
            ∀ (phi : ℝ),
              0 ≤ phi →
                SparseSGD.Scaling.Helps.stepRadius (SparseSGD.Scaling.Helps.momentumParams eps x.1 x.2 phi) < 1 ∧
                  SparseSGD.Scaling.Helps.stepRadius (SparseSGD.Scaling.Helps.sgdParams eps x.1 x.2 phi) < 1 ∧
                    |SparseSGD.Scaling.Helps.perStepRate (SparseSGD.Scaling.Helps.momentumParams eps x.1 x.2 phi) /
                              SparseSGD.Scaling.Helps.perStepRate (SparseSGD.Scaling.Helps.sgdParams eps x.1 x.2 phi) -
                            SparseSGD.Scaling.Helps.speedupRatio x.1 x.2| ≤
                        C * eps ^ (1 / 3) ∧
                      phi / (1 - x.2) ≤
                          SparseSGD.Scaling.Helps.floorOf (SparseSGD.Scaling.Helps.momentumParams eps x.1 x.2 phi) ∧
                        SparseSGD.Scaling.Helps.floorOf (SparseSGD.Scaling.Helps.momentumParams eps x.1 x.2 phi) ≤
                            SparseSGD.Scaling.Helps.floorOf (SparseSGD.Scaling.Helps.sgdParams eps x.1 x.2 phi) ∧
                          SparseSGD.Scaling.Helps.floorOf (SparseSGD.Scaling.Helps.sgdParams eps x.1 x.2 phi) ≤
                            phi / (1 - x.2) * (1 + C * eps)
