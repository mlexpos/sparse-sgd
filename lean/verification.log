            SparseSGD.Logistic.equilibriumBulk (r d) (SparseSGD.Logistic.familyPhi eta alpha (fun x => B) d) ∧
          SparseSGD.Logistic.equilibriumBulk (r d) (SparseSGD.Logistic.familyPhi eta alpha (fun x => B) d) ≤
            C * ↑d ^ (1 - alpha)
SparseSGD.Logistic.equilibriumBulk_integerBatch_comparable (eta alpha sigma scale P : ℝ) (r : ℕ → ℝ) (heta : 0 < eta)
  (hs : 0 < scale) (hsigma : 0 < sigma) (hr : ∀ (d : ℕ), 0 < r d)
