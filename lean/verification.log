SparseSGD.Scaling.Helps.samplecost_above :
  ∃ eps0,
    0 < eps0 ∧
      eps0 ≤ 1 / 2 ∧
        ∃ C,
          0 ≤ C ∧
            ∀ (d B : ℕ) (p : ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (beta : ℝ),
              0 < B →
                0 < ↑p →
                  0 < 1 - beta →
                    1 - beta ≤ eps0 →
                      SparseSGD.Scaling.Helps.lsNu d B p beta ≤ 1 →
                        |SparseSGD.Scaling.Helps.lsLamStar d B p ν beta / (1 - beta) - 1| ≤
                            C * ((1 - beta) ^ (1 / 3) + SparseSGD.Scaling.Helps.lsNu d B p beta ^ (1 / 3)) ∧
                          |SparseSGD.Scaling.Helps.lsNfold d B p ν beta /
                                  SparseSGD.Scaling.Helps.hyperbolaN (SparseSGD.Scaling.Helps.lsNstab d B p beta)
                                    (SparseSGD.Scaling.Helps.lsNmem B p beta) -
                                1| ≤
                            C * ((1 - beta) ^ (1 / 3) + SparseSGD.Scaling.Helps.lsNu d B p beta ^ (1 / 3))
SparseSGD.Scaling.Helps.samplecost_below :
  ∃ C,
    0 ≤ C ∧
      ∀ (d B : ℕ) (p : ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (beta : ℝ),
        0 < B →
          0 < ↑p →
            0 < 1 - beta →
              1 - beta ≤ 1 / 50 →
                100 ≤ SparseSGD.Scaling.Helps.lsNu d B p beta →
                  |SparseSGD.Scaling.Helps.lsLamStar d B p ν beta -
                          (1 - beta) * SparseSGD.Scaling.Helps.rayRate (SparseSGD.Scaling.Helps.lsNu d B p beta)| ≤
                      C * (1 - beta + 1 / SparseSGD.Scaling.Helps.lsNu d B p beta) *
                        ((1 - beta) * SparseSGD.Scaling.Helps.rayRate (SparseSGD.Scaling.Helps.lsNu d B p beta)) ∧
                    |SparseSGD.Scaling.Helps.lsNfold d B p ν beta /
                            SparseSGD.Scaling.Helps.hyperbolaN (SparseSGD.Scaling.Helps.lsNstab d B p beta)
                              (SparseSGD.Scaling.Helps.lsNmem B p beta) -
                          1| ≤
                      C * (1 - beta + 1 / SparseSGD.Scaling.Helps.lsNu d B p beta)
