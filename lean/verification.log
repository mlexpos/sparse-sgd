SparseSGD.Logistic.V2.eigen_re_identity {n : ℕ} (A H S : Matrix (Fin n) (Fin n) ℝ) (hH : H.IsSymm)
  (hAHS : A.transpose * H + H * A = -S) (x y : Fin n → ℝ) (p q : ℝ) (hx : A.mulVec x = p • x - q • y)
  (hy : A.mulVec y = q • x + p • y) : 2 * p * (x ⬝ᵥ H.mulVec x + y ⬝ᵥ H.mulVec y) = -(x ⬝ᵥ S.mulVec x + y ⬝ᵥ S.mulVec y)
SparseSGD.Logistic.V2.equilibrium_five_eigenvalues (r Phi : ℝ) (hr : 0 < r) (hPhi : 0 < Phi) :
  SparseSGD.Logistic.V2.FiveEigenvalues (SparseSGD.Logistic.V2.eqAlpha r Phi) (SparseSGD.Logistic.positiveRoot r Phi)
    (SparseSGD.Logistic.equilibriumBulk r Phi)
SparseSGD.Logistic.V2.equilibrium_of_limits (r Phi theta R : ℝ) (hr : 0 < r) (hPhi : 0 ≤ Phi)
  (h1 : SparseSGD.Logistic.alpha theta R r * theta = r) (h2 : SparseSGD.Logistic.alpha theta R r * R = Phi) :
  theta = SparseSGD.Logistic.positiveRoot r Phi ∧ R = SparseSGD.Logistic.equilibriumBulk r Phi
SparseSGD.Logistic.V2.equilibrium_real_eigenvalue (r Phi : ℝ) (hr : 0 < r) (hPhi : 0 < Phi) :
  ∃ Δ0 K,
    0 < Δ0 ∧
      0 ≤ K ∧
        ∀ (Δ : ℝ),
          Δ0 ≤ Δ →
            ∃ l,
              (l • 1 -
                      SparseSGD.Logistic.V2.jacobianMatrix (SparseSGD.Logistic.V2.eqAlpha r Phi)
                        (SparseSGD.Logistic.positiveRoot r Phi) (SparseSGD.Logistic.equilibriumBulk r Phi) Δ).det =
                  0 ∧
                |l +
                      (2 +
                          2 *
                            (SparseSGD.Logistic.equilibriumBulk r Phi /
                              (2 * (1 + SparseSGD.Logistic.positiveRoot r Phi ^ 2)))) /
                        (2 +
                          SparseSGD.Logistic.equilibriumBulk r Phi /
                            (2 * (1 + SparseSGD.Logistic.positiveRoot r Phi ^ 2)))| ≤
                  K / √Δ
SparseSGD.Logistic.V2.exists_lyapunov_certificate {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ)
  (hA : SparseSGD.Logistic.V2.IsHurwitz A) :
  ∃ P c,
    0 < c ∧
      P.transpose = P ∧
        (∀ (x : Fin n → ℝ), x ⬝ᵥ x ≤ x ⬝ᵥ P.mulVec x) ∧
          ∀ (x : Fin n → ℝ), x ⬝ᵥ (A.transpose * P + P * A).mulVec x ≤ -c * x ⬝ᵥ x
