SparseSGD.Logistic.V2.drift_recursion_converges {n : ℕ} (H : SparseSGD.Logistic.V2.RecursionSetup n)
  (K : Set (Fin n → ℝ)) (_hK : IsCompact K) (hex : ∀ y0 ∈ K, ∃ y, SparseSGD.Logistic.V2.IsODESol H.b y0 y)
  (hent : SparseSGD.Logistic.V2.UniformEntry H.b H.ystar K)
  (hbdd :
    ∀ (T : ℝ),
      0 ≤ T →
        ∃ M,
          0 ≤ M ∧
            ∀ y0 ∈ K,
              ∀ (y : ℝ → Fin n → ℝ),
                SparseSGD.Logistic.V2.IsODESol H.b y0 y → ∀ (t : ℝ), 0 ≤ t → t ≤ T → ‖y t - H.ystar‖ ≤ M)
  (htrack :
    ∀ (T : ℝ),
      0 ≤ T →
        ∃ CT εT,
          0 < CT ∧
            0 < εT ∧
              ∀ (ε : ℝ),
                0 < ε →
                  ε ≤ εT →
                    ∀ y0 ∈ K,
                      ∀ (y : ℝ → Fin n → ℝ),
                        SparseSGD.Logistic.V2.IsODESol H.b y0 y →
                          ∀ (k : ℕ),
                            ↑k * ε ≤ T → ‖(SparseSGD.Logistic.V2.driftMap H.b H.e ε)^[k] y0 - y (↑k * ε)‖ ≤ CT * H.ρ ε)
  (hcons :
    ∃ rc C1 εc,
      0 < rc ∧
        0 < C1 ∧
          0 < εc ∧
            ∀ (ε : ℝ),
              0 < ε →
                ε ≤ εc →
                  ∀ y0 ∈ K,
                    ∀ (y : ℝ → Fin n → ℝ),
                      SparseSGD.Logistic.V2.IsODESol H.b y0 y →
                        ∀ (k : ℕ),
                          ‖y (↑k * ε) - H.ystar‖ ≤ rc →
                            ‖y (↑(k + 1) * ε) - SparseSGD.Logistic.V2.driftMap H.b H.e ε (y (↑k * ε))‖ ≤
                              C1 * ε * H.ρ ε) :
  ∃ ε1 ρ1 C c,
    0 < ε1 ∧
      0 < ρ1 ∧
        0 < C ∧
          0 < c ∧
            ∃ N,
              (∃ s, 0 < s ∧ Metric.closedBall H.ystar s ⊆ N) ∧
                N ⊆ Metric.closedBall H.ystar H.r0 ∧
                  ∀ (ε : ℝ),
                    0 < ε →
                      ε ≤ ε1 →
                        H.ρ ε ≤ ρ1 →
                          ∃ yε ∈ N,
                            SparseSGD.Logistic.V2.driftMap H.b H.e ε yε = yε ∧
                              (∀ z ∈ N, SparseSGD.Logistic.V2.driftMap H.b H.e ε z = z → z = yε) ∧
                                ‖yε - H.ystar‖ ≤ C * H.ρ ε ∧
                                  ∀ y0 ∈ K,
                                    (∀ (k : ℕ),
                                        ‖(SparseSGD.Logistic.V2.driftMap H.b H.e ε)^[k] y0 - yε‖ ≤
                                          C * Real.exp (-(c * ε * ↑k))) ∧
                                      ∀ (y : ℝ → Fin n → ℝ),
                                        SparseSGD.Logistic.V2.IsODESol H.b y0 y →
                                          ∀ (k : ℕ),
                                            ‖(SparseSGD.Logistic.V2.driftMap H.b H.e ε)^[k] y0 - y (↑k * ε)‖ ≤ C * H.ρ ε
SparseSGD.Logistic.V2.dynamicField_remainder_uniform (q0 : ℝ × ℝ × ℝ) (hq0 : q0 ∈ SparseSGD.Logistic.V2.paramDomain)
  (ε : ℝ) (hε : 0 < ε) :
  ∃ r,
    0 < r ∧
      ∀ᶠ (q : ℝ × ℝ × ℝ) in nhdsWithin q0 SparseSGD.Logistic.V2.paramDomain,
        ∀ (y : SparseSGD.Logistic.DynamicState),
          ‖y - SparseSGD.Logistic.dynamicCanonicalEquilibrium q.2.2 q.1 q.2.1‖ ≤ r →
            ‖SparseSGD.Logistic.dynamicField q.2.2 q.1 q.2.1 y -
                  (SparseSGD.Logistic.V2.eqJacobian q).mulVec
                    (y - SparseSGD.Logistic.dynamicCanonicalEquilibrium q.2.2 q.1 q.2.1)‖ ≤
              ε * ‖y - SparseSGD.Logistic.dynamicCanonicalEquilibrium q.2.2 q.1 q.2.1‖
