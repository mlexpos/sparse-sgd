SparseSGD.Logistic.bulkBatchGradient_norm_sq_integral {d B : ℕ} (H : SparseSGD.External.GaussianSteinCertificate d)
  (hB : 0 < B) (p : ↑unitInterval) (mu theta : SparseSGD.Logistic.Vec d) (hr : 0 < SparseSGD.Logistic.r mu) :
  ∫ (a : SparseSGD.Logistic.Batch d B),
      ‖SparseSGD.Logistic.bulkPart mu (SparseSGD.Logistic.batchGradient p mu theta a)‖ ^
        2 ∂SparseSGD.Logistic.batchLaw d B p =
    ((↑d - 1) * SparseSGD.Logistic.coefD0 p mu theta +
          ‖SparseSGD.Logistic.bulkPart mu theta‖ ^ 2 * SparseSGD.Logistic.coefDtheta p mu theta) /
        ↑B +
      (↑B - 1) / ↑B * SparseSGD.Logistic.coefA p mu theta ^ 2 * ‖SparseSGD.Logistic.bulkPart mu theta‖ ^ 2
SparseSGD.Logistic.bulkGradient_norm_sq_integral {d : ℕ} (H : SparseSGD.External.GaussianSteinCertificate d)
  (p : ↑unitInterval) (mu theta : SparseSGD.Logistic.Vec d) (hr : 0 < SparseSGD.Logistic.r mu) :
  ∫ (a : SparseSGD.Logistic.Sample d),
      ‖SparseSGD.Logistic.bulkPart mu (SparseSGD.Logistic.gradient p mu theta a)‖ ^
        2 ∂SparseSGD.Logistic.sampleLaw d p =
    (↑d - 1) * SparseSGD.Logistic.coefD0 p mu theta +
      ‖SparseSGD.Logistic.bulkPart mu theta‖ ^ 2 * SparseSGD.Logistic.coefDtheta p mu theta
SparseSGD.Logistic.bulkResidual_norm_sq_integral {d B : ℕ} (H : SparseSGD.External.GaussianSteinCertificate d)
  (hB : 0 < B) (p : ↑unitInterval) (mu theta : SparseSGD.Logistic.Vec d) (hr : 0 < SparseSGD.Logistic.r mu) :
  ∫ (a : SparseSGD.Logistic.Batch d B),
      ‖SparseSGD.Logistic.bulkResidual p mu theta a‖ ^ 2 ∂SparseSGD.Logistic.batchLaw d B p =
    (SparseSGD.Logistic.coefDtheta p mu theta - SparseSGD.Logistic.coefA p mu theta ^ 2) / ↑B *
        ‖SparseSGD.Logistic.bulkPart mu theta‖ ^ 2 +
      (↑d - 1) * SparseSGD.Logistic.coefD0 p mu theta / ↑B
