SparseSGD.Scaling.Helps.cubic_factor_slow (a2 a1 a0 zs : ℝ) (h2 : |a2 - 3| ≤ 24e-3) (h1l : 1.97 ≤ a1) (h1u : a1 ≤ 2.11)
  (_h0 : 0 < a0) (_h0' : a0 ≤ 8e-2) (hzs : zs ^ 3 + a2 * zs ^ 2 + a1 * zs + a0 = 0) (hz1 : -6e-2 ≤ zs) (hz2 : zs ≤ 0) :
  (∀ (z : ℂ),
      z ^ 3 + ↑a2 * z ^ 2 + ↑a1 * z + ↑a0 =
        (z - ↑zs) *
          (z ^ 2 + ↑(SparseSGD.Scaling.Helps.slowFactorB a2 zs) * z +
            ↑(SparseSGD.Scaling.Helps.slowFactorC a2 a1 zs))) ∧
    2.9 ≤ SparseSGD.Scaling.Helps.slowFactorB a2 zs ∧
      SparseSGD.Scaling.Helps.slowFactorB a2 zs ≤ 3.03 ∧
        1.78 ≤ SparseSGD.Scaling.Helps.slowFactorC a2 a1 zs ∧ SparseSGD.Scaling.Helps.slowFactorC a2 a1 zs ≤ 2.11
