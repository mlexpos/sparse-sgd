  (hu : Filter.Tendsto (fun n => (p n).noise) Filter.atTop (nhds u)) (hw0 : 0 < w) (hw4 : w < 4)
  (hb1 : ∀ᶠ (n : ℕ) in Filter.atTop, (p n).beta < 1) (hu0 : ∀ᶠ (n : ℕ) in Filter.atTop, 0 ≤ (p n).renormNoise)
  (hu1 : u / (1 - w / 4) < 1) :
  Filter.Tendsto (fun n => SparseSGD.continuumPerronRate (p n).matchedDelta (p n).renormNoise) Filter.atTop
    (nhds (1 - u / (1 - w / 4)))
SparseSGD.curvature_profile_rates_tendsto (p : ℕ → SparseSGD.Params) (w u : ℝ)
  (hb : Filter.Tendsto (fun n => (p n).beta) Filter.atTop (nhds 1))
  (hw : Filter.Tendsto (fun n => (p n).w) Filter.atTop (nhds w))
  (hu : Filter.Tendsto (fun n => (p n).noise) Filter.atTop (nhds u)) (hw4 : w < 4) :
