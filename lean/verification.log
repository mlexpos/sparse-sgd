  (hP : ∀ z ∈ SparseSGD.Scaling.Helps.cubicRoots a2 a1 a0, ‖z‖ ≤ M)
  (hQ : ∀ z ∈ SparseSGD.Scaling.Helps.cubicRoots b2 b1 b0, ‖z‖ ≤ M) :
