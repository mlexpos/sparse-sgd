  (hp : ∀ (j : Fin (n + 1)), 0 < ↑(ps j)) (hκ : 1 < SparseSGD.Scaling.Helps.kappaV ps) :
  ↑B - 1 ≤ SparseSGD.Scaling.Helps.vocabBx d ps ↔ (↑B - 1) * (↑(ps 0) - ↑(ps (Fin.last n))) ≤ ↑d + 2
SparseSGD.Scaling.Helps.lem_chi_roots :
  (∀ (Delta u : ℝ),
      0 < Delta →
        0 ≤ u →
          u < 1 →
            SparseSGD.continuumPerronRate Delta u ≤ 1 - u ∧
              (SparseSGD.continuumPerronRate Delta u = 1 - u ↔ u = 0 ∧ 1 / 4 ≤ Delta)) ∧
    (∀ (Delta : ℝ),
        0 < Delta →
          (Delta ≤ 1 / 4 → SparseSGD.continuumPerronRate Delta 0 = 1 - √(1 - 4 * Delta)) ∧
            (1 / 4 ≤ Delta → SparseSGD.continuumPerronRate Delta 0 = 1)) ∧
      (∀ (u : ℝ), 0 ≤ u → u < 1 → SparseSGD.continuumPerronRate (1 / 4) u = 1 - u ^ (1 / 3)) ∧
        (∀ (Delta u : ℝ),
            0 < Delta →
              Delta ≤ 1 / 50 →
                0 ≤ u →
                  u < 1 →
                    |SparseSGD.continuumPerronRate Delta u - 2 * Delta * (1 - u)| ≤
                      18 * Delta * (2 * Delta * (1 - u))) ∧
          ∀ (Delta u : ℝ),
            0 < Delta →
              0 ≤ u →
                u < 1 →
                  (0 < u → SparseSGD.continuumPerronRate Delta u < 4 * Delta * (1 - u)) ∧
                    (u = 0 →
                      SparseSGD.continuumPerronRate Delta u ≤ 4 * Delta ∧
                        (SparseSGD.continuumPerronRate Delta u = 4 * Delta ↔ Delta = 1 / 4))
SparseSGD.Scaling.Helps.lem_helps_sgd (p : SparseSGD.Params) (hb : p.beta = 0) (hw : 0 < p.w) (hun : 0 ≤ p.noise) :
  SparseSGD.Scaling.Helps.stepRadius p = |1 - 2 * p.w * (1 - p.totalLoad)| ∧
    (SparseSGD.Scaling.Helps.stepRadius p < 1 ↔ p.totalLoad < 1) ∧
      (p.totalLoad < 1 →
        0 ≤ 1 - 2 * p.w * (1 - p.totalLoad) ∧
          1 - 2 * p.w * (1 - p.totalLoad) < 1 ∧
            SparseSGD.Scaling.Helps.perStepRate p = -Real.log (1 - 2 * p.w * (1 - p.totalLoad)))
SparseSGD.Scaling.Helps.lem_helps_transfer (D c : ℝ) (hD : 0 < D) (hc : 0 < c) :
  (∃ eps0 ∈ Set.Ioc 0 (1 / 2),
      ∃ C,
        ∀ eps ∈ Set.Ioc 0 eps0,
          ∀ Delta ∈ Set.Ioc 0 D,
            ∀ un ∈ Set.Icc 0 (c * Delta),
              |SparseSGD.Scaling.Helps.perStepRate (SparseSGD.Scaling.Helps.transferParams eps Delta un) -
                      eps * SparseSGD.continuumPerronRate Delta un| ≤
                  C * eps ^ (4 / 3) ∧
                |SparseSGD.Scaling.Helps.perStepRate (SparseSGD.Scaling.Helps.transferParams eps Delta un) -
                      eps *
                        SparseSGD.continuumPerronRate Delta
                          (un + (SparseSGD.Scaling.Helps.transferParams eps Delta un).curvature)| ≤
                  C * eps ^ (4 / 3)) ∧
    ∀ (K : Set (ℝ × ℝ)),
      IsCompact K →
        K ⊆ Set.Ioi 0 ×ˢ Set.Ico 0 1 →
          ∃ eps0 ∈ Set.Ioc 0 (1 / 2),
            ∃ C,
              ∀ eps ∈ Set.Ioc 0 eps0,
                ∀ x ∈ K,
                  |SparseSGD.Scaling.Helps.perStepRate (SparseSGD.Scaling.Helps.transferParams eps x.1 x.2) /
                          (eps * SparseSGD.continuumPerronRate x.1 x.2) -
                        1| ≤
                    C * eps ^ (1 / 3)
SparseSGD.Scaling.Helps.lem_helps_vocab_v2 {n d B : ℕ} {ν : MeasureTheory.Measure ℝ} {ps : Fin (n + 1) → ↑unitInterval}
  (jury : SparseSGD.External.JuryStability) (hB : 1 ≤ B) (hp : ∀ (j : Fin (n + 1)), 0 < ↑(ps j)) (hanti : Antitone ps) :
  (∀ (beta eta : ℝ),
      0 ≤ beta →
        beta < 1 →
          0 < eta →
            ((∀ (j : Fin (n + 1)),
                SparseSGD.Scaling.Helps.stepRadius (SparseSGD.Scaling.Helps.copyParams d B ν beta eta ps j) < 1) ↔
              eta <
                min (SparseSGD.Probability.LeastSquares.criticalRate d B (ps 0) beta)
                  (SparseSGD.Probability.LeastSquares.criticalRate d B (ps (Fin.last n)) beta))) ∧
    (∀ (beta : ℝ),
        0 ≤ beta →
          beta < 1 →
            (1 + beta) / (1 - beta) < ↑B →
              min (SparseSGD.Probability.LeastSquares.criticalRate d B (ps 0) beta)
                  (SparseSGD.Probability.LeastSquares.criticalRate d B (ps (Fin.last n)) beta) =
                SparseSGD.Probability.LeastSquares.criticalRate d B (ps 0) beta) ∧
      (∀ (beta eta : ℝ),
          0 < eta →
            beta = 0 →
              (∀ (j : Fin (n + 1)),
                  SparseSGD.Scaling.Helps.stepRadius (SparseSGD.Scaling.Helps.copyParams d B ν beta eta ps j) < 1) →
                (↑d + 2 - ↑(ps (Fin.last n))) / (↑B * ↑(ps (Fin.last n))) - 1 ≤
                    1 / SparseSGD.Scaling.Helps.Lmin d B ν beta eta ps ∧
                  (4 < SparseSGD.Scaling.Helps.kappaV ps →
                    SparseSGD.Scaling.Helps.kappaV ps / 4 - 1 ≤ 1 / SparseSGD.Scaling.Helps.Lmin d B ν beta eta ps)) ∧
        (∀ (beta eta : ℝ),
            0 < eta →
              0 ≤ beta →
                beta < 1 →
                  (∀ (j : Fin (n + 1)),
                      SparseSGD.Scaling.Helps.stepRadius (SparseSGD.Scaling.Helps.copyParams d B ν beta eta ps j) < 1) →
                    (↑d + 2 - ↑(ps (Fin.last n))) / (8 * ↑B * ↑(ps (Fin.last n))) - 1 ≤
                        1 / SparseSGD.Scaling.Helps.Lmin d B ν beta eta ps ∧
                      (16 < SparseSGD.Scaling.Helps.kappaV ps →
                        √(SparseSGD.Scaling.Helps.kappaV ps) / 4 - 1 ≤
                          1 / SparseSGD.Scaling.Helps.Lmin d B ν beta eta ps)) ∧
          (∀ (eta : ℝ),
              eta = 2 / (↑(ps 0) + ↑(ps (Fin.last n))) →
                1 < SparseSGD.Scaling.Helps.kappaV ps →
                  (SparseSGD.Scaling.Helps.rhoMax0 0 eta ps =
                        ((SparseSGD.Scaling.Helps.kappaV ps - 1) / (SparseSGD.Scaling.Helps.kappaV ps + 1)) ^ 2 ∧
                      ∀ (j : Fin (n + 1)),
                        SparseSGD.Scaling.Helps.stepRadius (SparseSGD.Scaling.Helps.copyParams0 0 eta ps j) < 1) ∧
                    (SparseSGD.Scaling.Helps.Lmin0 0 eta ps =
                          2 *
                            Real.log
                              ((SparseSGD.Scaling.Helps.kappaV ps + 1) / (SparseSGD.Scaling.Helps.kappaV ps - 1)) ∧
                        1 / SparseSGD.Scaling.Helps.Lmin0 0 eta ps ≤ SparseSGD.Scaling.Helps.kappaV ps / 4) ∧
                      Filter.Tendsto (fun B' => SparseSGD.Scaling.Helps.rhoMax d B' ν 0 eta ps) Filter.atTop
                          (nhds
                            (((SparseSGD.Scaling.Helps.kappaV ps - 1) / (SparseSGD.Scaling.Helps.kappaV ps + 1)) ^ 2)) ∧
                        Filter.Tendsto (fun B' => SparseSGD.Scaling.Helps.Lmin d B' ν 0 eta ps) Filter.atTop
                            (nhds
                              (2 *
                                Real.log
                                  ((SparseSGD.Scaling.Helps.kappaV ps + 1) /
                                    (SparseSGD.Scaling.Helps.kappaV ps - 1)))) ∧
                          ∀ᶠ (B' : ℕ) in Filter.atTop,
                            ∀ (j : Fin (n + 1)),
                              SparseSGD.Scaling.Helps.stepRadius
                                  (SparseSGD.Scaling.Helps.copyParams d B' ν 0 eta ps j) <
                                1) ∧
            (∀ (beta eta : ℝ),
                0 < beta →
                  beta < 1 →
                    0 ≤ eta →
                      ∀ (j : Fin (n + 1)),
                        beta ≤ SparseSGD.Scaling.Helps.stepRadius (SparseSGD.Scaling.Helps.copyParams0 beta eta ps j) ∧
                          (SparseSGD.Scaling.Helps.stepRadius (SparseSGD.Scaling.Helps.copyParams0 beta eta ps j) =
                              beta ↔
                            (1 - √beta) ^ 2 ≤ eta * (1 - beta) * ↑(ps j) ∧
                              eta * (1 - beta) * ↑(ps j) ≤ (1 + √beta) ^ 2)) ∧
              (∀ (beta eta : ℝ),
                  0 < beta →
                    beta < 1 →
                      1 < SparseSGD.Scaling.Helps.kappaV ps →
                        √beta =
                            (√(SparseSGD.Scaling.Helps.kappaV ps) - 1) / (√(SparseSGD.Scaling.Helps.kappaV ps) + 1) →
                          eta * (1 - beta) * ↑(ps 0) = (1 + √beta) ^ 2 →
                            ((∀ (j : Fin (n + 1)),
                                  SparseSGD.Scaling.Helps.stepRadius
                                      (SparseSGD.Scaling.Helps.copyParams0 beta eta ps j) =
                                    beta) ∧
                                SparseSGD.Scaling.Helps.rhoMax0 beta eta ps = beta ∧
                                  (∀ (j : Fin (n + 1)),
                                      (SparseSGD.Scaling.Helps.copyParams0 beta eta ps j).curvature < 1) ∧
                                    SparseSGD.Scaling.Helps.Lmin0 beta eta ps = -Real.log beta ∧
                                      1 / SparseSGD.Scaling.Helps.Lmin0 beta eta ps ≤
                                        √(SparseSGD.Scaling.Helps.kappaV ps) / 4) ∧
                              Filter.Tendsto (fun B' => SparseSGD.Scaling.Helps.rhoMax d B' ν beta eta ps) Filter.atTop
                                  (nhds beta) ∧
                                Filter.Tendsto (fun B' => SparseSGD.Scaling.Helps.Lmin d B' ν beta eta ps) Filter.atTop
                                    (nhds (-Real.log beta)) ∧
                                  ∀ᶠ (B' : ℕ) in Filter.atTop,
                                    ∀ (j : Fin (n + 1)),
                                      SparseSGD.Scaling.Helps.stepRadius
                                          (SparseSGD.Scaling.Helps.copyParams d B' ν beta eta ps j) <
                                        1) ∧
                ((↑B - 1) * (↑(ps 0) - ↑(ps (Fin.last n))) ≤ ↑d + 2 →
                    IsGreatest (SparseSGD.Scaling.Helps.sgdLminSet d B ν ps)
                        (Real.log (1 + ↑B * ↑(ps (Fin.last n)) / (↑d + 2 - ↑(ps (Fin.last n))))) ∧
                      (0 < SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n)) ∧
                          (∀ (j : Fin (n + 1)),
                              SparseSGD.Scaling.Helps.stepRadius
                                  (SparseSGD.Scaling.Helps.copyParams d B ν 0
                                    (SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n))) ps j) <
                                1) ∧
                            SparseSGD.Scaling.Helps.Lmin d B ν 0
                                (SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n))) ps =
                              Real.log (1 + ↑B * ↑(ps (Fin.last n)) / (↑d + 2 - ↑(ps (Fin.last n))))) ∧
                        ∀ (j : Fin (n + 1)),
                          1 ≤
                              SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n)) /
                                SparseSGD.Scaling.Helps.etaStar d B ↑(ps j) ∧
                            SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n)) /
                                SparseSGD.Scaling.Helps.etaStar d B ↑(ps j) <
                              2) ∧
                  (↑d + 2 < (↑B - 1) * (↑(ps 0) - ↑(ps (Fin.last n))) →
                      IsGreatest (SparseSGD.Scaling.Helps.sgdLminSet d B ν ps)
                          (-Real.log
                              (1 -
                                4 * ↑B * (↑B - 1) * ↑(ps 0) * ↑(ps (Fin.last n)) /
                                  SparseSGD.Scaling.Helps.DB d B ps ^ 2)) ∧
                        (0 < 2 * ↑B / SparseSGD.Scaling.Helps.DB d B ps ∧
                            (∀ (j : Fin (n + 1)),
                                SparseSGD.Scaling.Helps.stepRadius
                                    (SparseSGD.Scaling.Helps.copyParams d B ν 0
                                      (2 * ↑B / SparseSGD.Scaling.Helps.DB d B ps) ps j) <
                                  1) ∧
                              SparseSGD.Scaling.Helps.Lmin d B ν 0 (2 * ↑B / SparseSGD.Scaling.Helps.DB d B ps) ps =
                                -Real.log
                                    (1 -
                                      4 * ↑B * (↑B - 1) * ↑(ps 0) * ↑(ps (Fin.last n)) /
                                        SparseSGD.Scaling.Helps.DB d B ps ^ 2)) ∧
                          ∀ (j : Fin (n + 1)),
                            2 * ↑B / SparseSGD.Scaling.Helps.DB d B ps <
                              SparseSGD.Probability.LeastSquares.criticalRate d B (ps j) 0) ∧
                    (SparseSGD.Scaling.Helps.sgdGain d B (↑(ps (Fin.last n)))
                            (SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n))) ≤
                          SparseSGD.Scaling.Helps.sgdGain d B (↑(ps 0))
                            (SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n))) ↔
                        (↑B - 1) * (↑(ps 0) - ↑(ps (Fin.last n))) ≤ ↑d + 2) ∧
                      (↑d + 2 < (↑B - 1) * (↑(ps 0) - ↑(ps (Fin.last n))) →
                        SparseSGD.Scaling.Helps.Lmin d B ν 0 (SparseSGD.Scaling.Helps.etaStar d B ↑(ps (Fin.last n)))
                            ps <
                          -Real.log
                              (1 -
                                4 * ↑B * (↑B - 1) * ↑(ps 0) * ↑(ps (Fin.last n)) /
                                  SparseSGD.Scaling.Helps.DB d B ps ^ 2))
SparseSGD.Scaling.Helps.lem_ray {nu : ℝ} (hnu : 0 < nu) :
  IsGreatest ((fun D => SparseSGD.continuumPerronRate D (nu * D / 2)) '' Set.Ioo 0 (2 / nu))
    (SparseSGD.Scaling.Helps.rayRate nu)
SparseSGD.Scaling.Helps.lem_ray_bundle {nu : ℝ} (hnu : 0 < nu) :
  IsGreatest ((fun D => SparseSGD.continuumPerronRate D (nu * D / 2)) '' Set.Ioo 0 (2 / nu))
      (SparseSGD.Scaling.Helps.rayRate nu) ∧
    (∀ D ∈ Set.Ioo 0 (2 / nu),
        SparseSGD.continuumPerronRate D (nu * D / 2) = SparseSGD.Scaling.Helps.rayRate nu →
          D = SparseSGD.Scaling.Helps.rayDelta nu) ∧
      1 / SparseSGD.Scaling.Helps.rayRate nu = (1 + nu + √(1 + nu ^ 2)) / 2
SparseSGD.Scaling.Helps.lem_ray_sSup {nu : ℝ} (hnu : 0 < nu) :
  sSup ((fun D => SparseSGD.continuumPerronRate D (nu * D / 2)) '' Set.Ioo 0 (2 / nu)) =
    SparseSGD.Scaling.Helps.rayRate nu
SparseSGD.Scaling.Helps.lem_ray_unique {nu : ℝ} (hnu : 0 < nu) {D : ℝ} (_hD : D ∈ Set.Ioo 0 (2 / nu))
  (hmax : SparseSGD.continuumPerronRate D (nu * D / 2) = SparseSGD.Scaling.Helps.rayRate nu) :
  D = SparseSGD.Scaling.Helps.rayDelta nu
SparseSGD.Scaling.Helps.lem_small_delta {eps Delta un a u : ℝ} (he0 : 0 < eps) (he : eps ≤ 1 / 50) (hD0 : 0 < Delta)
  (hD : Delta ≤ 1 / 50) (hun : 0 ≤ un) (hu : u = un + eps ^ 2 * Delta / (2 * (2 - eps))) (hu1 : u < 1) :
  0 < SparseSGD.Scaling.Helps.stepRadius { beta := 1 - eps, w := eps ^ 2 * Delta, noise := un, additive := a } ∧
    SparseSGD.Scaling.Helps.stepRadius { beta := 1 - eps, w := eps ^ 2 * Delta, noise := un, additive := a } < 1 ∧
      (∃ zs,
          SparseSGD.Scaling.Helps.spectrumQ eps Delta u ↑zs = 0 ∧
            -6e-2 < zs ∧
              zs < 0 ∧
                SparseSGD.Scaling.Helps.stepRadius
                    { beta := 1 - eps, w := eps ^ 2 * Delta, noise := un, additive := a } =
                  1 + eps * zs) ∧
        |SparseSGD.Scaling.Helps.perStepRate { beta := 1 - eps, w := eps ^ 2 * Delta, noise := un, additive := a } -
                2 * eps * Delta * (1 - u)| ≤
            25 * (eps + Delta) * (2 * eps * Delta * (1 - u)) ∧
          ∃ ϑ,
            |ϑ| ≤ 25 * (eps + Delta) ∧
              SparseSGD.Scaling.Helps.perStepRate
                  { beta := 1 - eps, w := eps ^ 2 * Delta, noise := un, additive := a } =
                2 * eps * Delta * (1 - u) * (1 + ϑ)
SparseSGD.Scaling.Helps.lem_small_delta_ratio {eps Delta u : ℝ} (he0 : 0 < eps) (he : eps ≤ 1 / 50) (hD0 : 0 < Delta)
  (hD : Delta ≤ 1 / 50) (hu0 : 0 ≤ u) (hu1 : u < 1) :
  ∃ ϑ3,
    |ϑ3| ≤ 3 * (eps + Delta) ∧
      2 * Delta * (2 - eps) * (1 - u) / (2 + 4 * Delta + eps * SparseSGD.Scaling.Helps.spectrumB1 eps Delta u) =
        2 * Delta * (1 - u) * (1 + ϑ3)
SparseSGD.Scaling.Helps.lem_small_delta_theta2 {eps Delta un a u : ℝ} (he0 : 0 < eps) (he : eps ≤ 1 / 50)
  (hD0 : 0 < Delta) (hD : Delta ≤ 1 / 50) (hun : 0 ≤ un) (hu : u = un + eps ^ 2 * Delta / (2 * (2 - eps)))
  (hu1 : u < 1) :
  ∃ zs,
    SparseSGD.Scaling.Helps.spectrumQ eps Delta u ↑zs = 0 ∧
      -6e-2 < zs ∧
        zs < 0 ∧
          ∃ ϑ2,
            0 ≤ ϑ2 ∧
              ϑ2 ≤ eps ∧
                SparseSGD.Scaling.Helps.perStepRate
                    { beta := 1 - eps, w := eps ^ 2 * Delta, noise := un, additive := a } =
                  eps * |zs| * (1 + ϑ2)
SparseSGD.Scaling.Helps.lem_speedup :
  (∀ (u : ℝ),
      0 < u →
        u < 1 →
          (∀ (D : ℝ), 0 < D → SparseSGD.Scaling.Helps.speedupRatio D u < 2) ∧
            SparseSGD.Scaling.Helps.speedupRatio (1 / 4) u = 2 / (1 + u ^ (1 / 3) + (u ^ (1 / 3)) ^ 2) ∧
              ((fun D => SparseSGD.Scaling.Helps.speedupRatio D u - 1 - (1 - 3 * u) * D) =O[nhdsWithin 0 (Set.Ioi 0)]
                  fun D => D ^ 2) ∧
                (1 / 3 ≤ u →
                    (∀ (D : ℝ), 0 < D → SparseSGD.Scaling.Helps.speedupRatio D u < 1) ∧
                      sSup ((fun D => SparseSGD.Scaling.Helps.speedupRatio D u) '' Set.Ioi 0) = 1) ∧
                  (u < 1 / 3 → ∀ᶠ (D : ℝ) in nhdsWithin 0 (Set.Ioi 0), 1 < SparseSGD.Scaling.Helps.speedupRatio D u)) ∧
    Filter.Tendsto (fun u => sSup ((fun D => SparseSGD.Scaling.Helps.speedupRatio D u) '' Set.Ioi 0))
      (nhdsWithin 0 (Set.Ioo 0 1)) (nhds 2)
SparseSGD.Scaling.Helps.lem_stab_all (jury : SparseSGD.External.JuryStability) (p : SparseSGD.Params) (hb0 : 0 ≤ p.beta)
  (hb1 : p.beta < 1) (hw : 0 < p.w) (hun : 0 ≤ p.noise) :
  (2 * (1 + p.beta) ≤ p.w →
      1 ≤ p.curvature ∧ p.curvature ≤ p.totalLoad ∧ 1 ≤ p.totalLoad ∧ 1 ≤ SparseSGD.Scaling.Helps.stepRadius p) ∧
    (SparseSGD.Scaling.Helps.stepRadius p < 1 ↔ p.totalLoad < 1)
SparseSGD.Scaling.Helps.lem_stab_all_large_w (p : SparseSGD.Params) (hb0 : 0 ≤ p.beta) (hb1 : p.beta < 1)
  (hun : 0 ≤ p.noise) (hw : 2 * (1 + p.beta) ≤ p.w) :
  1 ≤ p.curvature ∧ p.curvature ≤ p.totalLoad ∧ 1 ≤ p.totalLoad ∧ 1 ≤ SparseSGD.Scaling.Helps.stepRadius p
SparseSGD.Scaling.Helps.lem_step_speed (p : SparseSGD.Params) (Delta : ℝ) (hb0 : 0 ≤ p.beta) (hb1 : p.beta < 1)
  (hw : 0 < p.w) (hun : 0 ≤ p.noise) (hDelta : p.w = p.eps ^ 2 * Delta) :
  (p.beta ≤ SparseSGD.Scaling.Helps.meanRadius p.beta p.w ^ 2 ∧
      SparseSGD.Scaling.Helps.meanRadius p.beta p.w ^ 2 ≤ SparseSGD.Scaling.Helps.stepRadius p ∧
        (p.noise = 0 → SparseSGD.Scaling.Helps.stepRadius p = SparseSGD.Scaling.Helps.meanRadius p.beta p.w ^ 2) ∧
          (0 < p.beta → SparseSGD.Scaling.Helps.perStepRate p ≤ -Real.log p.beta)) ∧
    (4 * p.eps * Delta < 1 →
      1 - 4 * p.eps * Delta ≤ SparseSGD.Scaling.Helps.stepRadius p ∧
        SparseSGD.Scaling.Helps.perStepRate p ≤ -Real.log (1 - 4 * p.eps * Delta))
SparseSGD.Scaling.Helps.lsLamStar_bounds_large_nu {d B : ℕ} {p : ↑unitInterval} {beta : ℝ} (ν : MeasureTheory.Measure ℝ)
  (hB : 0 < B) (hp : 0 < ↑p) (he : 0 < 1 - beta) (he50 : 1 - beta ≤ 1 / 50)
  (hs : 100 ≤ SparseSGD.Scaling.Helps.lsNu d B p beta) :
  (1 - beta) / SparseSGD.Scaling.Helps.lsNu d B p beta *
        (1 - 25 * (1 - beta + 1 / SparseSGD.Scaling.Helps.lsNu d B p beta)) ≤
      SparseSGD.Scaling.Helps.lsLamStar d B p ν beta ∧
    SparseSGD.Scaling.Helps.lsLamStar d B p ν beta ≤
      (1 - beta) / SparseSGD.Scaling.Helps.lsNu d B p beta *
        (1 + 25 * (1 - beta + 2 / SparseSGD.Scaling.Helps.lsNu d B p beta))
SparseSGD.Scaling.Helps.lsLamStar_close (nu0 : ℝ) (hnu0 : 0 < nu0) :
  ∃ eps1 ∈ Set.Ioc 0 (1 / 2),
    ∃ C,
      0 ≤ C ∧
        ∀ (d B : ℕ) (p : ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (beta : ℝ),
          0 < B →
            0 < ↑p →
              1 - beta ∈ Set.Ioc 0 eps1 →
                SparseSGD.Scaling.Helps.lsNu d B p beta ∈ Set.Icc (nu0 / 2) (2 * nu0) →
                  |SparseSGD.Scaling.Helps.lsLamStar d B p ν beta -
                        (1 - beta) * SparseSGD.Scaling.Helps.rayRate (SparseSGD.Scaling.Helps.lsNu d B p beta)| ≤
                    C * (1 - beta) ^ (4 / 3)
SparseSGD.Scaling.Helps.lsLamStar_le_neg_log_beta {d B : ℕ} {p : ↑unitInterval} {beta : ℝ} (hB : 0 < B) (hp : 0 < ↑p)
  (ν : MeasureTheory.Measure ℝ) (hb0 : 0 < beta) (hb1 : beta < 1) :
  SparseSGD.Scaling.Helps.lsLamStar d B p ν beta ≤ -Real.log beta
SparseSGD.Scaling.Helps.lsLamStar_lower_small_nu :
  ∃ eps0,
    0 < eps0 ∧
      eps0 ≤ 1 / 2 ∧
        ∃ C1,
          0 ≤ C1 ∧
            ∀ (d B : ℕ) (p : ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (beta : ℝ),
              0 < B →
                0 < ↑p →
                  0 < 1 - beta →
                    1 - beta ≤ eps0 →
                      SparseSGD.Scaling.Helps.lsNu d B p beta ≤ 1 →
                        (1 - beta) * (1 - SparseSGD.Scaling.Helps.lsNu d B p beta ^ (1 / 3)) -
                              C1 * (1 - beta) ^ (4 / 3) ≤
                            SparseSGD.Scaling.Helps.lsLamStar d B p ν beta ∧
                          (1 - beta) / 20 ≤ SparseSGD.Scaling.Helps.lsLamStar d B p ν beta
SparseSGD.Scaling.Helps.lsLamStar_pos {d B : ℕ} {p : ↑unitInterval} {beta : ℝ} (jury : SparseSGD.External.JuryStability)
  (hB : 0 < B) (hp : 0 < ↑p) (ν : MeasureTheory.Measure ℝ) (hb0 : 0 < beta) (hb1 : beta < 1) :
  0 < SparseSGD.Scaling.Helps.lsLamStar d B p ν beta
SparseSGD.Scaling.Helps.lsLamStar_zero_eq {d B : ℕ} {p : ↑unitInterval} (hB : 0 < B) (hp : 0 < ↑p)
  (ν : MeasureTheory.Measure ℝ) : SparseSGD.Scaling.Helps.lsLamStar d B p ν 0 = Real.log (1 + ↑p * ↑B / (↑d + 2 - ↑p))
SparseSGD.Scaling.Helps.lsLamStar_zero_ge {d B : ℕ} {p : ↑unitInterval} (hB : 0 < B) (hp : 0 < ↑p)
  (ν : MeasureTheory.Measure ℝ) :
  ↑p * SparseSGD.Probability.LeastSquares.criticalRate d B p 0 / 2 ≤ SparseSGD.Scaling.Helps.lsLamStar d B p ν 0
SparseSGD.Scaling.Helps.lsNfoldSGD_eq {d B : ℕ} {p : ↑unitInterval} (hB : 0 < B) (hp : 0 < ↑p)
  (ν : MeasureTheory.Measure ℝ) :
  SparseSGD.Scaling.Helps.lsNfoldSGD d B p ν = ↑p * ↑B / Real.log (1 + ↑p * ↑B / (↑d + 2 - ↑p))
SparseSGD.Scaling.Helps.lsNfoldSGD_le {d B : ℕ} {p : ↑unitInterval} (hB : 0 < B) (hp : 0 < ↑p)
  (ν : MeasureTheory.Measure ℝ) :
  SparseSGD.Scaling.Helps.lsNfoldSGD d B p ν ≤ 2 * ↑B / SparseSGD.Probability.LeastSquares.criticalRate d B p 0
SparseSGD.Scaling.Helps.lsNfoldSGD_le_max {d B : ℕ} {p : ↑unitInterval} {beta : ℝ} (hB : 0 < B) (hp : 0 < ↑p)
  (ν : MeasureTheory.Measure ℝ) (hb0 : 0 ≤ beta) (hb1 : beta < 1) :
  SparseSGD.Scaling.Helps.lsNfoldSGD d B p ν ≤
      SparseSGD.Scaling.Helps.lsNstab d B p beta + (1 - beta) * SparseSGD.Scaling.Helps.lsNmem B p beta ∧
    SparseSGD.Scaling.Helps.lsNstab d B p beta + (1 - beta) * SparseSGD.Scaling.Helps.lsNmem B p beta ≤
      (1 + (1 - beta)) * max (SparseSGD.Scaling.Helps.lsNstab d B p beta) (SparseSGD.Scaling.Helps.lsNmem B p beta)
SparseSGD.Scaling.Helps.lsNfoldSGD_mono {d : ℕ} {p : ↑unitInterval} (hp : 0 < ↑p) (ν : MeasureTheory.Measure ℝ)
  {B1 B2 : ℕ} (h1 : 1 ≤ B1) (h12 : B1 ≤ B2) :
  SparseSGD.Scaling.Helps.lsNfoldSGD d B1 p ν ≤ SparseSGD.Scaling.Helps.lsNfoldSGD d B2 p ν
SparseSGD.Scaling.Helps.lsNfold_div_hyperbola {d B : ℕ} {p : ↑unitInterval} {beta : ℝ} (ν : MeasureTheory.Measure ℝ)
  (hB : 0 < B) (hp : 0 < ↑p) (hb0 : 0 ≤ beta) (hb1 : beta < 1) :
  SparseSGD.Scaling.Helps.lsNfold d B p ν beta /
      SparseSGD.Scaling.Helps.hyperbolaN (SparseSGD.Scaling.Helps.lsNstab d B p beta)
        (SparseSGD.Scaling.Helps.lsNmem B p beta) =
    (1 - beta) * SparseSGD.Scaling.Helps.rayRate (SparseSGD.Scaling.Helps.lsNu d B p beta) /
      SparseSGD.Scaling.Helps.lsLamStar d B p ν beta
SparseSGD.Scaling.Helps.lsNfold_ge_retention {d B : ℕ} {p : ↑unitInterval} {beta : ℝ}
  (jury : SparseSGD.External.JuryStability) (hB : 0 < B) (hp : 0 < ↑p) (ν : MeasureTheory.Measure ℝ) (hb0 : 0 < beta)
  (hb1 : beta < 1) : ↑p * ↑B / -Real.log beta ≤ SparseSGD.Scaling.Helps.lsNfold d B p ν beta
SparseSGD.Scaling.Helps.lsNstab_eq_explicit {d B : ℕ} {p : ↑unitInterval} {beta : ℝ} (hB : 0 < B) (hb0 : 0 ≤ beta) :
  SparseSGD.Scaling.Helps.lsNstab d B p beta = ↑d + 2 - ↑p + ↑p * ↑B * (1 - beta) / (2 - (1 - beta))
SparseSGD.Scaling.Helps.lsNstab_eq_nu_mul {d B : ℕ} {p : ↑unitInterval} {beta : ℝ} (hB : 0 < B) (hb0 : 0 ≤ beta)
  (hb1 : beta < 1) (hp : 0 < ↑p) :
  SparseSGD.Scaling.Helps.lsNstab d B p beta =
    SparseSGD.Scaling.Helps.lsNu d B p beta * SparseSGD.Scaling.Helps.lsNmem B p beta
SparseSGD.Scaling.Helps.lsNstab_zero_sub_le {d B : ℕ} {p : ↑unitInterval} {beta : ℝ} (hB : 0 < B) (hb0 : 0 ≤ beta)
  (hb1 : beta < 1) (hp : 0 < ↑p) :
  2 * ↑B / SparseSGD.Probability.LeastSquares.criticalRate d B p 0 - SparseSGD.Scaling.Helps.lsNstab d B p beta ≤
    (1 - beta) * SparseSGD.Scaling.Helps.lsNmem B p beta
SparseSGD.Scaling.Helps.lsNuNoise_eq {d B : ℕ} {p : ↑unitInterval} {beta : ℝ} (hB : 0 < B) (hb0 : 0 ≤ beta)
  (hb1 : beta < 1) (hp : 0 < ↑p) :
  SparseSGD.Scaling.Helps.lsNuNoise d B p beta =
    SparseSGD.Scaling.Helps.lsNu d B p beta - (1 - beta) ^ 2 / (2 - (1 - beta))
SparseSGD.Scaling.Helps.lsNuNoise_lt {d B : ℕ} {p : ↑unitInterval} {beta : ℝ} (hB : 0 < B) (hb0 : 0 ≤ beta)
  (hb1 : beta < 1) (hp : 0 < ↑p) :
  SparseSGD.Scaling.Helps.lsNuNoise d B p beta < SparseSGD.Scaling.Helps.lsNu d B p beta
SparseSGD.Scaling.Helps.lsNuNoise_pos {d B : ℕ} {p : ↑unitInterval} {beta : ℝ} (hB : 0 < B) (hb1 : beta < 1)
  (hp : 0 < ↑p) : 0 < SparseSGD.Scaling.Helps.lsNuNoise d B p beta
SparseSGD.Scaling.Helps.lsRate_close (nu0 : ℝ) (hnu0 : 0 < nu0) :
  ∃ eps1 ∈ Set.Ioc 0 (1 / 2),
    ∃ C,
      0 ≤ C ∧
        ∀ (d B : ℕ) (p : ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (beta : ℝ),
          0 < B →
            0 < ↑p →
              1 - beta ∈ Set.Ioc 0 eps1 →
                SparseSGD.Scaling.Helps.lsNu d B p beta ∈ Set.Icc (nu0 / 2) (2 * nu0) →
                  ∀ eta ∈ Set.Ioo 0 (SparseSGD.Probability.LeastSquares.criticalRate d B p beta),
                    |SparseSGD.Scaling.Helps.lsRate d B p ν beta eta -
                          (1 - beta) *
                            SparseSGD.continuumPerronRate (eta * ↑p / (1 - beta))
                              (SparseSGD.Scaling.Helps.lsNu d B p beta * (eta * ↑p / (1 - beta)) / 2)| ≤
                      C * (1 - beta) ^ (4 / 3)
SparseSGD.Scaling.Helps.lsRate_le_neg_log_beta {d B : ℕ} {p : ↑unitInterval} {beta : ℝ} (hB : 0 < B) (hp : 0 < ↑p)
  (ν : MeasureTheory.Measure ℝ) (hb0 : 0 < beta) (hb1 : beta < 1) {eta : ℝ}
  (he : eta ∈ Set.Ioo 0 (SparseSGD.Probability.LeastSquares.criticalRate d B p beta)) :
  SparseSGD.Scaling.Helps.lsRate d B p ν beta eta ≤ -Real.log beta
SparseSGD.Scaling.Helps.lsRate_ray_approx {d B : ℕ} {p : ↑unitInterval} {beta : ℝ} (ν : MeasureTheory.Measure ℝ)
  (hB : 0 < B) (hp : 0 < ↑p) (he : 0 < 1 - beta) (he50 : 1 - beta ≤ 1 / 50)
  (hs : 100 ≤ SparseSGD.Scaling.Helps.lsNu d B p beta) {eta : ℝ}
  (heta : eta ∈ Set.Ioo 0 (SparseSGD.Probability.LeastSquares.criticalRate d B p beta)) :
  0 < eta * ↑p / (1 - beta) ∧
    eta * ↑p / (1 - beta) < 2 / SparseSGD.Scaling.Helps.lsNu d B p beta ∧
      |SparseSGD.Scaling.Helps.lsRate d B p ν beta eta -
            (1 - beta) *
              (2 * (eta * ↑p / (1 - beta)) - SparseSGD.Scaling.Helps.lsNu d B p beta * (eta * ↑p / (1 - beta)) ^ 2)| ≤
        25 * (1 - beta + eta * ↑p / (1 - beta)) *
          ((1 - beta) *
            (2 * (eta * ↑p / (1 - beta)) - SparseSGD.Scaling.Helps.lsNu d B p beta * (eta * ↑p / (1 - beta)) ^ 2))
