  (he0 : MeasureTheory.MemLp (fun s => s.1 j) 2 ρ) (hq0 : MeasureTheory.MemLp (fun s => s.2 j) 2 ρ) (k : ℕ) :
  (SparseSGD.Probability.LeastSquares.integratedMoments (SparseSGD.Scaling.Helps.VocabRows.vWorldLaw ps ν ρ)
