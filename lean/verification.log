SparseSGD.Logistic.process_conditional_bulk_drift {d B : ℕ} (H : SparseSGD.External.GaussianSteinCertificate d)
  (hB : 0 < B) (eta beta : ℝ) (p : ↑unitInterval) (mu : SparseSGD.Logistic.Vec d) (hr : 0 < SparseSGD.Logistic.r mu)
  (hp0 : 0 < ↑p) (hp1 : ↑p < 1) (ρ : MeasureTheory.Measure (SparseSGD.Logistic.State d))
  [MeasureTheory.IsProbabilityMeasure ρ] (hθ0 : MeasureTheory.MemLp (fun s => s.1) 2 ρ)
  (hm0 : MeasureTheory.MemLp (fun s => s.2) 2 ρ) (k : ℕ) :
  ((SparseSGD.Logistic.worldLaw p ρ)[fun ω =>
        ‖SparseSGD.Logistic.bulkPart mu (SparseSGD.Logistic.process eta beta p mu ω (k + 1)).1‖ ^ 2 |
        SparseSGD.Logistic.pastSigma d B k] =ᵐ[SparseSGD.Logistic.worldLaw p ρ]
      fun ω => (SparseSGD.Logistic.stepBulkMoments eta beta p mu (SparseSGD.Logistic.process eta beta p mu ω k)).R) ∧
    ((SparseSGD.Logistic.worldLaw p ρ)[fun ω =>
          ‖eta • SparseSGD.Logistic.bulkPart mu (SparseSGD.Logistic.process eta beta p mu ω (k + 1)).2‖ ^ 2 |
          SparseSGD.Logistic.pastSigma d B k] =ᵐ[SparseSGD.Logistic.worldLaw p ρ]
        fun ω => (SparseSGD.Logistic.stepBulkMoments eta beta p mu (SparseSGD.Logistic.process eta beta p mu ω k)).V) ∧
