  SparseSGD.Scaling.Helps.Lmin0 beta eta ps =
      2 * Real.log ((SparseSGD.Scaling.Helps.kappaV ps + 1) / (SparseSGD.Scaling.Helps.kappaV ps - 1)) ∧
    1 / SparseSGD.Scaling.Helps.Lmin0 beta eta ps ≤ SparseSGD.Scaling.Helps.kappaV ps / 4
SparseSGD.Scaling.Helps.sgd_coeff_bounds (p : SparseSGD.Params) (hb : p.beta = 0) (hw : 0 < p.w) (hun : 0 ≤ p.noise)
  (hu : p.totalLoad < 1) :
  0 ≤ 1 - 2 * p.w * (1 - p.totalLoad) ∧
    1 - 2 * p.w * (1 - p.totalLoad) < 1 ∧
      SparseSGD.Scaling.Helps.perStepRate p = -Real.log (1 - 2 * p.w * (1 - p.totalLoad))
SparseSGD.Scaling.Helps.sgd_inv_Lmin_ge_first {n d B : ℕ} {ν : MeasureTheory.Measure ℝ} {beta eta : ℝ}
  {ps : Fin (n + 1) → ↑unitInterval} (hB : 0 < B) (hp : ∀ (j : Fin (n + 1)), 0 < ↑(ps j)) (hη : 0 < eta) (hβ : beta = 0)
  (hstab :
    ∀ (j : Fin (n + 1)),
