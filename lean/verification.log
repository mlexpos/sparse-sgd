SparseSGD.curvature_noise_tendsto (p : ℕ → SparseSGD.Params) (w u : ℝ)
  (hb : Filter.Tendsto (fun n => (p n).beta) Filter.atTop (nhds 1))
  (hw : Filter.Tendsto (fun n => (p n).w) Filter.atTop (nhds w))
  (hu : Filter.Tendsto (fun n => (p n).noise) Filter.atTop (nhds u)) (hw4 : w < 4) :
  Filter.Tendsto (fun n => (p n).renormNoise) Filter.atTop (nhds (u / (1 - w / 4)))
SparseSGD.curvature_only_rate (w : ℝ) : 1 - 0 / (1 - w / 4) = 1
SparseSGD.curvature_perronRate_tendsto (p : ℕ → SparseSGD.Params) (w u : ℝ)
  (hb : Filter.Tendsto (fun n => (p n).beta) Filter.atTop (nhds 1))
