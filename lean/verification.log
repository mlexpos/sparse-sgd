SparseSGD.Scaling.Helps.sgd_Lmin0 {n : ℕ} {beta eta : ℝ} {ps : Fin (n + 1) → ↑unitInterval}
  (hp : ∀ (j : Fin (n + 1)), 0 < ↑(ps j)) (hanti : Antitone ps) (hβ : beta = 0)
