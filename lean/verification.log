SparseSGD.trajectory_risk_tendsto_floor (jury : SparseSGD.External.JuryStability) (p : SparseSGD.Params)
  (s : SparseSGD.Moments) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1) (hw0 : 0 < p.w) (hw1 : p.w < 2 * (1 + p.beta))
