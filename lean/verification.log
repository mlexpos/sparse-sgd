    ∀ μ ∈ SparseSGD.Scaling.Helps.cubicRoots a2 a1 a0,
      ∃ z ∈ SparseSGD.Scaling.Helps.cubicRoots b2 b1 b0,
        ‖μ - z‖ ≤ (‖a2 - b2‖ * M ^ 2 + ‖a1 - b1‖ * M + ‖a0 - b0‖) ^ (1 / 3)
SparseSGD.Scaling.Helps.cubicRoots_norm_le {a2 a1 a0 z : ℂ} (hz : z ∈ SparseSGD.Scaling.Helps.cubicRoots a2 a1 a0) :
  ‖z‖ ≤ 1 + max ‖a2‖ (max ‖a1‖ ‖a0‖)
SparseSGD.Scaling.Helps.cubicRoots_norm_le_sum {a2 a1 a0 z : ℂ} (hz : z ∈ SparseSGD.Scaling.Helps.cubicRoots a2 a1 a0) :
