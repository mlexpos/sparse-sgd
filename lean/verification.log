  SparseSGD.Logistic.summary mu s = SparseSGD.Logistic.summary mu t ↔
    ∃ O, O mu = mu ∧ SparseSGD.Logistic.rotateState O s = t
SparseSGD.Logistic.summary_transition_eq {d B : ℕ} (eta beta : ℝ) (p : ↑unitInterval) (mu : SparseSGD.Logistic.Vec d)
  (hr : 0 < SparseSGD.Logistic.r mu) (s t : SparseSGD.Logistic.State d)
  (hs : SparseSGD.Logistic.summary mu s = SparseSGD.Logistic.summary mu t) :
  MeasureTheory.Measure.map (fun a => SparseSGD.Logistic.summary mu (SparseSGD.Logistic.update eta beta p mu s a))
      (SparseSGD.Logistic.batchLaw d B p) =
    MeasureTheory.Measure.map (fun a => SparseSGD.Logistic.summary mu (SparseSGD.Logistic.update eta beta p mu t a))
      (SparseSGD.Logistic.batchLaw d B p)
SparseSGD.Logistic.tameError_source_formula {d : ℕ} (p : ↑unitInterval) (mu theta : SparseSGD.Logistic.Vec d)
  (hr : 0 < SparseSGD.Logistic.r mu) :
  SparseSGD.Logistic.tameError p mu theta =
    ↑p *
      (Real.exp (2 * ‖theta‖ ^ 2 - SparseSGD.Logistic.r mu ^ 2) +
          Real.exp ((3 * ‖theta‖ ^ 2 - SparseSGD.Logistic.r mu ^ 2) / 2) +
        (1 + SparseSGD.Logistic.gaussianAlpha mu theta) *
          Real.exp (SparseSGD.Logistic.r mu * |SparseSGD.Logistic.signalCoord mu theta|))
SparseSGD.Logistic.tame_batch_projection_mgf {d B : ℕ}
  (H : SparseSGD.External.BernsteinMomentsCertificate (SparseSGD.Logistic.Sample d)) (p : ↑unitInterval)
  (mu theta u : SparseSGD.Logistic.Vec d) (Q t : ℝ) (hB : 0 < B) (hp : 0 < ↑p)
  (htame : SparseSGD.Logistic.tameError p mu theta ≤ 1 / 2) (hθ : ‖theta‖ ≤ Q) (hu : ‖u‖ ≤ 1)
  (ht : |t| * (SparseSGD.Logistic.projectionScale mu / ↑B) < 1) :
  MeasureTheory.Integrable (fun a => Real.exp (t * inner ℝ u (SparseSGD.Logistic.centeredBatchGradient p mu theta a)))
      (SparseSGD.Logistic.batchLaw d B p) ∧
    ∫ (a : SparseSGD.Logistic.Batch d B),
        Real.exp
          (t * inner ℝ u (SparseSGD.Logistic.centeredBatchGradient p mu theta a)) ∂SparseSGD.Logistic.batchLaw d B p ≤
      Real.exp
        (t ^ 2 * (SparseSGD.Logistic.projectionVariance p mu Q / ↑B) /
          (2 * (1 - |t| * (SparseSGD.Logistic.projectionScale mu / ↑B))))
SparseSGD.Logistic.tame_bulk_square_mgf {d B : ℕ}
  (H : ∀ (n : ℕ), SparseSGD.External.BernsteinMomentsCertificate (SparseSGD.Logistic.Sample n))
  (J : ∀ (n : ℕ), SparseSGD.External.HoeffdingCertificate (SparseSGD.Logistic.Sample n))
  (G : SparseSGD.External.GaussianQuadraticCertificate) (S : SparseSGD.External.GaussianSteinCertificate d)
  (p : ↑unitInterval) (mu theta momentum : SparseSGD.Logistic.Vec d) (Q t : ℝ) (hB : 0 < B) (hp : 0 < ↑p)
  (hr : 0 < SparseSGD.Logistic.r mu) (htame : SparseSGD.Logistic.tameError p mu theta ≤ 1 / 2) (hθ : ‖theta‖ ≤ Q)
  (ht : |t| * SparseSGD.Logistic.bulkQuadraticScale Q d B < 1) :
  MeasureTheory.Integrable (fun a => Real.exp (t * SparseSGD.Logistic.centeredBulkSquare p mu theta a))
      (SparseSGD.Logistic.batchLaw d B p) ∧
    ∫ (a : SparseSGD.Logistic.Batch d B),
        Real.exp (t * SparseSGD.Logistic.centeredBulkSquare p mu theta a) ∂SparseSGD.Logistic.batchLaw d B p ≤
      Real.exp
        (t ^ 2 * SparseSGD.Logistic.bulkQuadraticVariance Q p d B /
          (2 * (1 - |t| * SparseSGD.Logistic.bulkQuadraticScale Q d B)))
SparseSGD.Logistic.tame_coefficients {d : ℕ} (p : ↑unitInterval) (mu theta : SparseSGD.Logistic.Vec d) (hp0 : 0 < ↑p)
  (htame : SparseSGD.Logistic.tameError p mu theta ≤ 1 / 2) :
  |SparseSGD.Logistic.coefA p mu theta - ↑p * SparseSGD.Logistic.gaussianAlpha mu theta| ≤
      6 * ↑p * SparseSGD.Logistic.gaussianAlpha mu theta * SparseSGD.Logistic.tameError p mu theta ∧
    |SparseSGD.Logistic.coefB p mu theta + ↑p| ≤ 2 * ↑p * SparseSGD.Logistic.tameError p mu theta ∧
      |SparseSGD.Logistic.coefD0 p mu theta - ↑p| ≤ 6 * ↑p * SparseSGD.Logistic.tameError p mu theta ∧
        |SparseSGD.Logistic.coefDtheta p mu theta| ≤ 12 * ↑p * SparseSGD.Logistic.tameError p mu theta
SparseSGD.Logistic.tame_fixedPoint_covariance_tendsto {dim : ℕ → ℕ} (p : ℕ → ↑unitInterval)
  (mu theta : (n : ℕ) → SparseSGD.Logistic.Vec (dim n)) (beta C R : ℕ → ℝ) (P : ℝ) (hp : ∀ (n : ℕ), 0 < ↑(p n))
  (hb : ∀ (n : ℕ), 0 ≤ beta n ∧ beta n ≤ 1)
  (ht : ∀ (n : ℕ), SparseSGD.Logistic.tameError (p n) (mu n) (theta n) ≤ 1 / 12) (hR : ∀ (n : ℕ), 0 ≤ R n)
  (henergy : ∀ (n : ℕ), SparseSGD.Logistic.gaussianAlpha (mu n) (theta n) * R n ≤ P)
  (hcov : ∀ (n : ℕ), C n = -(1 - beta n) * SparseSGD.Logistic.coefA (p n) (mu n) (theta n) * R n / (1 + beta n))
  (hrare : Filter.Tendsto (fun n => ↑(p n)) Filter.atTop (nhds 0)) : Filter.Tendsto C Filter.atTop (nhds 0)
SparseSGD.Logistic.tame_scalarJets_first_second :
  ∃ C,
    0 ≤ C ∧
      ∀ (a b : ℕ),
        1 ≤ a + b →
          a + b ≤ 2 →
            ∀ {d : ℕ} (p : ↑unitInterval) (mu theta : SparseSGD.Logistic.Vec d),
              0 < SparseSGD.Logistic.r mu →
                0 < ↑p →
                  SparseSGD.Logistic.tameError p mu theta ≤ 1 / 2 →
                    SparseSGD.Logistic.TameScalarJetBounds a b C p mu theta
SparseSGD.Logistic.tame_unit_gradient_projection_moments {d : ℕ} (p : ↑unitInterval)
  (mu theta u : SparseSGD.Logistic.Vec d) (Q : ℝ) (hp : 0 < ↑p)
  (htame : SparseSGD.Logistic.tameError p mu theta ≤ 1 / 2) (hθ : ‖theta‖ ≤ Q) (hu : ‖u‖ ≤ 1) (n : ℕ) (hn : 2 ≤ n) :
  ∫ (a : SparseSGD.Logistic.Sample d),
      |inner ℝ u (SparseSGD.Logistic.gradient p mu theta a)| ^ n ∂SparseSGD.Logistic.sampleLaw d p ≤
    ↑n.factorial * (↑p * SparseSGD.Logistic.rareProjectionConstant Q) * (1 + SparseSGD.Logistic.r mu) ^ n
SparseSGD.Logistic.worldLaw {d B : ℕ} (p : ↑unitInterval) (ρ : MeasureTheory.Measure (SparseSGD.Logistic.State d)) :
  MeasureTheory.Measure (SparseSGD.Logistic.World d B)
SparseSGD.Params.comparisonFlow_squareRootLift_R (p : SparseSGD.Params) (s : SparseSGD.Moments) (x : Fin 2 → ℝ)
  (hx : s.cov = Matrix.vecMulVec x x) (hnoise : p.noise = 0) (hadd : p.additive = 0) (t : ℝ) :
  (p.comparisonFlow s t).R = p.squareRootLiftX x t ^ 2
SparseSGD.Params.comparisonFlow_squareRootLift_rank (p : SparseSGD.Params) (s : SparseSGD.Moments) (x : Fin 2 → ℝ)
  (hx : s.cov = Matrix.vecMulVec x x) (hne : x ≠ 0) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1) (hw0 : 0 < p.w)
  (hw1 : p.w < 2 * (1 + p.beta)) (hnoise : p.noise = 0) (hadd : p.additive = 0) (t : ℝ) :
  (p.comparisonFlow s t).cov.rank = 1
SparseSGD.Params.exact_embedding_renewal (p : SparseSGD.Params) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1)
  (hw0 : 0 < p.w) (hw1 : p.w < 2 * (1 + p.beta)) (jury : SparseSGD.External.JuryStability) (s : SparseSGD.Moments)
  (k : ℕ) :
  (p.trajectory s k).R =
    p.matchedFreeRisk s (↑k * p.matchedStep) +
      ∑ j ∈ Finset.range k,
        p.gridImpulseFactor * p.sampledImpulse (k - j) ^ 2 * (p.renormNoise * (p.trajectory s j).R + p.renormAdditive)
SparseSGD.Params.exact_embedding_step (p : SparseSGD.Params) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1) (hw0 : 0 < p.w)
  (hw1 : p.w < 2 * (1 + p.beta)) (jury : SparseSGD.External.JuryStability) (s : SparseSGD.Moments) :
  p.matchedCovariance (p.step s) =
    p.matchedMeanFlow *
        (p.matchedCovariance s +
          (p.gridImpulseFactor * (p.renormNoise * s.R + p.renormAdditive)) • Matrix.vecMulVec ![0, 1] ![0, 1]) *
      p.matchedMeanFlow.transpose
SparseSGD.Params.exact_matching_existsUnique (p : SparseSGD.Params) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1)
  (hw0 : 0 < p.w) (hw1 : p.w < 2 * (1 + p.beta)) :
  ∃! P, P 0 = ![1, 0] ∧ P.IsLowerTriangular ∧ P.det ≠ 0 ∧ p.meanMatrix = p.matchingSign • (P * p.matchedMeanFlow * P⁻¹)
SparseSGD.Params.exact_matching_kick (p : SparseSGD.Params) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1) (hw0 : 0 < p.w)
  (hw1 : p.w < 2 * (1 + p.beta)) :
  p.matchingMatrix⁻¹.mulVec SparseSGD.kick =
    (p.matchingSign / (p.beta * p.matchingMatrix 1 1)) • p.matchedMeanFlow.mulVec ![0, 1]
SparseSGD.Params.exact_matching_similarity (p : SparseSGD.Params) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1)
  (hw0 : 0 < p.w) (hw1 : p.w < 2 * (1 + p.beta)) :
  p.meanMatrix = p.matchingSign • (p.matchingMatrix * p.matchedMeanFlow * p.matchingMatrix⁻¹)
SparseSGD.Params.foldedAngle (p : SparseSGD.Params) : ℝ
SparseSGD.Params.gridImpulseFactor_eq (p : SparseSGD.Params) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1) (hw0 : 0 < p.w)
  (hw1 : p.w < 2 * (1 + p.beta)) (jury : SparseSGD.External.JuryStability) :
  p.gridImpulseFactor = (1 - p.curvature) * 2 * p.w * p.eps / (p.beta * p.matchingMatrix 1 1) ^ 2
SparseSGD.Params.matchedCovariance_first_entry (p : SparseSGD.Params) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1)
  (hw0 : 0 < p.w) (hw1 : p.w < 2 * (1 + p.beta)) (s : SparseSGD.Moments) : p.matchedCovariance s 0 0 = s.R
SparseSGD.Params.matchedDelta (p : SparseSGD.Params) : ℝ
SparseSGD.Params.matchedDelta_pos (p : SparseSGD.Params) (hb0 : 0 < p.beta) (hb1 : p.beta < 1) (hw0 : 0 < p.w)
  (hw1 : p.w < 2 * (1 + p.beta)) : 0 < p.matchedDelta
SparseSGD.Params.matchedMeanFlow (p : SparseSGD.Params) : Matrix (Fin 2) (Fin 2) ℝ
SparseSGD.Params.matchedMeanFlow_invariants (p : SparseSGD.Params) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1)
  (hw0 : 0 < p.w) (hw1 : p.w < 2 * (1 + p.beta)) :
  p.matchedMeanFlow.det = p.beta ∧
    p.matchedMeanFlow.trace = p.matchingSign * (1 + p.beta - p.w) ∧ p.matchedMeanFlow 0 1 ≠ 0
SparseSGD.Params.matchedStep (p : SparseSGD.Params) : ℝ
SparseSGD.Params.matchingMatrix (p : SparseSGD.Params) : Matrix (Fin 2) (Fin 2) ℝ
SparseSGD.Params.matchingSign (p : SparseSGD.Params) : ℝ
SparseSGD.Params.noiseFree_rankOne_rank (p : SparseSGD.Params) (s : SparseSGD.Moments) (x : Fin 2 → ℝ)
  (hx : s.cov = Matrix.vecMulVec x x) (hne : x ≠ 0) (hb : p.beta ≠ 0) (hnoise : p.noise = 0) (hadd : p.additive = 0)
  (k : ℕ) : (p.trajectory s k).cov.rank = 1
SparseSGD.Params.noiseFree_risk_eq_matched_grid (p : SparseSGD.Params) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1)
  (hw0 : 0 < p.w) (hw1 : p.w < 2 * (1 + p.beta)) (s : SparseSGD.Moments) (hnoise : p.noise = 0) (hadd : p.additive = 0)
  (k : ℕ) : (p.trajectory s k).R = p.matchedFreeRisk s (↑k * p.matchedStep)
SparseSGD.Params.noiseFree_risk_squareRootLift_grid (p : SparseSGD.Params) (s : SparseSGD.Moments) (x : Fin 2 → ℝ)
  (hx : s.cov = Matrix.vecMulVec x x) (hb0 : 1 / 2 ≤ p.beta) (hb1 : p.beta < 1) (hw0 : 0 < p.w)
  (hw1 : p.w < 2 * (1 + p.beta)) (hnoise : p.noise = 0) (hadd : p.additive = 0) (k : ℕ) :
  (p.trajectory s k).R = p.squareRootLiftX x (↑k * p.matchedStep) ^ 2
SparseSGD.Params.normalizedKernelLag_eq_continuum_sampling (p : SparseSGD.Params) (hb0 : 1 / 2 ≤ p.beta)
  (hb1 : p.beta < 1) (hw0 : 0 < p.w) (hw1 : p.w < 2 * (1 + p.beta)) (jury : SparseSGD.External.JuryStability) (n : ℕ) :
  SparseSGD.normalizedKernelLag p n =
    SparseSGD.continuumRenewalKernel p.matchedDelta (↑n * p.matchedStep) /
      ∑' (m : ℕ), SparseSGD.continuumRenewalKernel p.matchedDelta (↑(m + 1) * p.matchedStep)
SparseSGD.Params.renewal_kernel_nonneg (p : SparseSGD.Params) (n : ℕ) (hw : 0 ≤ p.w) (he : 0 ≤ p.eps) :
  0 ≤ 2 * p.w * p.eps * SparseSGD.kickResponse p n ^ 2
SparseSGD.Params.sampled_continuum_kernel_normalized_hasSum (p : SparseSGD.Params) (hb0 : 1 / 2 ≤ p.beta)
  (hb1 : p.beta < 1) (hw0 : 0 < p.w) (hw1 : p.w < 2 * (1 + p.beta)) (jury : SparseSGD.External.JuryStability) :
  HasSum
    (fun n =>
      SparseSGD.continuumRenewalKernel p.matchedDelta (↑(n + 1) * p.matchedStep) /
        ∑' (m : ℕ), SparseSGD.continuumRenewalKernel p.matchedDelta (↑(m + 1) * p.matchedStep))
    1
SparseSGD.Params.squareRootLiftX_hasDerivAt (p : SparseSGD.Params) (x : Fin 2 → ℝ) (t : ℝ) :
  HasDerivAt (p.squareRootLiftX x) (-p.matchedDelta * p.squareRootLiftY x t) t
SparseSGD.Params.squareRootLiftX_second_hasDerivAt (p : SparseSGD.Params) (x : Fin 2 → ℝ) (t : ℝ) :
  HasDerivAt (deriv (p.squareRootLiftX x)) (-deriv (p.squareRootLiftX x) t - p.matchedDelta * p.squareRootLiftX x t) t
SparseSGD.Params.squareRootLiftY_hasDerivAt (p : SparseSGD.Params) (x : Fin 2 → ℝ) (t : ℝ) :
  HasDerivAt (p.squareRootLiftY x) (p.squareRootLiftX x t - p.squareRootLiftY x t) t
SparseSGD.Params.squareRootLift_initial (p : SparseSGD.Params) (x : Fin 2 → ℝ) :
  p.squareRootLiftVector x 0 = p.matchingMatrix⁻¹.mulVec x
SparseSGD.Params.squareRootLift_oscillator_defect (jury : SparseSGD.External.JuryStability) (p : SparseSGD.Params)
  (s : SparseSGD.Moments) (hs : s.psd) (x : Fin 2 → ℝ) (hx : s.cov = Matrix.vecMulVec x x) (hb0 : 1 / 2 ≤ p.beta)
  (hb1 : p.beta < 1) (hw0 : 0 < p.w) (hw1 : p.w < 2 * (1 + p.beta)) (hnoise : 0 ≤ p.noise) (hadd : 0 ≤ p.additive)
  (hload : p.renormNoise < 1) (k : ℕ) :
  0 ≤ (p.trajectory s k).R - p.squareRootLiftX x (↑k * p.matchedStep) ^ 2 ∧
    (p.trajectory s k).R - p.squareRootLiftX x (↑k * p.matchedStep) ^ 2 ≤
      ((p.renormNoise * ⨆ j, p.squareRootLiftX x (↑j * p.matchedStep) ^ 2) + p.renormAdditive) / (1 - p.renormNoise)
SparseSGD.Params.trajectory_R_renewal (p : SparseSGD.Params) (s : SparseSGD.Moments) (k : ℕ) :
  (p.trajectory s k).R =
    (p.meanMatrix ^ k * s.cov * (p.meanMatrix ^ k).transpose) 0 0 +
      ∑ j ∈ Finset.range k,
        2 * p.w * p.eps * (p.noise * (p.trajectory s j).R + p.additive) * SparseSGD.kickResponse p (k - 1 - j) ^ 2
SparseSGD.Params.trajectory_cov_unroll (p : SparseSGD.Params) (s : SparseSGD.Moments) (k : ℕ) :
  (p.trajectory s k).cov =
    p.meanMatrix ^ k * s.cov * (p.meanMatrix ^ k).transpose +
      ∑ j ∈ Finset.range k,
        (2 * p.w * p.eps * (p.noise * (p.trajectory s j).R + p.additive)) •
          (p.meanMatrix ^ (k - 1 - j) * Matrix.vecMulVec SparseSGD.kick SparseSGD.kick *
            (p.meanMatrix ^ (k - 1 - j)).transpose)
SparseSGD.Params.windowOsc_grid (p : SparseSGD.Params) (margin : ℝ) (hm : 0 < margin) (hb0 : 1 / 2 ≤ p.beta)
  (hb1 : p.beta < 1) (hD : SparseSGD.windowDeltaThreshold margin ≤ p.matchedDelta) (s : SparseSGD.Moments) (k : ℕ) :
  p.windowOsc s (↑k * p.matchedStep) =
    SparseSGD.oscillatoryEnergy p.matchedDelta (SparseSGD.oscillatoryRoot √(p.matchedDelta - 1 / 4))
          (p.matchedMoments s) *
        ↑(Real.exp (-(1 + p.renormNoise / 2) * (↑k * p.matchedStep))) *
      Complex.exp (2 * Complex.I * ↑k * ↑p.foldedAngle)
SparseSGD.Probability.LeastSquares.batchOracle {d B : ℕ} (hB : 0 < B) (p : ↑unitInterval) (ν : MeasureTheory.Measure ℝ)
  [MeasureTheory.IsProbabilityMeasure ν] (hz : MeasureTheory.MemLp id 2 ν) (hmean : ∫ (z : ℝ), z ∂ν = 0) :
  SparseSGD.Probability.LeastSquares.BatchOracle d B p ν
SparseSGD.Probability.LeastSquares.leastSquares_conditional_gradient {d B : ℕ} (hB : 0 < B) (p : ↑unitInterval)
  (ν : MeasureTheory.Measure ℝ) (ρ : MeasureTheory.Measure (SparseSGD.Probability.LeastSquares.State d))
  [MeasureTheory.IsProbabilityMeasure ν] [MeasureTheory.IsProbabilityMeasure ρ] (hz : MeasureTheory.MemLp id 2 ν)
  (hmean : ∫ (z : ℝ), z ∂ν = 0) (beta eta : ℝ) (he0 : MeasureTheory.MemLp (fun s => s.1) 2 ρ)
  (hq0 : MeasureTheory.MemLp (fun s => s.2) 2 ρ) (k : ℕ) :
  (SparseSGD.Probability.LeastSquares.worldLaw p ν ρ)[fun ω =>
      SparseSGD.Probability.LeastSquares.batchGradient (SparseSGD.Probability.LeastSquares.process beta eta ω k).1
        (ω.2 k) |
      SparseSGD.Probability.LeastSquares.sourceSigma d B beta eta
        k] =ᵐ[SparseSGD.Probability.LeastSquares.worldLaw p ν ρ]
    fun ω => ↑p • (SparseSGD.Probability.LeastSquares.process beta eta ω k).1
SparseSGD.Probability.LeastSquares.leastSquares_conditional_oracle {d B : ℕ} (hB : 0 < B) (p : ↑unitInterval)
  (ν : MeasureTheory.Measure ℝ) (ρ : MeasureTheory.Measure (SparseSGD.Probability.LeastSquares.State d))
  [MeasureTheory.IsProbabilityMeasure ν] [MeasureTheory.IsProbabilityMeasure ρ] (hz : MeasureTheory.MemLp id 2 ν)
  (hmean : ∫ (z : ℝ), z ∂ν = 0) (beta eta : ℝ) (he0 : MeasureTheory.MemLp (fun s => s.1) 2 ρ)
  (hq0 : MeasureTheory.MemLp (fun s => s.2) 2 ρ) (k : ℕ) :
  MeasureTheory.MemLp
      (fun ω =>
        SparseSGD.Probability.LeastSquares.residual p (SparseSGD.Probability.LeastSquares.process beta eta ω k).1
          (ω.2 k))
      2 (SparseSGD.Probability.LeastSquares.worldLaw p ν ρ) ∧
    (SparseSGD.Probability.LeastSquares.worldLaw p ν ρ)[fun ω =>
          SparseSGD.Probability.LeastSquares.residual p (SparseSGD.Probability.LeastSquares.process beta eta ω k).1
            (ω.2 k) |
          SparseSGD.Probability.LeastSquares.sourceSigma d B beta eta
            k] =ᵐ[SparseSGD.Probability.LeastSquares.worldLaw p ν ρ]
        0 ∧
      (SparseSGD.Probability.LeastSquares.worldLaw p ν ρ)[fun ω =>
          ‖SparseSGD.Probability.LeastSquares.residual p (SparseSGD.Probability.LeastSquares.process beta eta ω k).1
                (ω.2 k)‖ ^
            2 |
          SparseSGD.Probability.LeastSquares.sourceSigma d B beta eta
            k] =ᵐ[SparseSGD.Probability.LeastSquares.worldLaw p ν ρ]
        fun ω =>
        SparseSGD.Probability.LeastSquares.vinc d B p *
            ‖(SparseSGD.Probability.LeastSquares.process beta eta ω k).1‖ ^ 2 +
          SparseSGD.Probability.LeastSquares.vadd d B p ν
SparseSGD.Probability.LeastSquares.leastSquares_process_memLp {d B : ℕ} (hB : 0 < B) (p : ↑unitInterval)
  (ν : MeasureTheory.Measure ℝ) (ρ : MeasureTheory.Measure (SparseSGD.Probability.LeastSquares.State d))
  [MeasureTheory.IsProbabilityMeasure ν] [MeasureTheory.IsProbabilityMeasure ρ] (hz : MeasureTheory.MemLp id 2 ν)
  (hmean : ∫ (z : ℝ), z ∂ν = 0) (beta eta : ℝ) (he0 : MeasureTheory.MemLp (fun s => s.1) 2 ρ)
  (hq0 : MeasureTheory.MemLp (fun s => s.2) 2 ρ) (k : ℕ) :
  MeasureTheory.MemLp (fun ω => (SparseSGD.Probability.LeastSquares.process beta eta ω k).1) 2
      (SparseSGD.Probability.LeastSquares.worldLaw p ν ρ) ∧
    MeasureTheory.MemLp (fun ω => (SparseSGD.Probability.LeastSquares.process beta eta ω k).2) 2
      (SparseSGD.Probability.LeastSquares.worldLaw p ν ρ)
SparseSGD.Probability.LeastSquares.totalLoad_lt_one_iff_eta_lt_critical (d B : ℕ) (hB : 0 < B) (p : ↑unitInterval)
  (hp : 0 < ↑p) (ν : MeasureTheory.Measure ℝ) (beta eta : ℝ) (hb0 : 0 ≤ beta) (hb1 : beta < 1) :
  (SparseSGD.Probability.LeastSquares.params d B p ν beta eta).totalLoad < 1 ↔
    eta < SparseSGD.Probability.LeastSquares.criticalRate d B p beta
SparseSGD.RawOracleHypotheses.{u_1, u_2} {Ω : Type u_1} {E : Type u_2} [mΩ : MeasurableSpace Ω] [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] (μ : MeasureTheory.Measure Ω) (F : ℕ → MeasurableSpace Ω) (e q ξ : ℕ → Ω → E)
  (vinc vadd : ℝ) : Prop
SparseSGD.Scaling.actualLSParams_learningClock (pStar kappa bStar sigma epsStar gamma etaStar alpha : ℝ)
  (p : ℕ → ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (d : ℕ) (hp : ↑(p d) ≠ 0)
  (he : SparseSGD.Scaling.scaledRetention epsStar gamma d ≠ 0) :
  (SparseSGD.Scaling.actualLSParams pStar kappa bStar sigma epsStar gamma etaStar alpha p ν d).w /
      (SparseSGD.Scaling.actualLSParams pStar kappa bStar sigma epsStar gamma etaStar alpha p ν d).eps =
    SparseSGD.Scaling.scaledLearningRate etaStar alpha d * ↑(p d)
SparseSGD.Scaling.actualLSParams_matchedStep_over_retention_tendsto_one
  (pStar kappa bStar sigma epsStar gamma etaStar alpha : ℝ) (p : ℕ → ↑unitInterval) (ν : MeasureTheory.Measure ℝ)
  (heps : 0 < epsStar) (hg : 0 < gamma) :
  Filter.Tendsto
    (fun d =>
      (SparseSGD.Scaling.actualLSParams pStar kappa bStar sigma epsStar gamma etaStar alpha p ν d).matchedStep /
        SparseSGD.Scaling.scaledRetention epsStar gamma d)
    Filter.atTop (nhds 1)
SparseSGD.Scaling.actual_critical_activity_tendsto (pStar bStar sigma : ℝ) (p : ℕ → ↑unitInterval) (hp : 0 < pStar)
  (hb : 0 < bStar) (hs : 0 < sigma)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar sigma d) :
  Filter.Tendsto (fun d => SparseSGD.Scaling.batchActivity (↑(p d)) (SparseSGD.Scaling.scaledBatch bStar sigma d))
    Filter.atTop (nhds (1 - Real.exp (-(bStar * pStar))))
SparseSGD.Scaling.actual_curvature_noise_ratio_tendsto (pStar kappa b sigma epsStar gamma etaStar alpha : ℝ)
  (p : ℕ → ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (hpstar : 0 < pStar) (hk : 0 ≤ kappa) (hb : 0 < b)
  (hs : 0 ≤ sigma) (heps : 0 < epsStar) (hg : 0 < gamma) (heta : 0 < etaStar)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d) :
  Filter.Tendsto
    (fun d =>
      (SparseSGD.Scaling.actualLSParams pStar kappa b sigma epsStar gamma etaStar alpha p ν d).curvature /
          (SparseSGD.Scaling.actualLSParams pStar kappa b sigma epsStar gamma etaStar alpha p ν d).noise /
        (epsStar * SparseSGD.Scaling.realizedBatchScale b sigma * pStar / 2 * ↑d ^ (sigma - kappa - gamma - 1)))
    Filter.atTop (nhds 1)
SparseSGD.Scaling.actual_dense_activity_tendsto_one (pStar kappa b sigma : ℝ) (p : ℕ → ↑unitInterval) (hp : 0 < pStar)
  (hb : 0 < b) (hs : 0 ≤ sigma) (hks : kappa < sigma)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d) :
  Filter.Tendsto (fun d => SparseSGD.Scaling.batchActivity (↑(p d)) (SparseSGD.Scaling.scaledBatch b sigma d))
    Filter.atTop (nhds 1)
SparseSGD.Scaling.actual_dimension_correction_tendsto_one (pStar kappa : ℝ) (p : ℕ → ↑unitInterval) (hk : 0 ≤ kappa)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d) :
  Filter.Tendsto (fun d => (↑d + 2 - ↑(p d)) / ↑d) Filter.atTop (nhds 1)
SparseSGD.Scaling.actual_fluid_fixed_sparsity_parameter_limits (pStar b sigma epsStar gamma etaStar alpha : ℝ)
  (p : ℕ → ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (hp : 0 < pStar) (hp1 : pStar ≤ 1) (hb : 0 < b) (hs : 0 ≤ sigma)
  (heps : 0 < epsStar) (hg : 0 ≤ gamma) (heta : 0 < etaStar) (ha : 0 < alpha) (hfixed : gamma = 0 → epsStar ≤ 1 / 2)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar 0 d) (cap : ℝ) (hcap : pStar ≤ cap)
  (hPhi : 1 - sigma - alpha < 0 ∨ 1 - sigma - alpha = 0) (hDelta : gamma - alpha < 0 ∨ gamma - alpha = 0) :
  (∀ᶠ (d : ℕ) in Filter.atTop,
      1 / 2 ≤ (SparseSGD.Scaling.actualLSParams pStar 0 b sigma epsStar gamma etaStar alpha p ν d).beta ∧
        (SparseSGD.Scaling.actualLSParams pStar 0 b sigma epsStar gamma etaStar alpha p ν d).beta < 1 ∧ ↑(p d) ≤ cap) ∧
    Filter.Tendsto (fun d => ↑(p d)) Filter.atTop (nhds pStar) ∧
      Filter.Tendsto (fun d => SparseSGD.Scaling.scaledLearningRate etaStar alpha d * ↑(p d)) Filter.atTop (nhds 0) ∧
        (if 1 - sigma - alpha < 0 then
            Filter.Tendsto
              (fun d =>
                SparseSGD.Logistic.logisticPhi d (SparseSGD.Scaling.scaledBatch b sigma d)
                  (SparseSGD.Scaling.scaledLearningRate etaStar alpha d))
              Filter.atTop (nhds 0)
          else
            Filter.Tendsto
              (fun d =>
                SparseSGD.Logistic.logisticPhi d (SparseSGD.Scaling.scaledBatch b sigma d)
                  (SparseSGD.Scaling.scaledLearningRate etaStar alpha d))
              Filter.atTop (nhds (etaStar / (2 * SparseSGD.Scaling.realizedBatchScale b sigma)))) ∧
          if gamma - alpha < 0 then
            Filter.Tendsto
              (fun d =>
                SparseSGD.Scaling.rawDelta
                  (SparseSGD.Scaling.actualLSParams pStar 0 b sigma epsStar gamma etaStar alpha p ν d))
              Filter.atTop (nhds 0)
          else
            Filter.Tendsto
              (fun d =>
                SparseSGD.Scaling.rawDelta
                  (SparseSGD.Scaling.actualLSParams pStar 0 b sigma epsStar gamma etaStar alpha p ν d))
              Filter.atTop (nhds (etaStar * pStar / epsStar))
SparseSGD.Scaling.actual_ls_curvature_to_noise_ratio (d B : ℕ) (p : ↑unitInterval) (ν : MeasureTheory.Measure ℝ)
  (beta eta : ℝ) (hd : 0 < d) (hB : 0 < B) (hp : ↑p ≠ 0) (heta : eta ≠ 0) :
  (SparseSGD.Probability.LeastSquares.params d B p ν beta eta).curvature /
      (SparseSGD.Probability.LeastSquares.params d B p ν beta eta).noise =
    (1 - beta) * ↑p * ↑B / ((1 + beta) * (↑d + 2 - ↑p))
SparseSGD.Scaling.actual_signal_increment_ratio_tendsto (pStar kappa b sigma : ℝ) (p : ℕ → ↑unitInterval)
  (hpstar : 0 < pStar) (hb : 0 < b) (hs : 0 ≤ sigma) (hk : 0 ≤ kappa)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d) :
  Filter.Tendsto
    (fun d =>
      ↑(p d) ^ 2 / SparseSGD.Probability.LeastSquares.vinc d (SparseSGD.Scaling.scaledBatch b sigma d) (p d) /
        (SparseSGD.Scaling.realizedBatchScale b sigma * pStar * ↑d ^ (sigma - kappa - 1)))
    Filter.atTop (nhds 1)
SparseSGD.Scaling.actual_sparse_activity_clock_ratio (pStar kappa b sigma epsStar gamma : ℝ) (p : ℕ → ↑unitInterval)
  (hp : 0 < pStar) (hb : 0 < b) (hs : 0 ≤ sigma) (he : 0 < epsStar) (hks : sigma < kappa)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d) :
  Filter.Tendsto
    (fun d =>
      SparseSGD.Scaling.batchActivity (↑(p d)) (SparseSGD.Scaling.scaledBatch b sigma d) /
          SparseSGD.Scaling.scaledRetention epsStar gamma d /
        (SparseSGD.Scaling.realizedBatchScale b sigma * pStar / epsStar * ↑d ^ (gamma + sigma - kappa)))
    Filter.atTop (nhds 1)
SparseSGD.Scaling.actual_sparse_activity_ratio (pStar kappa b sigma : ℝ) (p : ℕ → ↑unitInterval) (hp : 0 < pStar)
  (hb : 0 < b) (hs : 0 ≤ sigma) (hks : sigma < kappa)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d) :
  Filter.Tendsto
    (fun d =>
      SparseSGD.Scaling.batchActivity (↑(p d)) (SparseSGD.Scaling.scaledBatch b sigma d) /
        (SparseSGD.Scaling.realizedBatchScale b sigma * pStar * ↑d ^ (sigma - kappa)))
    Filter.atTop (nhds 1)
SparseSGD.Scaling.actual_sparse_memory_threshold (pStar kappa b sigma epsStar gamma : ℝ) (p : ℕ → ↑unitInterval)
  (hp : 0 < pStar) (hb : 0 < b) (hs : 0 ≤ sigma) (he : 0 < epsStar) (hks : sigma < kappa)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d) :
  (gamma < kappa - sigma →
      Filter.Tendsto
        (fun d =>
          SparseSGD.Scaling.batchActivity (↑(p d)) (SparseSGD.Scaling.scaledBatch b sigma d) /
            SparseSGD.Scaling.scaledRetention epsStar gamma d)
        Filter.atTop (nhds 0)) ∧
    (gamma = kappa - sigma →
        Filter.Tendsto
          (fun d =>
            SparseSGD.Scaling.batchActivity (↑(p d)) (SparseSGD.Scaling.scaledBatch b sigma d) /
              SparseSGD.Scaling.scaledRetention epsStar gamma d)
          Filter.atTop (nhds (SparseSGD.Scaling.realizedBatchScale b sigma * pStar / epsStar))) ∧
      (kappa - sigma < gamma →
        Filter.Tendsto
          (fun d =>
            SparseSGD.Scaling.batchActivity (↑(p d)) (SparseSGD.Scaling.scaledBatch b sigma d) /
              SparseSGD.Scaling.scaledRetention epsStar gamma d)
          Filter.atTop Filter.atTop)
SparseSGD.Scaling.actual_window_rate_ratio (pStar kappa bStar sigma epsStar gamma etaStar alpha u : ℝ)
  (p : ℕ → ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (he : 0 < epsStar) (hg : 0 < gamma)
  (hnu :
    Filter.Tendsto
      (fun d =>
        (SparseSGD.Scaling.actualLSParams pStar kappa bStar sigma epsStar gamma etaStar alpha p ν d).renormNoise)
      Filter.atTop (nhds u)) :
  Filter.Tendsto
    (fun d =>
      have P := SparseSGD.Scaling.actualLSParams pStar kappa bStar sigma epsStar gamma etaStar alpha p ν d;
      P.matchedStep * (1 - P.renormNoise) / SparseSGD.Scaling.scaledRetention epsStar gamma d)
    Filter.atTop (nhds (1 - u))
SparseSGD.Scaling.batchLaw_someMaskActive_real (d B : ℕ) (p : ↑unitInterval) (ν : MeasureTheory.Measure ℝ)
  [MeasureTheory.IsProbabilityMeasure ν] :
  (SparseSGD.Probability.LeastSquares.batchLaw d B p ν).real {a | SparseSGD.Scaling.someMaskActive a} =
    SparseSGD.Scaling.batchActivity (↑p) B
SparseSGD.Scaling.coldOscillator_equation (delta R t : ℝ) :
  deriv (deriv (SparseSGD.Scaling.coldOscillatorX delta R)) t + deriv (SparseSGD.Scaling.coldOscillatorX delta R) t +
      delta * SparseSGD.Scaling.coldOscillatorX delta R t =
    0
SparseSGD.Scaling.coldOscillator_initial (delta R : ℝ) :
  SparseSGD.Scaling.coldOscillatorX delta R 0 = √R ∧ deriv (SparseSGD.Scaling.coldOscillatorX delta R) 0 = 0
SparseSGD.Scaling.continuum_cold_zero_loads_square (delta R t : ℝ) (hR : 0 ≤ R) :
  (SparseSGD.continuumFlow delta 0 0 { R := R, V := 0, C := 0 } t).R = SparseSGD.Scaling.coldOscillatorX delta R t ^ 2
SparseSGD.Scaling.cor_resonance_fixed_rate (pStar kappa bStar epsStar gamma etaStar R : ℝ) (p : ℕ → ↑unitInterval)
  (ν : MeasureTheory.Measure ℝ) (jury : SparseSGD.External.JuryStability) (hp : 0 < pStar) (hk : 0 ≤ kappa)
  (hb : 0 < bStar) (he : 0 < epsStar) (hg : 0 < gamma) (heta : 0 < etaStar) (hline : gamma = 1 + kappa)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d) (hR : 0 ≤ R)
  (hu1 : etaStar / (2 * ↑(SparseSGD.Scaling.fixedRealizedBatch bStar)) < 1) :
  ∃ C > 0,
    ∀ᶠ (d : ℕ) in Filter.atTop,
      ∀ (k : ℕ),
        have P := SparseSGD.Scaling.actualLSParams pStar kappa bStar 0 epsStar gamma etaStar 1 p ν d;
        |(P.trajectory { R := R, V := 0, C := 0 } k).R -
              (SparseSGD.continuumFlow (etaStar * pStar / epsStar)
                  (etaStar / (2 * ↑(SparseSGD.Scaling.fixedRealizedBatch bStar)))
                  (SparseSGD.Probability.LeastSquares.labelVariance ν *
                    (etaStar / (2 * ↑(SparseSGD.Scaling.fixedRealizedBatch bStar))))
                  { R := R, V := 0, C := 0 } (↑k * P.matchedStep)).R| ≤
          C * (↑d ^ (-gamma) + ↑d ^ (-1))
SparseSGD.Scaling.cor_resonance_fixed_rate_min (pStar kappa bStar epsStar gamma etaStar R : ℝ) (p : ℕ → ↑unitInterval)
  (ν : MeasureTheory.Measure ℝ) (jury : SparseSGD.External.JuryStability) (hp : 0 < pStar) (hk : 0 ≤ kappa)
  (hb : 0 < bStar) (he : 0 < epsStar) (hg : 0 < gamma) (heta : 0 < etaStar) (hline : gamma = 1 + kappa)
