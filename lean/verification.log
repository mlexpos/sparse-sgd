SparseSGD.windowSlowProfile_derivative (delta u phi : ℝ) (s : SparseSGD.Moments) (hu : u ≠ 1) (t : ℝ) :
  HasDerivAt (SparseSGD.windowSlowProfile delta u phi s)
    (-(1 - u) * SparseSGD.windowSlowProfile delta u phi s t + 2 * phi) t
