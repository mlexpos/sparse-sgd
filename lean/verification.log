        (2 * ↑B * SparseSGD.Logistic.coefA p mu theta) ∧
    (SparseSGD.Logistic.driftParams eta beta p mu theta).additive =
        eta * (↑d - 1) * SparseSGD.Logistic.coefD0 p mu theta / (2 * ↑B * SparseSGD.Logistic.coefA p mu theta) ∧
      (SparseSGD.Logistic.driftParams eta beta p mu theta).curvature =
        eta * (1 - beta) * SparseSGD.Logistic.coefA p mu theta / (2 * (1 + beta))
SparseSGD.Logistic.dynamicDriftMap_eq_integral {d B : ℕ} (H : SparseSGD.External.GaussianSteinCertificate d)
  (hB : 0 < B) (eta beta : ℝ) (p : ↑unitInterval) (mu : SparseSGD.Logistic.Vec d) (s : SparseSGD.Logistic.State d)
  (hr : 0 < SparseSGD.Logistic.r mu) (hp0 : 0 < ↑p) (hp1 : ↑p < 1) (heta : eta ≠ 0) (hbeta : 1 - beta ≠ 0) (i : Fin 5) :
  ∫ (a : SparseSGD.Logistic.Batch d B),
      SparseSGD.Logistic.dynamicSummary p mu (SparseSGD.Logistic.update eta beta p mu s a)
        i ∂SparseSGD.Logistic.batchLaw d B p =
    SparseSGD.Logistic.dynamicDriftMap eta beta p mu s.1 (SparseSGD.Logistic.dynamicSummary p mu s) i
SparseSGD.Logistic.dynamicPhysical_preserved (r delta Phi a b : ℝ) (y : ℝ → SparseSGD.Logistic.DynamicState)
  (hab : a ≤ b) (hd : 0 < delta) (hPhi : 0 ≤ Phi)
  (hy : ∀ t ∈ Set.Icc a b, HasDerivAt y (SparseSGD.Logistic.dynamicField r delta Phi (y t)) t)
  (hy0 : SparseSGD.Logistic.dynamicPhysical (y a)) (t : ℝ) : t ∈ Set.Icc a b → SparseSGD.Logistic.dynamicPhysical (y t)
SparseSGD.Logistic.dynamic_rank_one_full_interval_coordinates (r delta a b : ℝ)
  (y : ℝ → SparseSGD.Logistic.DynamicState) (hab : a ≤ b)
  (hy : ∀ t ∈ Set.Icc a b, HasDerivAt y (SparseSGD.Logistic.dynamicField r delta 0 (y t)) t) (hR : 0 ≤ y a 2)
  (hV : 0 ≤ y a 3) (hQ : SparseSGD.Logistic.dynamicDeterminant (y a) = 0) :
  ∃ X P,
    ∀ t ∈ Set.Icc a b,
      y t 2 = X t ^ 2 ∧
        y t 3 = P t ^ 2 ∧
          y t 4 = X t * P t ∧
            HasDerivAt X (-delta * P t) t ∧ HasDerivAt P (-P t + SparseSGD.Logistic.dynamicAlpha r (y t) * X t) t
SparseSGD.Logistic.dynamic_rank_one_full_interval_oscillator (r delta a b : ℝ) (y : ℝ → SparseSGD.Logistic.DynamicState)
  (hab : a ≤ b) (hy : ∀ t ∈ Set.Icc a b, HasDerivAt y (SparseSGD.Logistic.dynamicField r delta 0 (y t)) t)
  (hR : 0 ≤ y a 2) (hV : 0 ≤ y a 3) (hQ : SparseSGD.Logistic.dynamicDeterminant (y a) = 0) :
  ∃ z,
    (∀ t ∈ Set.Icc a b, HasDerivAt z (SparseSGD.Logistic.dynamicOscillatorField r delta (z t)) t) ∧
      ∀ t ∈ Set.Icc a b, SparseSGD.Logistic.dynamicRankOneLift (z t) = y t
SparseSGD.Logistic.dynamic_rank_one_preserved (r delta a b : ℝ) (y : ℝ → SparseSGD.Logistic.DynamicState)
  (hy : ∀ t ∈ Set.Icc a b, HasDerivAt y (SparseSGD.Logistic.dynamicField r delta 0 (y t)) t)
  (hzero : SparseSGD.Logistic.dynamicDeterminant (y a) = 0) (t : ℝ) :
  t ∈ Set.Icc a b → SparseSGD.Logistic.dynamicDeterminant (y t) = 0
SparseSGD.Logistic.dynamic_solution_exists_on_finite_horizon (r delta Phi T : ℝ) (y0 : SparseSGD.Logistic.DynamicState)
  (hd : 0 < delta) (hPhi : 0 ≤ Phi) (hT : 0 ≤ T) (hy0 : SparseSGD.Logistic.dynamicPhysical y0) :
  ∃ y,
    y 0 = y0 ∧
      (∀ t ∈ Set.Icc 0 T, HasDerivAt y (SparseSGD.Logistic.dynamicField r delta Phi (y t)) t) ∧
        ∀ t ∈ Set.Icc 0 T, SparseSGD.Logistic.dynamicPhysical (y t)
SparseSGD.Logistic.equilibriumBulk_fixedBatch_comparable (eta alpha P : ℝ) (B : ℕ) (r : ℕ → ℝ) (heta : 0 < eta)
  (hB : 0 < B) (hr : ∀ (d : ℕ), 0 < r d)
  (hcap : ∀ᶠ (d : ℕ) in Filter.atTop, SparseSGD.Logistic.familyPhi eta alpha (fun x => B) d ≤ P) :
