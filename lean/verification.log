SparseSGD.Scaling.Helps.lamSGD {n : ℕ} (ps : Fin (n + 1) → ↑unitInterval) : ℝ
SparseSGD.Scaling.Helps.largeBatch_momentum {n d : ℕ} {ν : MeasureTheory.Measure ℝ} {beta eta : ℝ}
  {ps : Fin (n + 1) → ↑unitInterval} (hp : ∀ (j : Fin (n + 1)), 0 < ↑(ps j)) (hanti : Antitone ps) (hb0 : 0 < beta)
  (hb1 : beta < 1) (hκ : 1 < SparseSGD.Scaling.Helps.kappaV ps)
  (hr : √beta = (√(SparseSGD.Scaling.Helps.kappaV ps) - 1) / (√(SparseSGD.Scaling.Helps.kappaV ps) + 1))
  (hη : eta * (1 - beta) * ↑(ps 0) = (1 + √beta) ^ 2) :
