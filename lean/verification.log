  (ρ : MeasureTheory.Measure (SparseSGD.Logistic.State d)) [MeasureTheory.IsProbabilityMeasure ρ] (j : ℕ)
  (U : Set (SparseSGD.Logistic.State d)) (ell : (Fin 5 → ℝ) →L[ℝ] ℝ) (Q K L t : ℝ) (hB : 0 < B) (hp : 0 < ↑p)
  (hr : 0 < SparseSGD.Logistic.r mu) (heta : 0 ≤ eta) (hbeta : 0 ≤ beta) (hbeta1 : beta < 1) (hell : ‖ell‖ ≤ 1)
  (htame : ∀ s ∈ U, SparseSGD.Logistic.tameError p mu s.1 ≤ 1 / 2) (hθ : ∀ s ∈ U, ‖s.1‖ ≤ Q)
  (hm : ∀ s ∈ U, ‖(eta / (1 - beta)) • SparseSGD.Logistic.bulkPart mu s.2‖ ≤ K) (hstep : eta * ↑p ≤ L)
  (ht : |t| * SparseSGD.Logistic.lrIncrementScale eta mu Q K L B < 1) :
  ∀ᵐ (ω : SparseSGD.Logistic.World d B) ∂SparseSGD.Logistic.worldLaw p ρ,
