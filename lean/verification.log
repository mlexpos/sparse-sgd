SparseSGD.Scaling.Helps.vocab_full_sgd_iff {n d B : ℕ} {ν : MeasureTheory.Measure ℝ} {ps : Fin (n + 1) → ↑unitInterval}
  (hB : 1 ≤ B) (hp : ∀ (j : Fin (n + 1)), 0 < ↑(ps j)) (hanti : Antitone ps)
