    ‖SparseSGD.Logistic.slowPosition (x n) - y (↑n * z)‖ ≤
        (4 * z * (Cres * J0) / h + T * (Cres * (4 * Ctr * (z / h + e) + z + e) + ↑Lf * F * z)) * Real.exp (T * ↑Lf) ∧
      SparseSGD.Logistic.slowTrackingError r h Phi (x n) ≤ (1 - h / 4) ^ n * J0 + 4 * Ctr * (z / h + e)
