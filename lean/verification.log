                1 / Real.log (1 + ↑B * ↑(ps (Fin.last n)) / (↑d + 2 - ↑(ps (Fin.last n))))) ∧
        (∀ (B : ℕ),
            1 ≤ B →
              ∀ (η : Fin (n + 1) → ℝ),
                0 < η (Fin.last n) →
                  ((↑d + 2 - ↑(ps (Fin.last n))) / (↑d + 2 + (↑B - 1) * ↑(ps (Fin.last n))) ≤
                      Finset.univ.sup' ⋯ fun j =>
                        SparseSGD.Scaling.Helps.stepRadius (SparseSGD.Scaling.Helps.copyParams d B ν 0 (η j) ps j)) ∧
                    (Finset.univ.inf' ⋯ fun j =>
