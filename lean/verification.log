  (hb : 0 < bStar) (hs : 0 ≤ sigma) (heps : 0 < epsStar) (hg : 0 ≤ gamma) (heta : 0 < etaStar) (ha : 0 < alpha + kappa)
  (halpha : -(1 / 2) < alpha) (hT : 0 < T) (hfixed : gamma = 0 → epsStar ≤ 1 / 2)
