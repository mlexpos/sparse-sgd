SparseSGD.Scaling.learningProfile_excess_grid (u phi R z : ℝ) (k : ℕ) :
  SparseSGD.Scaling.learningProfile u phi R (↑k * z) - phi / (1 - u) =
    (R - phi / (1 - u)) * Real.exp (-(2 * z * (1 - u)) * ↑k)
