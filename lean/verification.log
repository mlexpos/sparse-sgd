SparseSGD.continuumRenewalKernel_mass {delta : ℝ} (hd : 0 < delta) :
  ∫ (t : ℝ) in Set.Ioi 0, SparseSGD.continuumRenewalKernel delta t = 1
SparseSGD.continuum_largeDelta_cold_risk_uniform (margin u phi R : ℝ) (hm : 0 < margin) (hu0 : 0 ≤ u)
  (hu : u ≤ 1 - margin) (hp : 0 ≤ phi) (hR : 0 ≤ R) :
  TendstoUniformlyOn
    (fun D tau =>
      (SparseSGD.continuumFlow D u phi { R := R, V := 0, C := 0 } tau).R -
        ((2 * phi / (1 - u) + (R - 2 * phi / (1 - u)) * Real.exp ((u - 1) * tau)) / 2 +
          (↑R * Complex.exp (SparseSGD.windowOscillatoryRate u √(D - 1 / 4) * ↑tau)).re / 2))
    (fun x => 0) Filter.atTop (Set.Ici 0)
SparseSGD.continuum_smallDelta_tendstoUniformlyOn_learningClock (u phi R : ℝ) (jury : SparseSGD.External.JuryStability)
  (hu0 : 0 ≤ u) (hu1 : u < 1) (hp : 0 ≤ phi) (hR : 0 ≤ R) :
  TendstoUniformlyOn (fun D t => (SparseSGD.continuumFlow D u phi { R := R, V := 0, C := 0 } (t / D)).R)
    (SparseSGD.Scaling.learningProfile u phi R) (nhdsWithin 0 (Set.Ioi 0)) (Set.Ici 0)
SparseSGD.continuum_solution_exists (delta u phi : ℝ) (s : SparseSGD.Moments) :
  ∃ f, f 0 = s ∧ SparseSGD.IsMomentSolution delta u phi f
SparseSGD.continuum_solution_unique (delta u phi : ℝ) (s : SparseSGD.Moments) (f : ℝ → SparseSGD.Moments)
  (hf0 : f 0 = s) (hf : SparseSGD.IsMomentSolution delta u phi f) (t : ℝ) (ht : 0 ≤ t) :
  f t = SparseSGD.continuumFlow delta u phi s t
SparseSGD.cor_regular (K : Set ℝ) (hK : IsCompact K) (hKpos : K ⊆ Set.Ioi 0) (margin : ℝ) (hm : 0 < margin) :
  ∃ step₀ > 0,
    ∃ C > 0,
      ∀ (p : SparseSGD.Params) (s : SparseSGD.Moments) (delta₀ u₀ phi₀ : ℝ) (s₀ : SparseSGD.Moments),
        0 < p.beta →
          p.beta < 1 →
            0 < p.w →
              p.w < 2 * (1 + p.beta) →
                SparseSGD.External.JuryStability →
                  s.psd →
                    p.matchedStep ≤ step₀ →
                      p.matchedDelta ∈ K →
                        delta₀ ∈ K →
                          0 ≤ p.renormNoise →
                            p.renormNoise ≤ 1 - margin →
                              0 ≤ u₀ →
                                u₀ ≤ 1 - margin →
                                  0 ≤ p.renormAdditive →
                                    ∀ (k : ℕ),
                                      |(p.trajectory s k).R -
                                            (SparseSGD.continuumFlow delta₀ u₀ phi₀ s₀ (↑k * p.matchedStep)).R| ≤
                                        C *
                                          ((p.matchedStep + |p.matchedDelta - delta₀| + |p.renormNoise - u₀|) *
                                                (p.comparisonInitialSize s + p.renormAdditive) +
                                              |p.renormAdditive - phi₀| +
                                            ‖(p.matchedMoments s).cov - s₀.cov‖)
SparseSGD.cor_resonance_neighboring_limits (u phi R : ℝ) (jury : SparseSGD.External.JuryStability) (hu0 : 0 ≤ u)
  (hu1 : u < 1) (hp : 0 ≤ phi) (hR : 0 ≤ R) :
  TendstoUniformlyOn (fun D t => (SparseSGD.continuumFlow D u phi { R := R, V := 0, C := 0 } (t / D)).R)
      (SparseSGD.Scaling.learningProfile u phi R) (nhdsWithin 0 (Set.Ioi 0)) (Set.Ici 0) ∧
    TendstoUniformlyOn
      (fun D tau =>
        (SparseSGD.continuumFlow D u phi { R := R, V := 0, C := 0 } tau).R -
          ((2 * phi / (1 - u) + (R - 2 * phi / (1 - u)) * Real.exp ((u - 1) * tau)) / 2 +
            (↑R * Complex.exp (SparseSGD.windowOscillatoryRate u √(D - 1 / 4) * ↑tau)).re / 2))
      (fun x => 0) Filter.atTop (Set.Ici 0)
SparseSGD.cor_resonance_rank (D u variance R : ℝ) (hD : 0 < D) (hu : 0 < u) (hvar : 0 ≤ variance) (hR : 0 ≤ R)
  (hn : 0 < R ∨ 0 < variance) (t : ℝ) (ht : 0 < t) :
  0 < (SparseSGD.continuumFlow D u (variance * u) { R := R, V := 0, C := 0 } t).rankDefect ∧
    (SparseSGD.continuumFlow D u (variance * u) { R := R, V := 0, C := 0 } t).cov.PosDef
SparseSGD.cor_tikhonov (margin : ℝ) (hm : 0 < margin) :
  ∃ Delta1 C,
    0 < Delta1 ∧
      0 < C ∧
        ∀ (p : SparseSGD.Params) (Delta R : ℝ),
          SparseSGD.External.JuryStability →
            1 / 2 ≤ p.beta →
              p.beta < 1 →
                0 < Delta →
                  Delta ≤ Delta1 →
                    p.w = SparseSGD.smallDeltaW p.beta Delta →
                      0 ≤ R →
                        0 ≤ p.renormNoise →
                          p.renormNoise ≤ 1 - margin →
                            0 ≤ p.renormAdditive →
                              ∀ (k : ℕ),
                                |(p.trajectory { R := R, V := 0, C := 0 } k).R -
                                      SparseSGD.Scaling.learningProfile p.renormNoise p.renormAdditive R
                                        (↑k * (p.w / p.eps))| ≤
                                  C * Delta * (R + p.renormAdditive / (1 - p.renormNoise))
SparseSGD.cor_tikhonov_v2 (margin : ℝ) (hm : 0 < margin) :
  ∃ Delta1 C,
    0 < Delta1 ∧
      0 < C ∧
        ∀ (p : SparseSGD.Params) (Delta R : ℝ),
          SparseSGD.External.JuryStability →
            0 ≤ p.beta →
              p.beta < 1 →
                0 < Delta →
                  Delta ≤ Delta1 →
                    p.w = SparseSGD.smallDeltaW p.beta Delta →
                      0 ≤ R →
                        0 ≤ p.renormNoise →
                          p.renormNoise ≤ 1 - margin →
                            0 ≤ p.renormAdditive →
                              ∀ (k : ℕ),
                                |(p.trajectory { R := R, V := 0, C := 0 } k).R -
                                      SparseSGD.Scaling.learningProfile p.renormNoise p.renormAdditive R
                                        (↑k * (p.w / p.eps))| ≤
                                  C * Delta * (R + p.renormAdditive / (1 - p.renormNoise))
SparseSGD.critical_plane_cell_classification (sigma kappa gamma : ℝ) (hg : 0 < gamma) :
  SparseSGD.Cell2 (SparseSGD.eDelta gamma kappa (SparseSGD.criticalAlpha sigma kappa gamma))
      (SparseSGD.eNoise sigma (SparseSGD.criticalAlpha sigma kappa gamma))
      (SparseSGD.eCurvature gamma kappa (SparseSGD.criticalAlpha sigma kappa gamma)) ∨
    SparseSGD.Cell4 (SparseSGD.eDelta gamma kappa (SparseSGD.criticalAlpha sigma kappa gamma))
        (SparseSGD.eNoise sigma (SparseSGD.criticalAlpha sigma kappa gamma))
        (SparseSGD.eCurvature gamma kappa (SparseSGD.criticalAlpha sigma kappa gamma)) ∨
      SparseSGD.Cell6 (SparseSGD.eDelta gamma kappa (SparseSGD.criticalAlpha sigma kappa gamma))
          (SparseSGD.eNoise sigma (SparseSGD.criticalAlpha sigma kappa gamma))
          (SparseSGD.eCurvature gamma kappa (SparseSGD.criticalAlpha sigma kappa gamma)) ∨
        SparseSGD.Cell7 (SparseSGD.eDelta gamma kappa (SparseSGD.criticalAlpha sigma kappa gamma))
            (SparseSGD.eNoise sigma (SparseSGD.criticalAlpha sigma kappa gamma))
            (SparseSGD.eCurvature gamma kappa (SparseSGD.criticalAlpha sigma kappa gamma)) ∨
          SparseSGD.Cell8 (SparseSGD.eDelta gamma kappa (SparseSGD.criticalAlpha sigma kappa gamma))
            (SparseSGD.eNoise sigma (SparseSGD.criticalAlpha sigma kappa gamma))
            (SparseSGD.eCurvature gamma kappa (SparseSGD.criticalAlpha sigma kappa gamma))
SparseSGD.curvature_eventually_window (p : ℕ → SparseSGD.Params) (w u margin : ℝ)
  (hb : Filter.Tendsto (fun n => (p n).beta) Filter.atTop (nhds 1))
  (hw : Filter.Tendsto (fun n => (p n).w) Filter.atTop (nhds w))
  (hu : Filter.Tendsto (fun n => (p n).noise) Filter.atTop (nhds u)) (hw0 : 0 < w) (hw4 : w < 4) (hm : 0 < margin)
  (hb1 : ∀ᶠ (n : ℕ) in Filter.atTop, (p n).beta < 1) (hu0 : ∀ᶠ (n : ℕ) in Filter.atTop, 0 ≤ (p n).noise)
  (hum : u / (1 - w / 4) ≤ 1 - margin) (hnyq : 2 * Real.sin margin ≤ |w - 2|) :
  ∀ᶠ (n : ℕ) in Filter.atTop, SparseSGD.WindowParameters (p n) (margin / 2)
SparseSGD.curvature_foldedAngle_tendsto (p : ℕ → SparseSGD.Params) (w : ℝ)
  (hb : Filter.Tendsto (fun n => (p n).beta) Filter.atTop (nhds 1))
  (hw : Filter.Tendsto (fun n => (p n).w) Filter.atTop (nhds w)) :
  Filter.Tendsto (fun n => (p n).foldedAngle) Filter.atTop (nhds (Real.arccos |1 - w / 2|))
SparseSGD.curvature_load_tendsto (p : ℕ → SparseSGD.Params) (w : ℝ)
  (hb : Filter.Tendsto (fun n => (p n).beta) Filter.atTop (nhds 1))
  (hw : Filter.Tendsto (fun n => (p n).w) Filter.atTop (nhds w)) :
  Filter.Tendsto (fun n => (p n).curvature) Filter.atTop (nhds (w / 4))
SparseSGD.curvature_noise_tendsto (p : ℕ → SparseSGD.Params) (w u : ℝ)
  (hb : Filter.Tendsto (fun n => (p n).beta) Filter.atTop (nhds 1))
  (hw : Filter.Tendsto (fun n => (p n).w) Filter.atTop (nhds w))
  (hu : Filter.Tendsto (fun n => (p n).noise) Filter.atTop (nhds u)) (hw4 : w < 4) :
  Filter.Tendsto (fun n => (p n).renormNoise) Filter.atTop (nhds (u / (1 - w / 4)))
SparseSGD.curvature_only_rate (w : ℝ) : 1 - 0 / (1 - w / 4) = 1
SparseSGD.curvature_perronRate_tendsto (p : ℕ → SparseSGD.Params) (w u : ℝ)
  (hb : Filter.Tendsto (fun n => (p n).beta) Filter.atTop (nhds 1))
  (hw : Filter.Tendsto (fun n => (p n).w) Filter.atTop (nhds w))
  (hu : Filter.Tendsto (fun n => (p n).noise) Filter.atTop (nhds u)) (hw0 : 0 < w) (hw4 : w < 4)
  (hb1 : ∀ᶠ (n : ℕ) in Filter.atTop, (p n).beta < 1) (hu0 : ∀ᶠ (n : ℕ) in Filter.atTop, 0 ≤ (p n).renormNoise)
  (hu1 : u / (1 - w / 4) < 1) :
  Filter.Tendsto (fun n => SparseSGD.continuumPerronRate (p n).matchedDelta (p n).renormNoise) Filter.atTop
    (nhds (1 - u / (1 - w / 4)))
SparseSGD.curvature_profile_rates_tendsto (p : ℕ → SparseSGD.Params) (w u : ℝ)
  (hb : Filter.Tendsto (fun n => (p n).beta) Filter.atTop (nhds 1))
  (hw : Filter.Tendsto (fun n => (p n).w) Filter.atTop (nhds w))
  (hu : Filter.Tendsto (fun n => (p n).noise) Filter.atTop (nhds u)) (hw4 : w < 4) :
  Filter.Tendsto (fun n => 1 - (p n).renormNoise) Filter.atTop (nhds (1 - u / (1 - w / 4))) ∧
    Filter.Tendsto (fun n => 1 + (p n).renormNoise / 2) Filter.atTop (nhds (1 + u / (1 - w / 4) / 2))
SparseSGD.curvature_scaledDelta_tendsto (p : ℕ → SparseSGD.Params) (w : ℝ)
  (hb : Filter.Tendsto (fun n => (p n).beta) Filter.atTop (nhds 1))
  (hw : Filter.Tendsto (fun n => (p n).w) Filter.atTop (nhds w)) (hw0 : 0 < w) (hw4 : w < 4)
  (hb1 : ∀ᶠ (n : ℕ) in Filter.atTop, (p n).beta < 1) :
  Filter.Tendsto (fun n => (p n).matchedDelta * (p n).matchedStep ^ 2) Filter.atTop (nhds (Real.arccos |1 - w / 2| ^ 2))
