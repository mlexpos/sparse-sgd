  (pStar kappa bStar sigma epsStar gamma etaStar alpha teacherNorm T : ℝ) (p : ℕ → ↑unitInterval)
  (mu : (d : ℕ) → SparseSGD.Logistic.Vec d) (ν : MeasureTheory.Measure ℝ) (hp : 0 < pStar) (hk : 0 < kappa)
