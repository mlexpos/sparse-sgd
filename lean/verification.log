SparseSGD.Logistic.logistic_fixedPoint_normalized_covariance {d B : ℕ} (eta beta : ℝ) (p : ↑unitInterval)
  (mu theta : SparseSGD.Logistic.Vec d) (s : SparseSGD.Moments) (hbeta : beta ≠ 1) (hb : 1 + beta ≠ 0)
  (hfixed : (SparseSGD.Logistic.driftParams eta beta p mu theta).step s = s) :
  s.C / (1 - beta) = -eta * SparseSGD.Logistic.coefA p mu theta * s.R / (1 + beta)
SparseSGD.Logistic.logistic_full_state_frame {d B : ℕ} (H : SparseSGD.External.GaussianSteinCertificate d) (hB : 0 < B)
  (p : ↑unitInterval) (mu theta momentum : SparseSGD.Logistic.Vec d) (hr : 0 < SparseSGD.Logistic.r mu) :
  ∃ k rest,
    k ≤ 2 ∧
      d = k + 1 + rest ∧
        ∃ muPrefix thetaPrefix axes split,
          Measurable split ∧
            MeasureTheory.Measure.map split (SparseSGD.Logistic.batchLaw d B p) =
                (SparseSGD.Logistic.batchLaw (k + 1) B p).prod
                  (MeasureTheory.Measure.pi fun x => SparseSGD.Probability.standardGaussianProduct rest) ∧
              (∀ (i : Fin k), ‖axes i‖ = 1 ∧ inner ℝ (axes i) mu = 0) ∧
                ‖muPrefix‖ = ‖mu‖ ∧
                  ‖thetaPrefix‖ = ‖theta‖ ∧
                    SparseSGD.Logistic.tameError p muPrefix thetaPrefix = SparseSGD.Logistic.tameError p mu theta ∧
                      SparseSGD.Logistic.coefD0 p muPrefix thetaPrefix = SparseSGD.Logistic.coefD0 p mu theta ∧
                        ∀ (a : SparseSGD.Logistic.Batch d B),
                          ‖SparseSGD.Logistic.bulkPart mu (SparseSGD.Logistic.centeredBatchGradient p mu theta a)‖ ^ 2 =
                            ∑ i, inner ℝ (axes i) (SparseSGD.Logistic.centeredBatchGradient p mu theta a) ^ 2 +
                              ‖SparseSGD.Logistic.residualGaussianComplement p muPrefix thetaPrefix (split a).1
                                    (split a).2‖ ^
                                2
SparseSGD.Logistic.logistic_moment_fixedPoint {d B : ℕ} (eta beta : ℝ) (p : ↑unitInterval)
  (mu theta : SparseSGD.Logistic.Vec d) (s : SparseSGD.Moments) (heta : eta ≠ 0) (hbeta : beta ≠ 1) (hb : 1 + beta ≠ 0)
  (hp0 : 0 < ↑p) (hp1 : ↑p < 1) (hu : (SparseSGD.Logistic.driftParams eta beta p mu theta).totalLoad ≠ 1)
  (hfixed : (SparseSGD.Logistic.driftParams eta beta p mu theta).step s = s) :
  s.R =
      SparseSGD.Logistic.frozenLogisticFloor d B eta (SparseSGD.Logistic.coefA p mu theta)
        (SparseSGD.Logistic.coefDtheta p mu theta) (SparseSGD.Logistic.coefD0 p mu theta)
        (eta * (1 - beta) * SparseSGD.Logistic.coefA p mu theta / (2 * (1 + beta))) ∧
    s.C = -eta * (1 - beta) * SparseSGD.Logistic.coefA p mu theta * s.R / (1 + beta) ∧
      s.V = 2 * eta * (1 - beta) * SparseSGD.Logistic.coefA p mu theta * s.R / (1 + beta)
