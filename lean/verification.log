  (p.trajectory { R := 0, V := V, C := 0 } k).R = 0
SparseSGD.continuumCovarianceFlow_variation_of_constants (delta u phi : ℝ) (s : SparseSGD.Moments) (t : ℝ) :
  SparseSGD.continuumCovarianceFlow delta u phi s t =
    SparseSGD.continuumMeanFlow delta t * s.cov * (SparseSGD.continuumMeanFlow delta t).transpose +
      ∫ (x : ℝ) in 0..t,
        SparseSGD.continuumMeanFlow delta (t - x) *
            SparseSGD.continuumCovarianceSource delta u phi (SparseSGD.continuumFlow delta u phi s x) *
          (SparseSGD.continuumMeanFlow delta (t - x)).transpose
SparseSGD.continuumFlow_cov_posDef {delta u phi : ℝ} (hd : 0 < delta) (hu : 0 ≤ u) (hp : 0 ≤ phi) (hnoise : 0 < u + phi)
  (s : SparseSGD.Moments) (hs : s.psd) (hnonzero : ∃ y, 0 ≤ y ∧ (SparseSGD.continuumFlow delta u phi s y).R ≠ 0) {t : ℝ}
  (ht : 0 < t) : (SparseSGD.continuumFlow delta u phi s t).cov.PosDef
SparseSGD.continuumFlow_equilibrium_exponential_bound {delta u : ℝ} (hd : 0 < delta) (hu0 : 0 ≤ u) (hu1 : u < 1) :
  ∃ A lambda,
    0 < A ∧
      0 < lambda ∧
        ∀ (phi : ℝ) (s q : SparseSGD.Moments),
          SparseSGD.continuumField delta u phi q = 0 →
            ∀ (t : ℝ),
              0 ≤ t →
                SparseSGD.continuumMomentSize
                    (SparseSGD.continuumMomentDifference (SparseSGD.continuumFlow delta u phi s t) q) ≤
                  A * SparseSGD.continuumMomentSize (SparseSGD.continuumMomentDifference s q) * Real.exp (-lambda * t)
SparseSGD.continuumFlow_exponentially_stable_iff {delta u : ℝ} (hd : 0 < delta) (hu : 0 ≤ u) :
  (∃ A lambda,
      0 < A ∧
        0 < lambda ∧
          ∀ (s : SparseSGD.Moments) (t : ℝ),
            0 ≤ t →
              SparseSGD.continuumMomentSize (SparseSGD.continuumFlow delta u 0 s t) ≤
                A * SparseSGD.continuumMomentSize s * Real.exp (-lambda * t)) ↔
    u < 1
SparseSGD.continuumFlow_largeMode_sum (delta u phi a : ℝ) (s : SparseSGD.Moments) (hd : 1 ≤ delta) (hu : u ≠ 1)
  (ha : a ^ 3 + (4 * delta - 1) * a - 4 * delta * u = 0) (t : ℝ) (ht : 0 ≤ t) :
  ↑(SparseSGD.continuumFlow delta u phi s t).R =
    ↑(phi / (1 - u)) +
      ∑ i, SparseSGD.largeModeCoefficients delta u phi a s i * Complex.exp (SparseSGD.largeModeRates delta a i * ↑t)
SparseSGD.continuumFlow_largeMode_sum_coefficients_bound (delta u phi a : ℝ) (s : SparseSGD.Moments) (hd : 4 ≤ delta)
  (hu : u < 1) (hp : 0 ≤ phi) (ha0 : 0 ≤ a) (ha1 : a ≤ 1) (hs : s.psd) :
  ∑ i, ‖SparseSGD.largeModeCoefficients delta u phi a s i‖ ≤ 22 * (s.R + delta * s.V + phi / (1 - u))
SparseSGD.continuumFlow_psd {delta u phi : ℝ} (hd : 0 < delta) (hu : 0 ≤ u) (hp : 0 ≤ phi) (s : SparseSGD.Moments)
  (hs : s.psd) {t : ℝ} (ht : 0 ≤ t) : (SparseSGD.continuumFlow delta u phi s t).psd
SparseSGD.continuumFlow_rankDefect_pos {delta u phi : ℝ} (hd : 0 < delta) (hu : 0 ≤ u) (hp : 0 ≤ phi)
  (hnoise : 0 < u + phi) (s : SparseSGD.Moments) (hs : s.psd)
  (hnonzero : ∃ y, 0 ≤ y ∧ (SparseSGD.continuumFlow delta u phi s y).R ≠ 0) {t : ℝ} (ht : 0 < t) :
  0 < (SparseSGD.continuumFlow delta u phi s t).rankDefect
SparseSGD.continuumFlow_renewal (delta u phi : ℝ) (s : SparseSGD.Moments) (t : ℝ) :
  (SparseSGD.continuumFlow delta u phi s t).R =
    SparseSGD.continuumFreeRisk delta s t +
      ∫ (x : ℝ) in 0..t,
        SparseSGD.continuumRenewalKernel delta (t - x) * (u * (SparseSGD.continuumFlow delta u phi s x).R + phi)
SparseSGD.continuumFlow_tendstoUniformlyOn_nonneg.{u_1} {ι : Type u_1} {l : Filter ι} {delta u phi : ι → ℝ}
  {s : ι → SparseSGD.Moments} {delta₀ u₀ phi₀ : ℝ} {s₀ : SparseSGD.Moments} (hd : Filter.Tendsto delta l (nhds delta₀))
  (hu : Filter.Tendsto u l (nhds u₀)) (hp : Filter.Tendsto phi l (nhds phi₀))
  (hsR : Filter.Tendsto (fun n => (s n).R) l (nhds s₀.R)) (hsV : Filter.Tendsto (fun n => (s n).V) l (nhds s₀.V))
  (hsC : Filter.Tendsto (fun n => (s n).C) l (nhds s₀.C)) (hd0 : 0 < delta₀) (hu00 : 0 ≤ u₀) (hu01 : u₀ < 1)
  (hpositive : ∀ᶠ (n : ι) in l, 0 < delta n ∧ 0 ≤ u n ∧ u n < 1 ∧ 0 ≤ phi n ∧ (s n).psd) :
  TendstoUniformlyOn
    (fun n t => SparseSGD.regularMomentVector (SparseSGD.continuumFlow (delta n) (u n) (phi n) (s n) t))
    (fun t => SparseSGD.regularMomentVector (SparseSGD.continuumFlow delta₀ u₀ phi₀ s₀ t)) l (Set.Ici 0)
SparseSGD.continuumFreeRisk_le_initial_energy (delta : ℝ) (hd : 0 < delta) (s : SparseSGD.Moments) (hs : s.psd) (t : ℝ)
  (ht : 0 ≤ t) : SparseSGD.continuumFreeRisk delta s t ≤ s.R + delta * s.V
SparseSGD.continuumKernelLaplace_eq {delta s : ℝ} (hd : 0 < delta) (hs : 0 ≤ s) :
  SparseSGD.continuumKernelLaplace delta s = 4 * delta / ((s + 1) * (s ^ 2 + 2 * s + 4 * delta))
SparseSGD.continuumKernelLaplace_integrable {delta s : ℝ} (hd : 0 < delta) (hs : 0 ≤ s) :
