SparseSGD.Scaling.Helps.ratio_identity_c {c s κ D pV dd : ℝ} (hs : 1 < s) (hκ : κ = s ^ 2) (hpV : pV ≠ 0) (hdd : dd ≠ 0)
  (hD : D = dd - pV) :
  c * s / 8 * (1 - 1 / κ ^ 2) * (1 - pV / dd) * (dd / pV * (4 * κ / (κ ^ 2 - 1))) = c * D / (8 * pV) * (4 / s)
