SparseSGD.curvature_scaledDelta_tendsto (p : ℕ → SparseSGD.Params) (w : ℝ)
  (hb : Filter.Tendsto (fun n => (p n).beta) Filter.atTop (nhds 1))
  (hw : Filter.Tendsto (fun n => (p n).w) Filter.atTop (nhds w)) (hw0 : 0 < w) (hw4 : w < 4)
