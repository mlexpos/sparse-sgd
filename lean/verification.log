SparseSGD.Logistic.reducedKernel_drift {d B : ℕ} (H : SparseSGD.External.GaussianSteinCertificate d) (hB : 0 < B)
  (eta beta : ℝ) (p : ↑unitInterval) (mu : SparseSGD.Logistic.Vec d) (hr : 0 < SparseSGD.Logistic.r mu) (hp0 : 0 < ↑p)
  (hp1 : ↑p < 1) (s : SparseSGD.Logistic.State d) :
  ∫ (x : ↑(SparseSGD.Logistic.ReducedState mu)),
        (↑x).2.1 ∂(SparseSGD.Logistic.reducedKernel eta beta p mu hr) (SparseSGD.Logistic.reduceState mu s) =
      beta * SparseSGD.Logistic.signalCoord mu s.2 +
        (1 - beta) *
          (SparseSGD.Logistic.coefA p mu s.1 * SparseSGD.Logistic.signalCoord mu s.1 +
            SparseSGD.Logistic.coefB p mu s.1 * SparseSGD.Logistic.r mu) ∧
    ∫ (x : ↑(SparseSGD.Logistic.ReducedState mu)),
          (↑x).1 ∂(SparseSGD.Logistic.reducedKernel eta beta p mu hr) (SparseSGD.Logistic.reduceState mu s) =
        SparseSGD.Logistic.signalCoord mu s.1 -
          eta *
            (beta * SparseSGD.Logistic.signalCoord mu s.2 +
              (1 - beta) *
                (SparseSGD.Logistic.coefA p mu s.1 * SparseSGD.Logistic.signalCoord mu s.1 +
                  SparseSGD.Logistic.coefB p mu s.1 * SparseSGD.Logistic.r mu)) ∧
      {
          R :=
            ∫ (x : ↑(SparseSGD.Logistic.ReducedState mu)),
              (↑x).2.2.1 ∂(SparseSGD.Logistic.reducedKernel eta beta p mu hr) (SparseSGD.Logistic.reduceState mu s),
          V :=
            eta ^ 2 *
              ∫ (x : ↑(SparseSGD.Logistic.ReducedState mu)),
                (↑x).2.2.2.1 ∂(SparseSGD.Logistic.reducedKernel eta beta p mu hr) (SparseSGD.Logistic.reduceState mu s),
          C :=
            eta *
              ∫ (x : ↑(SparseSGD.Logistic.ReducedState mu)),
                (↑x).2.2.2.2 ∂(SparseSGD.Logistic.reducedKernel eta beta p mu hr)
                  (SparseSGD.Logistic.reduceState mu s) } =
        (SparseSGD.Logistic.driftParams eta beta p mu s.1).step
          { R := ‖SparseSGD.Logistic.bulkPart mu s.1‖ ^ 2, V := eta ^ 2 * ‖SparseSGD.Logistic.bulkPart mu s.2‖ ^ 2,
            C := eta * inner ℝ (SparseSGD.Logistic.bulkPart mu s.1) (SparseSGD.Logistic.bulkPart mu s.2) }
