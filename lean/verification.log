SparseSGD.window_chain_energy_comparison (margin : ℝ) (hm : 0 < margin) :
  ∃ C,
    0 ≤ C ∧
      ∀ (p : SparseSGD.Params) (s : SparseSGD.Moments),
        1 / 2 ≤ p.beta →
          p.beta < 1 →
            0 < p.w →
              p.w < 2 * (1 + p.beta) →
                SparseSGD.External.JuryStability →
                  s.psd →
                    0 ≤ p.renormNoise →
                      p.renormNoise ≤ 1 - margin →
                        0 ≤ p.renormAdditive →
                          SparseSGD.windowDeltaThreshold margin ≤ p.matchedDelta →
                            p.foldedAngle ≤ Real.pi / 2 - margin →
                              ∀ (k : ℕ),
                                |SparseSGD.slowEnergy p.matchedDelta (p.matchedMoments (p.trajectory s k)) -
                                        p.windowSlow s (↑k * p.matchedStep)| ≤
                                    C * (p.matchedStep + 1 / √p.matchedDelta) *
                                      (p.comparisonInitialSize s + p.renormAdditive) ∧
                                  ‖SparseSGD.oscillatoryEnergy p.matchedDelta
                                          (SparseSGD.oscillatoryRoot √(p.matchedDelta - 1 / 4))
                                          (p.matchedMoments (p.trajectory s k)) -
                                        p.windowOsc s (↑k * p.matchedStep)‖ ≤
                                    C * (p.matchedStep + 1 / √p.matchedDelta) *
                                      (p.comparisonInitialSize s + p.renormAdditive)
SparseSGD.window_chain_local_average (margin : ℝ) (hm : 0 < margin) :
  ∃ C,
    0 ≤ C ∧
      ∀ (p : SparseSGD.Params) (s : SparseSGD.Moments),
        1 / 2 ≤ p.beta →
          p.beta < 1 →
            0 < p.w →
              p.w < 2 * (1 + p.beta) →
                SparseSGD.External.JuryStability →
                  s.psd →
                    0 ≤ p.renormNoise →
                      p.renormNoise ≤ 1 - margin →
                        0 ≤ p.renormAdditive →
                          SparseSGD.windowDeltaThreshold margin ≤ p.matchedDelta →
                            p.foldedAngle ≤ Real.pi / 2 - margin →
                              ∀ (k N : ℕ),
                                0 < N →
                                  |(∑ j ∈ Finset.range N, (p.trajectory s (k + j)).R) / ↑N -
                                        p.windowSlow s (↑k * p.matchedStep) / 2| ≤
                                    C * (p.matchedStep + 1 / √p.matchedDelta) *
                                        (p.comparisonInitialSize s + p.renormAdditive) +
                                      4 / margin * (p.comparisonInitialSize s + p.renormAdditive) *
                                        (↑N * p.matchedStep + 1 / (↑N * p.foldedAngle))
SparseSGD.window_chain_risk_comparison (margin : ℝ) (hm : 0 < margin) :
  ∃ C,
    0 ≤ C ∧
      ∀ (p : SparseSGD.Params) (s : SparseSGD.Moments),
        1 / 2 ≤ p.beta →
