  (hB : 0 < B) (hp : 0 < ↑p) {eps Delta u eta : ℝ} (heps : eps = 1 - beta) (he0 : 0 < eps) (he : eps ≤ 1 / 50)
  (heta : 0 < eta) (hDelta : Delta = eta * ↑p / eps) (hD : Delta ≤ 1 / 50)
  (hu : u = eta / SparseSGD.Probability.LeastSquares.criticalRate d B p beta) (hu1 : u < 1) :
  |SparseSGD.Scaling.Helps.lsRate d B p ν beta eta - 2 * eta * ↑p * (1 - u)| ≤
    25 * (eps + Delta) * (2 * eta * ↑p * (1 - u))
