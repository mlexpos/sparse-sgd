SparseSGD.Logistic.prop_LR2 (r0 Phi T : ℝ) (hPhi : 0 ≤ Phi) (hT : 0 ≤ T) (y : ℝ → ℝ × ℝ)
  (hy : ∀ t ∈ Set.Icc 0 T, HasDerivAt y (SparseSGD.Logistic.slowVectorField r0 Phi (y t)) t) :
  ∃ C,
    0 < C ∧
      ∀ {d B : ℕ} (eta beta : ℝ) (p : ↑unitInterval) (mu : SparseSGD.Logistic.Vec d)
        (theta : ℕ → SparseSGD.Logistic.Vec d) (x : ℕ → SparseSGD.Logistic.DynamicState) (N : ℕ) (e : ℝ),
        SparseSGD.Logistic.r mu = r0 →
          SparseSGD.Logistic.dynamicSourceLoad d B eta = Phi →
            0 < ↑p →
              0 < B →
                2 ≤ d →
                  0 ≤ eta →
                    0 < 1 - beta →
                      1 - beta ≤ 1 →
                        0 ≤ e →
                          e ≤ 1 / 2 →
                            ↑N * (eta * ↑p) ≤ T →
                              SparseSGD.Logistic.slowPosition (x 0) = y 0 →
                                x 0 1 = 0 →
                                  x 0 3 = 0 →
                                    x 0 4 = 0 →
                                      (∀ n < N, ‖theta n‖ ^ 2 = x n 0 ^ 2 + x n 2) →
                                        (∀ n < N, SparseSGD.Logistic.tameError p mu (theta n) ≤ e) →
                                          (∀ n < N,
                                              x (n + 1) =
                                                SparseSGD.Logistic.slowDriftMap eta beta p mu (theta n) (x n)) →
                                            C * (eta * ↑p / (1 - beta) + eta * ↑p + e) ≤ 1 →
                                              ∀ n ≤ N,
                                                |x n 0 - (y (↑n * (eta * ↑p))).1| + |x n 2 - (y (↑n * (eta * ↑p))).2| ≤
                                                  C * (eta * ↑p / (1 - beta) + eta * ↑p + e)
SparseSGD.Logistic.prop_LR34 (r0 delta0 Phi0 T : ℝ) (hd0 : 0 < delta0) (hT : 0 ≤ T)
  (y : ℝ → SparseSGD.Logistic.DynamicState)
  (hy : ∀ t ∈ Set.Icc 0 T, HasDerivAt y (SparseSGD.Logistic.dynamicField r0 delta0 Phi0 (y t)) t) :
  ∃ C,
    0 < C ∧
      ∀ {d B : ℕ} (eta beta : ℝ) (p : ↑unitInterval) (mu : SparseSGD.Logistic.Vec d)
        (theta : ℕ → SparseSGD.Logistic.Vec d) (x : ℕ → SparseSGD.Logistic.DynamicState) (N : ℕ) (e : ℝ),
        SparseSGD.Logistic.r mu = r0 →
          0 < ↑p →
            0 < B →
              2 ≤ d →
                0 < eta →
                  0 < 1 - beta →
                    1 - beta ≤ 1 →
                      0 ≤ e →
                        e ≤ 1 / 2 →
                          |eta * ↑p / (1 - beta) - delta0| ≤ delta0 / 2 →
                            |SparseSGD.Logistic.dynamicSourceLoad d B eta - Phi0| ≤ 1 →
                              ↑N * (1 - beta) ≤ T →
                                x 0 = y 0 →
                                  (∀ k < N, ‖theta k‖ ^ 2 = x k 0 ^ 2 + x k 2) →
                                    (∀ k < N, SparseSGD.Logistic.tameError p mu (theta k) ≤ e) →
                                      (∀ k < N,
                                          x (k + 1) =
                                            SparseSGD.Logistic.dynamicDriftMap eta beta p mu (theta k) (x k)) →
                                        C *
                                              (1 - beta + |eta * ↑p / (1 - beta) - delta0| +
                                                  |SparseSGD.Logistic.dynamicSourceLoad d B eta - Phi0| +
                                                e) ≤
                                            1 →
                                          ∀ n ≤ N,
                                            ‖x n - y (↑n * (1 - beta))‖ ≤
                                              C *
                                                (1 - beta + |eta * ↑p / (1 - beta) - delta0| +
                                                    |SparseSGD.Logistic.dynamicSourceLoad d B eta - Phi0| +
                                                  e)
