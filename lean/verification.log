SparseSGD.continuumFlow_equilibrium_exponential_bound {delta u : ℝ} (hd : 0 < delta) (hu0 : 0 ≤ u) (hu1 : u < 1) :
  ∃ A lambda,
    0 < A ∧
      0 < lambda ∧
        ∀ (phi : ℝ) (s q : SparseSGD.Moments),
          SparseSGD.continuumField delta u phi q = 0 →
            ∀ (t : ℝ),
              0 ≤ t →
                SparseSGD.continuumMomentSize
                    (SparseSGD.continuumMomentDifference (SparseSGD.continuumFlow delta u phi s t) q) ≤
                  A * SparseSGD.continuumMomentSize (SparseSGD.continuumMomentDifference s q) * Real.exp (-lambda * t)
SparseSGD.continuumFlow_exponentially_stable_iff {delta u : ℝ} (hd : 0 < delta) (hu : 0 ≤ u) :
  (∃ A lambda,
      0 < A ∧
        0 < lambda ∧
          ∀ (s : SparseSGD.Moments) (t : ℝ),
            0 ≤ t →
              SparseSGD.continuumMomentSize (SparseSGD.continuumFlow delta u 0 s t) ≤
                A * SparseSGD.continuumMomentSize s * Real.exp (-lambda * t)) ↔
    u < 1
