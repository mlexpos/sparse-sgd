        SparseSGD.Scaling.Helps.hyperbolaN (SparseSGD.Scaling.Helps.lsNstab (d n) (B n) (p n) (beta n))
          (SparseSGD.Scaling.Helps.lsNmem (B n) (p n) (beta n)))
    Filter.atTop (nhds 1)
SparseSGD.Scaling.Helps.cor_sample_cost_uniform {δ : ℝ} (hδ : 0 < δ) :
  ∃ eps0,
    0 < eps0 ∧
      ∀ (d B : ℕ) (p : ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (beta : ℝ),
        0 < B →
          0 < ↑p →
            0 < 1 - beta →
              1 - beta ≤ eps0 →
                |SparseSGD.Scaling.Helps.lsNfold d B p ν beta /
                        SparseSGD.Scaling.Helps.hyperbolaN (SparseSGD.Scaling.Helps.lsNstab d B p beta)
                          (SparseSGD.Scaling.Helps.lsNmem B p beta) -
                      1| ≤
                  δ
SparseSGD.Scaling.Helps.cor_samplecost (nu0 : ℝ) (hnu0 : 0 < nu0) :
  ∃ eps0,
    0 < eps0 ∧
      eps0 ≤ 1 / 2 ∧
        ∃ C,
          0 ≤ C ∧
            ∀ (d B : ℕ) (p : ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (beta : ℝ),
              0 < B →
                0 < ↑p →
                  0 < 1 - beta →
                    1 - beta ≤ eps0 →
                      SparseSGD.Scaling.Helps.lsNu d B p beta ∈ Set.Icc (nu0 / 2) (2 * nu0) →
                        (|SparseSGD.Scaling.Helps.lsLamStar d B p ν beta -
                                  (1 - beta) *
                                    SparseSGD.Scaling.Helps.rayRate (SparseSGD.Scaling.Helps.lsNu d B p beta)| ≤
                              C * (1 - beta) ^ (4 / 3) ∧
                            |SparseSGD.Scaling.Helps.lsNfold d B p ν beta /
                                    SparseSGD.Scaling.Helps.hyperbolaN (SparseSGD.Scaling.Helps.lsNstab d B p beta)
                                      (SparseSGD.Scaling.Helps.lsNmem B p beta) -
                                  1| ≤
                              C * (1 - beta) ^ (1 / 3)) ∧
                          |(SparseSGD.Scaling.Helps.lsNfold d B p ν beta / SparseSGD.Scaling.Helps.lsNstab d B p beta -
                                      1) *
                                    (SparseSGD.Scaling.Helps.lsNfold d B p ν beta /
                                        SparseSGD.Scaling.Helps.lsNmem B p beta -
                                      1) -
                                  1 / 2| ≤
                              C * (1 - beta) ^ (1 / 3) ∧
                            max (SparseSGD.Scaling.Helps.lsNstab d B p beta) (SparseSGD.Scaling.Helps.lsNmem B p beta) *
                                  (1 - C * (1 - beta) ^ (1 / 3)) ≤
                                SparseSGD.Scaling.Helps.lsNfold d B p ν beta ∧
                              SparseSGD.Scaling.Helps.lsNfoldSGD d B p ν * (1 - C * (1 - beta) ^ (1 / 3)) ≤
                                SparseSGD.Scaling.Helps.lsNfold d B p ν beta
SparseSGD.Scaling.Helps.criticalRate_zero_eq {d B : ℕ} {p : ↑unitInterval} (hB : 0 < B) :
