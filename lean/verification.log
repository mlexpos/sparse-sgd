SparseSGD.apparent_line_intersections (sigma kappa gamma : ℝ) :
  (kappa = sigma → gamma = 1 - sigma + kappa → gamma = 1) ∧
    (kappa = sigma - 1 → gamma = 1 - sigma + kappa → gamma = 0) ∧
      (kappa = sigma - 1 → gamma = sigma - 1 - kappa → gamma = 0) ∧
        (gamma = kappa - sigma → gamma = 1 - sigma + kappa → False) ∧
          (gamma = kappa - sigma → gamma = sigma - 1 - kappa → gamma = -1 / 2) ∧
            (kappa = sigma → gamma = sigma - 1 - kappa → gamma = -1)
SparseSGD.continuumCovarianceFlow_variation_of_constants (delta u phi : ℝ) (s : SparseSGD.Moments) (t : ℝ) :
  SparseSGD.continuumCovarianceFlow delta u phi s t =
    SparseSGD.continuumMeanFlow delta t * s.cov * (SparseSGD.continuumMeanFlow delta t).transpose +
      ∫ (x : ℝ) in 0..t,
        SparseSGD.continuumMeanFlow delta (t - x) *
            SparseSGD.continuumCovarianceSource delta u phi (SparseSGD.continuumFlow delta u phi s x) *
          (SparseSGD.continuumMeanFlow delta (t - x)).transpose
