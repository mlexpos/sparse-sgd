  ∫ (ω : SparseSGD.Scaling.Helps.VocabRows.VWorld d V B),
      ∫ (a : SparseSGD.Scaling.Helps.VocabRows.VSample d V),
        SparseSGD.Scaling.Helps.VocabRows.vExcessLoss (SparseSGD.Scaling.Helps.VocabRows.vocabProcess beta eta ω k).1
          a ∂SparseSGD.Scaling.Helps.VocabRows.vSampleLaw d ps ν ∂SparseSGD.Scaling.Helps.VocabRows.vWorldLaw ps ν ρ =
    1 / 2 *
      ∑ j,
        ↑(ps j) *
          (SparseSGD.Probability.LeastSquares.integratedMoments (SparseSGD.Scaling.Helps.VocabRows.vWorldLaw ps ν ρ)
              (fun ω => (SparseSGD.Scaling.Helps.VocabRows.vocabProcess beta eta ω k).1 j) fun ω =>
              (SparseSGD.Scaling.Helps.VocabRows.vocabProcess beta eta ω k).2 j).R
