  0 < SparseSGD.Logistic.V2.freqSq1 a theta R ∧
    SparseSGD.Logistic.V2.freqSq1 a theta R < SparseSGD.Logistic.V2.freqSq2 a theta R ∧
      SparseSGD.Logistic.V2.freqQuartic a theta R (SparseSGD.Logistic.V2.freqSq1 a theta R) = 0 ∧
        SparseSGD.Logistic.V2.freqQuartic a theta R (SparseSGD.Logistic.V2.freqSq2 a theta R) = 0 ∧
          ∀ (x : ℝ),
            SparseSGD.Logistic.V2.freqQuartic a theta R x = 0 →
              x = SparseSGD.Logistic.V2.freqSq1 a theta R ∨ x = SparseSGD.Logistic.V2.freqSq2 a theta R
