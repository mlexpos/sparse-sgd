  (hn : 0 < n) (hK : 0 < K) (hΓ : 0 < Γ) (hL2 : 0 ≤ L2) (hv : 0 ≤ v) (hM : 0 ≤ M) (hδ0 : 0 < δ) (hδ1 : δ < 1)
  (hx : ∀ (k : ℕ), x (k + 1) = Ψ (x k)) (h0 : ∀ᵐ (ω : Ω) ∂μ, X 0 ω = x 0)
  (hJ : ∀ k ≤ K, ∀ j < k, ‖SparseSGD.Logistic.jacobianResponse J k j‖ ≤ Γ)
