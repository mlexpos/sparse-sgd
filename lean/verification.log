    ∀ᶠ (d : ℕ) in Filter.atTop,
      ∀ (k : ℕ),
        have P := SparseSGD.Scaling.actualLSParams pStar kappa bStar 0 epsStar gamma etaStar 1 p ν d;
        |(P.trajectory { R := R, V := 0, C := 0 } k).R -
              (SparseSGD.continuumFlow (etaStar * pStar / epsStar)
                  (etaStar / (2 * ↑(SparseSGD.Scaling.fixedRealizedBatch bStar)))
                  (SparseSGD.Probability.LeastSquares.labelVariance ν *
                    (etaStar / (2 * ↑(SparseSGD.Scaling.fixedRealizedBatch bStar))))
                  { R := R, V := 0, C := 0 } (↑k * P.matchedStep)).R| ≤
          C * ↑d ^ (-min gamma 1)
SparseSGD.Scaling.cor_resonance_rate (pStar kappa bStar sigma epsStar gamma etaStar R : ℝ) (p : ℕ → ↑unitInterval)
  (ν : MeasureTheory.Measure ℝ) (jury : SparseSGD.External.JuryStability) (hp : 0 < pStar) (hk : 0 ≤ kappa)
  (hb : 0 < bStar) (hs : 0 < sigma) (he : 0 < epsStar) (hg : 0 < gamma) (heta : 0 < etaStar)
  (hline : gamma = 1 - sigma + kappa)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d) (hR : 0 ≤ R)
  (hu1 : etaStar / (2 * bStar) < 1) :
  ∃ C > 0,
    ∀ᶠ (d : ℕ) in Filter.atTop,
      ∀ (k : ℕ),
        have P := SparseSGD.Scaling.actualLSParams pStar kappa bStar sigma epsStar gamma etaStar (1 - sigma) p ν d;
        |(P.trajectory { R := R, V := 0, C := 0 } k).R -
              (SparseSGD.continuumFlow (etaStar * pStar / epsStar) (etaStar / (2 * bStar))
                  (SparseSGD.Probability.LeastSquares.labelVariance ν * (etaStar / (2 * bStar)))
                  { R := R, V := 0, C := 0 } (↑k * P.matchedStep)).R| ≤
          C * (↑d ^ (-gamma) + ↑d ^ (-1) + ↑d ^ (-sigma))
SparseSGD.Scaling.cor_resonance_rate_min (pStar kappa bStar sigma epsStar gamma etaStar R : ℝ) (p : ℕ → ↑unitInterval)
  (ν : MeasureTheory.Measure ℝ) (jury : SparseSGD.External.JuryStability) (hp : 0 < pStar) (hk : 0 ≤ kappa)
  (hb : 0 < bStar) (hs : 0 < sigma) (he : 0 < epsStar) (hg : 0 < gamma) (heta : 0 < etaStar)
  (hline : gamma = 1 - sigma + kappa)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d) (hR : 0 ≤ R)
  (hu1 : etaStar / (2 * bStar) < 1) :
  ∃ C > 0,
    ∀ᶠ (d : ℕ) in Filter.atTop,
      ∀ (k : ℕ),
        have P := SparseSGD.Scaling.actualLSParams pStar kappa bStar sigma epsStar gamma etaStar (1 - sigma) p ν d;
        |(P.trajectory { R := R, V := 0, C := 0 } k).R -
              (SparseSGD.continuumFlow (etaStar * pStar / epsStar) (etaStar / (2 * bStar))
                  (SparseSGD.Probability.LeastSquares.labelVariance ν * (etaStar / (2 * bStar)))
                  { R := R, V := 0, C := 0 } (↑k * P.matchedStep)).R| ≤
          C * ↑d ^ (-min gamma (min 1 sigma))
SparseSGD.Scaling.fixedBatch_ratio (B : ℕ) (hB : 0 < B) (d : ℕ) : ↑B / (↑B * ↑d ^ 0) = 1
SparseSGD.Scaling.fluidGridHorizon_eventually_le_polynomial (T etaStar pStar alpha kappa epsStar gamma : ℝ) (hT : 0 ≤ T)
  (heta : 0 < etaStar) (hp : 0 < pStar) (heps : 0 < epsStar) (ha : 0 ≤ alpha + kappa) (hg : 0 ≤ gamma) :
  ∃ q,
    0 ≤ q ∧
      ∀ᶠ (d : ℕ) in Filter.atTop,
        ↑(SparseSGD.Scaling.fluidGridHorizon T etaStar pStar alpha kappa epsStar gamma d) ≤ ↑d ^ q
SparseSGD.Scaling.gridHorizon_gap (T h : ℝ) (hh : 0 < h) : T - ↑⌊T / h⌋₊ * h < h
SparseSGD.Scaling.gridHorizon_le (T h : ℝ) (hT : 0 ≤ T) (hh : 0 < h) : ↑⌊T / h⌋₊ * h ≤ T
SparseSGD.Scaling.integerBatch_pos (scale exponent : ℝ) (d : ℕ) : 0 < SparseSGD.Scaling.integerBatch scale exponent d
SparseSGD.Scaling.integerBatch_ratio_tendsto (scale exponent : ℝ) (hs : 0 < scale) (he : 0 < exponent) :
  Filter.Tendsto (fun d => ↑(SparseSGD.Scaling.integerBatch scale exponent d) / (scale * ↑d ^ exponent)) Filter.atTop
    (nhds 1)
SparseSGD.Scaling.learningProfile_excess_grid (u phi R z : ℝ) (k : ℕ) :
  SparseSGD.Scaling.learningProfile u phi R (↑k * z) - phi / (1 - u) =
    (R - phi / (1 - u)) * Real.exp (-(2 * z * (1 - u)) * ↑k)
SparseSGD.Scaling.learningProfile_hasDerivAt (u phi R t : ℝ) (hu : u ≠ 1) :
  HasDerivAt (SparseSGD.Scaling.learningProfile u phi R)
    (-2 * (1 - u) * SparseSGD.Scaling.learningProfile u phi R t + 2 * phi) t
SparseSGD.Scaling.learningProfile_initial (u phi R : ℝ) : SparseSGD.Scaling.learningProfile u phi R 0 = R
SparseSGD.Scaling.ls_curvature_cells_energy (pStar kappa bStar sigma epsStar gamma etaStar alpha u margin : ℝ)
  (p : ℕ → ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (jury : SparseSGD.External.JuryStability) (hp : 0 < pStar)
  (hk : 0 ≤ kappa) (hb : 0 < bStar) (hs : 0 ≤ sigma) (he : 0 < epsStar) (hg : 0 < gamma) (heta : 0 < etaStar)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d)
  (hw : -(alpha + gamma + kappa) = 0)
  (hcell :
    1 - sigma - alpha < 0 ∧ u = 0 ∨
      1 - sigma - alpha = 0 ∧ u = etaStar / (2 * SparseSGD.Scaling.realizedBatchScale bStar sigma))
  (hw4 : etaStar * epsStar * pStar < 4) (hm : 0 < margin) (hum : u / (1 - etaStar * epsStar * pStar / 4) ≤ 1 - margin)
  (hnyq : 2 * Real.sin margin ≤ |etaStar * epsStar * pStar - 2|) (s : ℕ → SparseSGD.Moments)
  (hsPSD : ∀ (d : ℕ), (s d).psd) :
  have P := SparseSGD.Scaling.actualLSParams pStar kappa bStar sigma epsStar gamma etaStar alpha p ν;
  ∃ C ≥ 0,
    Filter.Tendsto (fun d => C * (P d).matchedStep) Filter.atTop (nhds 0) ∧
      ∀ᶠ (d : ℕ) in Filter.atTop,
        ∀ (k : ℕ),
          |SparseSGD.slowEnergy (P d).matchedDelta ((P d).matchedMoments ((P d).trajectory (s d) k)) -
                  (P d).windowSlow (s d) (↑k * (P d).matchedStep)| ≤
              C * (P d).matchedStep * ((P d).comparisonInitialSize (s d) + (P d).renormAdditive) ∧
            ‖SparseSGD.oscillatoryEnergy (P d).matchedDelta (SparseSGD.oscillatoryRoot √((P d).matchedDelta - 1 / 4))
                    ((P d).matchedMoments ((P d).trajectory (s d) k)) -
                  (P d).windowOsc (s d) (↑k * (P d).matchedStep)‖ ≤
              C * (P d).matchedStep * ((P d).comparisonInitialSize (s d) + (P d).renormAdditive)
SparseSGD.Scaling.ls_curvature_cells_envelope_rate (pStar kappa bStar sigma epsStar gamma etaStar alpha u margin : ℝ)
  (p : ℕ → ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (hp : 0 < pStar) (hk : 0 ≤ kappa) (hb : 0 < bStar)
  (hs : 0 ≤ sigma) (he : 0 < epsStar) (hg : 0 < gamma) (heta : 0 < etaStar)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d)
  (hw : -(alpha + gamma + kappa) = 0)
  (hcell :
    1 - sigma - alpha < 0 ∧ u = 0 ∨
      1 - sigma - alpha = 0 ∧ u = etaStar / (2 * SparseSGD.Scaling.realizedBatchScale bStar sigma))
  (hw4 : etaStar * epsStar * pStar < 4) (hm : 0 < margin) (hum : u / (1 - etaStar * epsStar * pStar / 4) ≤ 1 - margin)
  (hnyq : 2 * Real.sin margin ≤ |etaStar * epsStar * pStar - 2|) :
  have P := SparseSGD.Scaling.actualLSParams pStar kappa bStar sigma epsStar gamma etaStar alpha p ν;
  Filter.Tendsto
    (fun d => (P d).matchedStep * (1 - (P d).renormNoise) / SparseSGD.Scaling.scaledRetention epsStar gamma d)
    Filter.atTop (nhds (1 - u / (1 - etaStar * epsStar * pStar / 4)))
SparseSGD.Scaling.ls_curvature_cells_parameters (pStar kappa bStar sigma epsStar gamma etaStar alpha u margin : ℝ)
  (p : ℕ → ↑unitInterval) (ν : MeasureTheory.Measure ℝ) (hp : 0 < pStar) (hk : 0 ≤ kappa) (hb : 0 < bStar)
  (hs : 0 ≤ sigma) (he : 0 < epsStar) (hg : 0 < gamma) (heta : 0 < etaStar)
  (hpd : ∀ᶠ (d : ℕ) in Filter.atTop, ↑(p d) = SparseSGD.Scaling.scaledSparsity pStar kappa d)
  (hw : -(alpha + gamma + kappa) = 0)
  (hcell :
    1 - sigma - alpha < 0 ∧ u = 0 ∨
      1 - sigma - alpha = 0 ∧ u = etaStar / (2 * SparseSGD.Scaling.realizedBatchScale bStar sigma))
  (hw4 : etaStar * epsStar * pStar < 4) (hm : 0 < margin) (hum : u / (1 - etaStar * epsStar * pStar / 4) ≤ 1 - margin)
  (hnyq : 2 * Real.sin margin ≤ |etaStar * epsStar * pStar - 2|) :
  have P := SparseSGD.Scaling.actualLSParams pStar kappa bStar sigma epsStar gamma etaStar alpha p ν;
